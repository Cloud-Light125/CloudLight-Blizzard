<Window x:Class="CloudLightBlizzard.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="520" MaxHeight="680"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Border Background="{DynamicResource App.SurfaceElevated}" CornerRadius="14" Margin="18"
            BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.36" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="22,18,18,0" MouseLeftButtonDown="OnDrag">
                <StackPanel>
                    <TextBlock Text="发现新版本" Foreground="{DynamicResource Text.Primary}"
                               FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="IntroText" Foreground="{DynamicResource Text.Secondary}"
                               Margin="0,7,32,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Style="{StaticResource TitleIconButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Width="28" Height="28" Content="×"
                        Foreground="{DynamicResource Text.Muted}" FontSize="18" Click="OnLater" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="22,18,22,0">
                <Border Background="{DynamicResource App.SurfaceAlt}" BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="1" CornerRadius="10" Padding="14,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="当前版本" Foreground="{DynamicResource Text.Muted}" />
                            <TextBlock x:Name="CurrentVersionText" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Text.Primary}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="最新版本" Foreground="{DynamicResource Text.Muted}" />
                            <TextBlock x:Name="LatestVersionText" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Text.Primary}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel x:Name="PublishedPanel" Grid.Column="2">
                            <TextBlock Text="发布日期" Foreground="{DynamicResource Text.Muted}" />
                            <TextBlock x:Name="PublishedText" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Text.Primary}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel x:Name="ReleaseNotesPanel" Margin="0,17,0,0">
                    <TextBlock Text="更新内容" Foreground="{DynamicResource Text.Primary}"
                               FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Border Background="{DynamicResource App.SurfaceAlt}" BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1" CornerRadius="9" Padding="12,10">
                        <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ReleaseNotesText" Foreground="{DynamicResource Text.Secondary}"
                                       TextWrapping="Wrap" LineHeight="21" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <CheckBox x:Name="SkipVersionBox" Content="不再提示此版本"
                          Style="{StaticResource ThemeCheckBox}" Margin="0,18,0,0" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="22,20,22,22">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="稍后提醒" Style="{StaticResource SecondaryButton}"
                            Height="36" Padding="20,0" Margin="0,0,10,0" Click="OnLater" />
                    <Button x:Name="OpenReleaseButton" Content="前往更新" Style="{StaticResource PrimaryButton}"
                            Height="36" Padding="20,0" Click="OnOpenRelease" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
