<UserControl x:Class="CloudLightBlizzard.Views.Pages.DropsPage"
             x:Name="DropsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls"
             xmlns:behaviors="clr-namespace:CloudLightBlizzard.Behaviors"
             behaviors:NestedScrollBehavior.IsEnabled="True"
             Foreground="{DynamicResource Text.Primary}"
             Background="{DynamicResource App.Background}">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="HintTextBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{DynamicResource InputBd}" BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource Text.Muted}" Margin="10,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="9,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Acc}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Background" Value="{DynamicResource Input}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBd}"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="StaysOpenOnEdit" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{DynamicResource ThemeComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Box" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBd}"
                                                BorderThickness="1" CornerRadius="8" Padding="10,0">
                                            <DockPanel>
                                                <TextBlock Text="⌄" DockPanel.Dock="Right" Foreground="{DynamicResource Text.Secondary}"
                                                           VerticalAlignment="Center" Margin="10,0,0,2"/>
                                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Text.Primary}"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent.Primary}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Text.Primary}" CaretBrush="{DynamicResource Text.Primary}"
                                     Margin="10,0,36,0" VerticalContentAlignment="Center"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource App.SurfaceElevated}" BorderBrush="{DynamicResource App.Border}"
                                        BorderThickness="1" CornerRadius="8" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="320"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="DropsRowTemplate">
            <Grid Margin="4,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Primary}" ToolTip="{Binding Primary}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Secondary}" Foreground="{DynamicResource Text.Secondary}" FontSize="11"
                               ToolTip="{Binding Secondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent.Primary}" FontSize="10.5"/>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="TwitchDropRowTemplate">
            <Grid Margin="6,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Primary}" ToolTip="{Binding Primary}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Secondary}" Foreground="{DynamicResource Text.Secondary}"
                               FontSize="11" ToolTip="{Binding Secondary}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <Border Style="{StaticResource Badge}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent.Primary}"
                                   FontSize="10.5"/>
                    </Border>
                    <Button Content="{Binding TwitchClaimButtonText}"
                            Visibility="{Binding TwitchClaimVisibility}"
                            IsEnabled="{Binding CanStartTwitchClaim}"
                            Style="{StaticResource SecondaryButton}" Padding="12,0" Margin="10,0,0,0"
                            Click="OnClaimTwitchDrop"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="TwitchCampaignRowTemplate">
            <Grid Margin="6,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" MinWidth="100"/>
                    <ColumnDefinition Width="1.8*" MinWidth="150"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Secondary}" ToolTip="{Binding Secondary}"
                           VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Primary}" ToolTip="{Binding Primary}"
                           Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="14,0,10,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent.Primary}" FontSize="10.5"/>
                </Border>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="5"
                                 Background="{DynamicResource App.SurfaceElevated}"
                                 Foreground="{DynamicResource Accent.Primary}"/>
                    <TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}"
                               Foreground="{DynamicResource Text.Secondary}" FontSize="10.5"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="YouTubeChannelRowTemplate">
            <Grid Margin="4,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="2,0,10,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Text.Muted}"/>
                            <Setter Property="ToolTip" Value="已停用"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Enabled}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource Status.Success}"/>
                                    <Setter Property="ToolTip" Value="已启用"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Primary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Secondary}" ToolTip="{Binding Secondary}"
                               Foreground="{DynamicResource Text.Secondary}" FontSize="11" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="QuickStartStepTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Number}" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <WrapPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StateKind}" Value="complete">
                                            <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateKind}" Value="progress">
                                            <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>
                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Text.Muted}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding ActionText}" Tag="{Binding ActionKey}"
                        Visibility="{Binding ActionVisibility}" Style="{StaticResource SecondaryButton}"
                        Padding="12,0" VerticalAlignment="Center" Click="OnQuickStartAction"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SoopProgressRowTemplate">
            <Grid Margin="6,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Campaign}" ToolTip="{Binding Campaign}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="12,0,0,0">
                        <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource Accent.Primary}" FontSize="10.5"/>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="1" Margin="0,5,0,0" TextTrimming="CharacterEllipsis">
                    <Run Text="当前奖励："/><Run Text="{Binding Reward, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Grid.Row="2" Margin="0,4,0,0" Foreground="{DynamicResource Text.Secondary}" FontSize="11" TextTrimming="CharacterEllipsis">
                    <Run Text="账号："/><Run Text="{Binding Account, Mode=OneWay}"/><Run Text="　直播间："/><Run Text="{Binding Channel, Mode=OneWay}"/>
                </TextBlock>
                <ProgressBar Grid.Row="3" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                             Style="{StaticResource ThemeProgressBar}" Height="6" Margin="0,8,0,0"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="BilibiliTaskRowTemplate">
            <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="7" Padding="8" Margin="3,4">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            <TextBlock Text="{Binding OfficialText}" Foreground="{DynamicResource Text.Muted}" FontSize="10.5" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="12,0,0,0">
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent.Primary}" FontSize="10.5"/>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="6" Style="{StaticResource ThemeProgressBar}"/>
                            <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource Text.Secondary}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding ClaimButtonText}" Visibility="{Binding ClaimVisibility}"
                                IsEnabled="{Binding CanClaim}" Style="{StaticResource SecondaryButton}" Padding="12,0"
                                Margin="12,0,0,0"
                                Command="{Binding DataContext.BilibiliDetails.ClaimRewardCommand, ElementName=DropsRoot}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="BilibiliRoomRowTemplate">
            <Grid Margin="3,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Style="{StaticResource ThemeCheckBox}" VerticalAlignment="Center"
                          Command="{Binding DataContext.BilibiliDetails.SetRoomEnabledCommand, ElementName=DropsRoot}"
                          CommandParameter="{Binding}"/>
                <StackPanel Grid.Column="1" Margin="8,0,6,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                    <TextBlock Foreground="{DynamicResource Text.Secondary}" FontSize="11" Margin="0,3,0,0">
                        <Run Text="Room ID："/><Run Text="{Binding RoomIdText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Status, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SessionText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" Content="删除" Style="{StaticResource DangerButton}" Height="28" Padding="10,0"
                        Command="{Binding DataContext.BilibiliDetails.RemoveRoomCommand, ElementName=DropsRoot}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="BilibiliSessionRowTemplate">
            <Grid Margin="3,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}"/>
                <TextBlock Grid.Column="1" Text="{Binding StateText}" Foreground="{DynamicResource Accent.Primary}" Margin="12,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{DynamicResource Text.Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="BilibiliActivityRowTemplate">
            <StackPanel Margin="4,4">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Padding="7,2" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent.Primary}" FontSize="10.5"/>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                </DockPanel>
                <TextBlock Foreground="{DynamicResource Text.Secondary}" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding RoomText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding TaskText, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="PlatformStatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConnectionState}" Value="Connected"><Setter Property="Fill" Value="{DynamicResource Status.Success}"/></DataTrigger>
                <DataTrigger Binding="{Binding ConnectionState}" Value="Connecting"><Setter Property="Fill" Value="{DynamicResource Accent.Primary}"/></DataTrigger>
                <DataTrigger Binding="{Binding ConnectionState}" Value="Recovering"><Setter Property="Fill" Value="{DynamicResource Status.Warning}"/></DataTrigger>
                <DataTrigger Binding="{Binding ConnectionState}" Value="WaitingRetry"><Setter Property="Fill" Value="{DynamicResource Status.Warning}"/></DataTrigger>
                <DataTrigger Binding="{Binding ConnectionState}" Value="Degraded"><Setter Property="Fill" Value="{DynamicResource Status.Warning}"/></DataTrigger>
                <DataTrigger Binding="{Binding ConnectionState}" Value="Failed"><Setter Property="Fill" Value="{DynamicResource Status.Error}"/></DataTrigger>
                <DataTrigger Binding="{Binding ConnectionState}" Value="Stopped"><Setter Property="Fill" Value="{DynamicResource Accent.Primary}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlatformTab" TargetType="RadioButton" BasedOn="{StaticResource NavigationButton}">
            <Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,22,32">
            <ctrl:PageHeader x:Name="DropsPageHeader" Title="掉宝" Description="统一管理 SOOP、YouTube、Twitch 与哔哩哔哩的观看与掉宝。">
                <ctrl:PageHeader.HeaderActions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="刷新" Style="{StaticResource SecondaryButton}" Padding="14,0"
                                VerticalAlignment="Top" Click="OnRefresh"/>
                    </StackPanel>
                </ctrl:PageHeader.HeaderActions>
            </ctrl:PageHeader>

            <Border x:Name="DropsNetworkSummary" Style="{StaticResource SurfaceCard}" Margin="0,16,0,0" Padding="14,11">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="网络与代理" Style="{StaticResource SectionTitle}" FontSize="16"/>
                            <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Padding="8,3">
                                <TextBlock Text="{Binding NetworkProxyModeText}" Foreground="{DynamicResource Accent.Primary}" FontSize="10.5"/>
                            </Border>
                        </WrapPanel>
                        <UniformGrid Columns="3" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="代理地址" Foreground="{DynamicResource Text.Muted}" FontSize="10.5"/>
                                <TextBlock Text="{Binding NetworkProxyUrlText}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding NetworkProxyUrlText}"/>
                            </StackPanel>
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock Text="失败策略" Foreground="{DynamicResource Text.Muted}" FontSize="10.5"/>
                                <TextBlock Text="{Binding NetworkProxyFallbackText}" FontSize="11.5"/>
                            </StackPanel>
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock Text="适用范围" Foreground="{DynamicResource Text.Muted}" FontSize="10.5"/>
                                <TextBlock Text="SOOP · YouTube · Twitch" FontSize="11.5"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="哔哩哔哩默认直连，可在其设置中单独选择全局代理；Chrome / Brave 调试连接始终直连。"
                                   Foreground="{DynamicResource Text.Muted}" FontSize="10.5" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="前往设置" Style="{StaticResource SecondaryButton}"
                            Padding="13,0" Margin="16,0,0,0" VerticalAlignment="Center" Click="OnOpenProxySettings"/>
                </Grid>
            </Border>

            <Grid x:Name="PlatformTabsBar" Margin="0,14,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <RadioButton x:Name="SoopTab" Tag="Soop" GroupName="DropsPlatform" Style="{StaticResource PlatformTab}" Checked="OnPlatformChanged">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" DataContext="{Binding Soop}">
                        <Ellipse x:Name="SoopStatusDot" Style="{StaticResource PlatformStatusDot}" ToolTip="{Binding ConnectionStateText}"/>
                        <TextBlock Text="SOOP"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="YouTubeTab" Grid.Column="1" Tag="YouTube" GroupName="DropsPlatform" Style="{StaticResource PlatformTab}" Checked="OnPlatformChanged">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" DataContext="{Binding YouTube}">
                        <Ellipse x:Name="YouTubeStatusDot" Style="{StaticResource PlatformStatusDot}" ToolTip="{Binding ConnectionStateText}"/>
                        <TextBlock Text="YouTube"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TwitchTab" Grid.Column="2" Tag="Twitch" GroupName="DropsPlatform" Style="{StaticResource PlatformTab}" Checked="OnPlatformChanged">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" DataContext="{Binding Twitch}">
                        <Ellipse x:Name="TwitchStatusDot" Style="{StaticResource PlatformStatusDot}" ToolTip="{Binding ConnectionStateText}"/>
                        <TextBlock Text="Twitch"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="BilibiliTab" Grid.Column="3" Tag="Bilibili" GroupName="DropsPlatform" Style="{StaticResource PlatformTab}" Checked="OnPlatformChanged">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" DataContext="{Binding Bilibili}">
                        <Ellipse x:Name="BilibiliStatusDot" Style="{StaticResource PlatformStatusDot}" ToolTip="{Binding ConnectionStateText}"/>
                        <TextBlock Text="哔哩哔哩"/>
                    </StackPanel>
                </RadioButton>
            </Grid>

            <StackPanel x:Name="SoopPanel" Visibility="{Binding SoopPanelVisibility}">
                <Border Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <DockPanel>
                            <Button Content="使用帮助" Tag="Soop" DockPanel.Dock="Right"
                                    Style="{StaticResource SecondaryButton}" Padding="12,0" Click="OnToggleHelp"/>
                            <StackPanel>
                                <TextBlock Text="SOOP" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="先添加账号并刷新掉宝信息，确认任务后再启动账号。"
                                           Foreground="{DynamicResource Text.Secondary}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Border x:Name="SoopHelp" Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8"
                                Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Text="添加账号后，先刷新直播间、任务和背包。确认存在可用任务后，再启动账号。程序会按照当前策略自动选择直播间并执行掉宝任务。"
                                       Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                        </Border>
                        <Expander Header="{Binding SoopQuickStart.Summary}" IsExpanded="{Binding SoopQuickStart.IsExpanded, Mode=TwoWay}"
                                  Foreground="{DynamicResource Text.Primary}" Margin="0,12,0,0">
                            <ItemsControl ItemsSource="{Binding SoopQuickStart.Steps}" ItemTemplate="{StaticResource QuickStartStepTemplate}"
                                          Margin="12,6,0,0"/>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SurfaceCard}" Margin="0,14,0,0">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button Content="立即重试" DockPanel.Dock="Right"
                                    Visibility="{Binding SoopRetryNowVisibility}"
                                    Style="{StaticResource SecondaryButton}" Padding="12,0"
                                    Click="OnSoopRetryNow"/>
                            <StackPanel>
                                <TextBlock Text="当前掉宝进度" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding SoopRetryStatusText}"
                                           Visibility="{Binding SoopRetryStatusVisibility}"
                                           Foreground="{DynamicResource Status.Warning}" Margin="0,5,10,0"/>
                                <TextBlock Text="{Binding SoopLastSuccessText}"
                                           Visibility="{Binding SoopLastSuccessVisibility}"
                                           Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,4,10,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid Margin="0,10,0,0" MinHeight="92">
                            <ListBox ItemsSource="{Binding SoopCurrentProgress}"
                                     ItemTemplate="{StaticResource SoopProgressRowTemplate}" MaxHeight="300"/>
