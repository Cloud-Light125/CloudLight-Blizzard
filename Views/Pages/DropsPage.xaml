<UserControl x:Class="CloudLightBlizzard.Views.Pages.DropsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls"
             xmlns:behaviors="clr-namespace:CloudLightBlizzard.Behaviors"
             behaviors:NestedScrollBehavior.IsEnabled="True"
             Foreground="{DynamicResource Text.Primary}"
             Background="{DynamicResource App.Background}">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RecoveryStateText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConnectionState}" Value="Connected"><Setter Property="Foreground" Value="{DynamicResource Status.Success}"/></DataTrigger>
                <DataTrigger Binding="{Binding ConnectionState}" Value="Connecting"><Setter Property="Foreground" Value="{DynamicResource Accent.Primary}"/></DataTrigger>
                <DataTrigger Binding="{Binding ConnectionState}" Value="Recovering"><Setter Property="Foreground" Value="{DynamicResource Accent.Primary}"/></DataTrigger>
                <DataTrigger Binding="{Binding ConnectionState}" Value="Degraded"><Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/></DataTrigger>
                <DataTrigger Binding="{Binding ConnectionState}" Value="WaitingRetry"><Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/></DataTrigger>
                <DataTrigger Binding="{Binding ConnectionState}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource Status.Error}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HintTextBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{DynamicResource InputBd}" BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource Text.Muted}" Margin="10,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="9,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Acc}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Background" Value="{DynamicResource Input}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBd}"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="StaysOpenOnEdit" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{DynamicResource ThemeComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Box" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBd}"
                                                BorderThickness="1" CornerRadius="8" Padding="10,0">
                                            <DockPanel>
                                                <TextBlock Text="⌄" DockPanel.Dock="Right" Foreground="{DynamicResource Text.Secondary}"
                                                           VerticalAlignment="Center" Margin="10,0,0,2"/>
                                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Text.Primary}"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent.Primary}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Text.Primary}" CaretBrush="{DynamicResource Text.Primary}"
                                     Margin="10,0,36,0" VerticalContentAlignment="Center"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource App.SurfaceElevated}" BorderBrush="{DynamicResource App.Border}"
                                        BorderThickness="1" CornerRadius="8" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="320"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="DropsRowTemplate">
            <Grid Margin="4,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Primary}" ToolTip="{Binding Primary}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Secondary}" Foreground="{DynamicResource Text.Secondary}" FontSize="11"
                               ToolTip="{Binding Secondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent.Primary}" FontSize="10.5"/>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="TwitchDropRowTemplate">
            <Grid Margin="6,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Primary}" ToolTip="{Binding Primary}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Secondary}" Foreground="{DynamicResource Text.Secondary}"
                               FontSize="11" ToolTip="{Binding Secondary}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <Border Style="{StaticResource Badge}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent.Primary}"
                                   FontSize="10.5"/>
                    </Border>
                    <Button Content="{Binding TwitchClaimButtonText}"
                            Visibility="{Binding TwitchClaimVisibility}"
                            IsEnabled="{Binding CanStartTwitchClaim}"
                            Style="{StaticResource SecondaryButton}" Padding="12,0" Margin="10,0,0,0"
                            Click="OnClaimTwitchDrop"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="TwitchCampaignRowTemplate">
            <Grid Margin="6,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" MinWidth="100"/>
                    <ColumnDefinition Width="1.8*" MinWidth="150"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Secondary}" ToolTip="{Binding Secondary}"
                           VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Primary}" ToolTip="{Binding Primary}"
                           Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="14,0,10,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent.Primary}" FontSize="10.5"/>
                </Border>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="5"
                                 Background="{DynamicResource App.SurfaceElevated}"
                                 Foreground="{DynamicResource Accent.Primary}"/>
                    <TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}"
                               Foreground="{DynamicResource Text.Secondary}" FontSize="10.5"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="YouTubeChannelRowTemplate">
            <Grid Margin="4,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="2,0,10,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Text.Muted}"/>
                            <Setter Property="ToolTip" Value="已停用"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Enabled}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource Status.Success}"/>
                                    <Setter Property="ToolTip" Value="已启用"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Primary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Secondary}" ToolTip="{Binding Secondary}"
                               Foreground="{DynamicResource Text.Secondary}" FontSize="11" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="QuickStartStepTemplate">
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Number}" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <WrapPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StateKind}" Value="complete">
                                            <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateKind}" Value="progress">
                                            <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>
                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Text.Muted}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding ActionText}" Tag="{Binding ActionKey}"
                        Visibility="{Binding ActionVisibility}" Style="{StaticResource SecondaryButton}"
                        Padding="12,0" VerticalAlignment="Center" Click="OnQuickStartAction"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SoopProgressRowTemplate">
            <Grid Margin="6,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Campaign}" ToolTip="{Binding Campaign}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="12,0,0,0">
                        <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource Accent.Primary}" FontSize="10.5"/>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="1" Margin="0,5,0,0" TextTrimming="CharacterEllipsis">
                    <Run Text="当前奖励："/><Run Text="{Binding Reward, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Grid.Row="2" Margin="0,4,0,0" Foreground="{DynamicResource Text.Secondary}" FontSize="11" TextTrimming="CharacterEllipsis">
                    <Run Text="账号："/><Run Text="{Binding Account, Mode=OneWay}"/><Run Text="　直播间："/><Run Text="{Binding Channel, Mode=OneWay}"/>
                </TextBlock>
                <ProgressBar Grid.Row="3" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                             Style="{StaticResource ThemeProgressBar}" Height="6" Margin="0,8,0,0"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="PlatformTab" TargetType="RadioButton" BasedOn="{StaticResource NavigationButton}">
            <Setter Property="MinWidth" Value="118"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,22,32">
            <ctrl:PageHeader Title="掉宝" Description="统一管理 SOOP、YouTube 与 Twitch 的观看与掉宝。">
                <ctrl:PageHeader.HeaderActions>
                    <Button Content="刷新" Style="{StaticResource SecondaryButton}" Padding="14,0"
                            VerticalAlignment="Top" Click="OnRefresh"/>
                </ctrl:PageHeader.HeaderActions>
            </ctrl:PageHeader>

            <Border Style="{StaticResource SurfaceCard}" Margin="0,16,0,0" Padding="16,13">
                <DockPanel>
                    <Button Content="前往设置" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                            Padding="13,0" Margin="16,0,0,0" Click="OnOpenProxySettings"/>
                    <StackPanel>
                        <TextBlock Text="{Binding NetworkProxyStatus}" FontWeight="SemiBold"/>
                        <TextBlock Text="SOOP、YouTube 与 Twitch 共用此网络设置。Chrome / Brave 的本机调试连接始终直连。"
                                   Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <UniformGrid Columns="3" Margin="0,16,0,0">
                <Border Style="{StaticResource SurfaceCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <DockPanel><TextBlock Text="SOOP" Style="{StaticResource SectionTitle}"/><Border DockPanel.Dock="Right" Style="{StaticResource Badge}"><StackPanel Orientation="Horizontal"><TextBlock Text="● " Foreground="{DynamicResource Accent.Primary}"/><TextBlock Text="{Binding Soop.Status}" Foreground="{DynamicResource Accent.Primary}"/></StackPanel></Border></DockPanel>
                        <TextBlock Text="{Binding Soop.Summary}" Foreground="{DynamicResource Text.Secondary}" Margin="0,10,0,12" TextWrapping="Wrap"/>
                        <WrapPanel><Button Content="全部开始" Tag="Soop" Visibility="{Binding Soop.StartVisibility}" Style="{StaticResource PrimaryButton}" Padding="14,0" Click="OnStart"/><Button Content="全部停止" Tag="Soop" Visibility="{Binding Soop.StopVisibility}" Style="{StaticResource SecondaryButton}" Padding="14,0" Click="OnStop"/><Button Content="进入" Tag="Soop" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="8,0,0,0" Click="OnOpenPlatform"/></WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SurfaceCard}" Margin="4,0">
                    <StackPanel>
                        <DockPanel><TextBlock Text="YouTube" Style="{StaticResource SectionTitle}"/><Border DockPanel.Dock="Right" Style="{StaticResource Badge}"><StackPanel Orientation="Horizontal"><TextBlock Text="● " Foreground="{DynamicResource Accent.Primary}"/><TextBlock Text="{Binding YouTube.Status}" Foreground="{DynamicResource Accent.Primary}"/></StackPanel></Border></DockPanel>
                        <TextBlock Text="{Binding YouTube.Summary}" Foreground="{DynamicResource Text.Secondary}" Margin="0,10,0,12" TextWrapping="Wrap"/>
                        <WrapPanel><Button Content="开始观看" Tag="YouTube" Visibility="{Binding YouTube.StartVisibility}" Style="{StaticResource PrimaryButton}" Padding="14,0" Click="OnStart"/><Button Content="停止观看" Tag="YouTube" Visibility="{Binding YouTube.StopVisibility}" Style="{StaticResource SecondaryButton}" Padding="14,0" Click="OnStop"/><Button Content="进入" Tag="YouTube" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="8,0,0,0" Click="OnOpenPlatform"/></WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SurfaceCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <DockPanel><TextBlock Text="Twitch" Style="{StaticResource SectionTitle}"/><Border DockPanel.Dock="Right" Style="{StaticResource Badge}"><StackPanel Orientation="Horizontal"><TextBlock Text="● " Foreground="{DynamicResource Accent.Primary}"/><TextBlock Text="{Binding Twitch.Status}" Foreground="{DynamicResource Accent.Primary}"/></StackPanel></Border></DockPanel>
                        <TextBlock Text="{Binding Twitch.Summary}" Foreground="{DynamicResource Text.Secondary}" Margin="0,10,0,12" TextWrapping="Wrap"/>
                        <WrapPanel><Button Content="开始 Twitch 掉宝" Tag="Twitch" Visibility="{Binding Twitch.StartVisibility}" Style="{StaticResource PrimaryButton}" Padding="14,0" Click="OnStart"/><Button Content="停止 Twitch 掉宝" Tag="Twitch" Visibility="{Binding Twitch.StopVisibility}" Style="{StaticResource SecondaryButton}" Padding="14,0" Click="OnStop"/><Button Content="进入" Tag="Twitch" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="8,0,0,0" Click="OnOpenPlatform"/></WrapPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource SurfaceCard}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="自愈状态" Style="{StaticResource SectionTitle}" />
                        <TextBlock DockPanel.Dock="Right" Text="自动重试不会终止现有恢复流程"
                                   Foreground="{DynamicResource Text.Muted}" FontSize="11"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Platforms}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8"
                                        Padding="12,10" Margin="0,0,8,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ConnectionStateText}"
                                                       Style="{StaticResource RecoveryStateText}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding RecoveryStageText}" Foreground="{DynamicResource Text.Secondary}"
                                                   Margin="0,5,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding WorkerHealth, StringFormat=Worker：{0}}"
                                                   Foreground="{DynamicResource Text.Secondary}" Margin="0,7,0,0" />
                                        <TextBlock Text="{Binding LastHeartbeatText, StringFormat=最近心跳：{0}}"
                                                   Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding LastProgressText, StringFormat=最近进度：{0}}"
                                                   Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding LastReconnectText, StringFormat=最近重连：{0}}"
                                                   Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding ConsecutiveFailures, StringFormat=连续失败：{0}}"
                                                   Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding ReconnectCount, StringFormat=自动重连：{0} 次}"
                                                   Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding NextRetryText, StringFormat=下次重试：{0}}"
                                                   Foreground="{DynamicResource Status.Warning}" FontSize="11" Margin="0,3,0,0" />
                                        <Button Content="重启 Worker" Tag="{Binding Platform}"
                                                Style="{StaticResource SecondaryButton}" Padding="10,0"
                                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Click="OnRestartWorker" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="最近事件" Style="{StaticResource SectionTitle}" />
                        <TextBlock DockPanel.Dock="Right" Text="最多保留 10 条"
                                   Foreground="{DynamicResource Text.Muted}" FontSize="11" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding RecoveryEvents}" MaxHeight="150" Margin="0,8,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62" /><ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding PlatformText}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="{DynamicResource Accent.Primary}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Detail}" Foreground="{DynamicResource Text.Secondary}"
                                               Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="暂无恢复事件。网络中断、重试与恢复过程会显示在这里。"
                               Foreground="{DynamicResource Text.Muted}" Margin="4,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecoveryEvents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,12">
                <RadioButton x:Name="SoopTab" Content="SOOP" Tag="Soop" GroupName="DropsPlatform" Style="{StaticResource PlatformTab}" Checked="OnPlatformChanged"/>
                <RadioButton x:Name="YouTubeTab" Content="YouTube" Tag="YouTube" GroupName="DropsPlatform" Style="{StaticResource PlatformTab}" Checked="OnPlatformChanged"/>
                <RadioButton x:Name="TwitchTab" Content="Twitch" Tag="Twitch" GroupName="DropsPlatform" Style="{StaticResource PlatformTab}" Checked="OnPlatformChanged"/>
            </StackPanel>

            <StackPanel x:Name="SoopPanel" Visibility="Collapsed">
                <Border Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <DockPanel>
                            <Button Content="使用帮助" Tag="Soop" DockPanel.Dock="Right"
                                    Style="{StaticResource SecondaryButton}" Padding="12,0" Click="OnToggleHelp"/>
                            <StackPanel>
                                <TextBlock Text="SOOP" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="先添加账号并刷新掉宝信息，确认任务后再启动账号。"
                                           Foreground="{DynamicResource Text.Secondary}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Border x:Name="SoopHelp" Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8"
                                Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Text="添加账号后，先刷新直播间、任务和背包。确认存在可用任务后，再启动账号。程序会按照当前策略自动选择直播间并执行掉宝任务。"
                                       Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                        </Border>
                        <Expander Header="{Binding SoopQuickStart.Summary}" IsExpanded="{Binding SoopQuickStart.IsExpanded, Mode=TwoWay}"
                                  Foreground="{DynamicResource Text.Primary}" Margin="0,12,0,0">
                            <ItemsControl ItemsSource="{Binding SoopQuickStart.Steps}" ItemTemplate="{StaticResource QuickStartStepTemplate}"
                                          Margin="12,6,0,0"/>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SurfaceCard}" Margin="0,14,0,0">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button Content="立即重试" DockPanel.Dock="Right"
                                    Visibility="{Binding SoopRetryNowVisibility}"
                                    Style="{StaticResource SecondaryButton}" Padding="12,0"
                                    Click="OnSoopRetryNow"/>
                            <StackPanel>
                                <TextBlock Text="当前掉宝进度" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding SoopRetryStatusText}"
                                           Visibility="{Binding SoopRetryStatusVisibility}"
                                           Foreground="{DynamicResource Status.Warning}" Margin="0,5,10,0"/>
                                <TextBlock Text="{Binding SoopLastSuccessText}"
                                           Visibility="{Binding SoopLastSuccessVisibility}"
                                           Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,4,10,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid Margin="0,10,0,0" MinHeight="92">
                            <ListBox ItemsSource="{Binding SoopCurrentProgress}"
                                     ItemTemplate="{StaticResource SoopProgressRowTemplate}" MaxHeight="300"/>
