<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:behaviors="clr-namespace:CloudLightBlizzard.Behaviors" xmlns:bilibili="clr-namespace:CloudLightBlizzard.Views.Drops.Bilibili" xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls" xmlns:soop="clr-namespace:CloudLightBlizzard.Views.Drops.Soop" xmlns:twitch="clr-namespace:CloudLightBlizzard.Views.Drops.Twitch" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:youtube="clr-namespace:CloudLightBlizzard.Views.Drops.YouTube" x:Class="CloudLightBlizzard.Views.Pages.DropsPage" x:Name="DropsRoot" behaviors:NestedScrollBehavior.IsEnabled="True" Foreground="{DynamicResource Text.Primary}" Background="{DynamicResource App.Background}">
    <Grid x:Name="DropsLayout" Margin="24,22,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ctrl:PageHeader x:Name="DropsPageHeader" Title="掉宝管理" Description="连接账号、选择活动，让每个平台的观看状态清楚可见。" Visibility="Collapsed">
            <ctrl:PageHeader.HeaderActions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="刷新" Style="{StaticResource SecondaryButton}" Padding="14,0" VerticalAlignment="Top" Click="OnRefresh" />
                </StackPanel>
            </ctrl:PageHeader.HeaderActions>
        </ctrl:PageHeader>
        <Grid x:Name="PlatformTabsBar" Margin="0,0,0,6" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <RadioButton x:Name="SoopTab" Tag="Soop" GroupName="DropsPlatform" Style="{StaticResource PlatformTab}" Checked="OnPlatformChanged" Grid.Column="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" DataContext="{Binding Soop}">
                    <ctrl:PlatformIcon Platform="Soop" Width="20" Height="20" Margin="0,0,10,0" />
                    <Ellipse x:Name="SoopStatusDot" Style="{StaticResource PlatformStatusDot}" ToolTip="{Binding ConnectionStateText}" />
                    <TextBlock Text="SOOP" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="YouTubeTab" Grid.Column="4" Tag="YouTube" GroupName="DropsPlatform" Style="{StaticResource PlatformTab}" Checked="OnPlatformChanged">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" DataContext="{Binding YouTube}">
                    <ctrl:PlatformIcon Platform="YouTube" Width="20" Height="20" Margin="0,0,10,0" />
                    <Ellipse x:Name="YouTubeStatusDot" Style="{StaticResource PlatformStatusDot}" ToolTip="{Binding ConnectionStateText}" />
                    <TextBlock Text="YouTube" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="TwitchTab" Grid.Column="2" Tag="Twitch" GroupName="DropsPlatform" Style="{StaticResource PlatformTab}" Checked="OnPlatformChanged">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" DataContext="{Binding Twitch}">
                    <ctrl:PlatformIcon Platform="Twitch" Width="20" Height="20" Margin="0,0,10,0" />
                    <Ellipse x:Name="TwitchStatusDot" Style="{StaticResource PlatformStatusDot}" ToolTip="{Binding ConnectionStateText}" />
                    <TextBlock Text="Twitch" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="BilibiliTab" Grid.Column="3" Tag="Bilibili" GroupName="DropsPlatform" Style="{StaticResource PlatformTab}" Checked="OnPlatformChanged">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" DataContext="{Binding Bilibili}">
                    <ctrl:PlatformIcon Platform="Bilibili" Width="20" Height="20" Margin="0,0,10,0" />
                    <Ellipse x:Name="BilibiliStatusDot" Style="{StaticResource PlatformStatusDot}" ToolTip="{Binding ConnectionStateText}" />
                    <TextBlock Text="哔哩哔哩" />
                </StackPanel>
            </RadioButton>
            <TextBlock x:Name="PlatformPageTitle" Text="掉宝管理" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ctrl:AnnouncementBell Grid.Column="5" Margin="8,0,0,0" />
        </Grid>
        <WrapPanel x:Name="WorkspaceNavigation" Margin="0,8,0,8" Grid.Row="2">
            <RadioButton Content="概览" Tag="overview" GroupName="DropsWorkspace" Style="{StaticResource WorkspaceTab}" Checked="OnWorkspaceChanged" />
            <RadioButton Content="账号管理" Tag="accounts" GroupName="DropsWorkspace" Style="{StaticResource WorkspaceTab}" Checked="OnWorkspaceChanged" />
            <RadioButton Content="奖励队列" Tag="queue" GroupName="DropsWorkspace" Style="{StaticResource WorkspaceTab}" Checked="OnWorkspaceChanged"/>
            <RadioButton Content="活动与奖励" Tag="activities" GroupName="DropsWorkspace" Style="{StaticResource WorkspaceTab}" Checked="OnWorkspaceChanged" />
            <RadioButton Content="观看配置" Tag="settings" GroupName="DropsWorkspace" Style="{StaticResource WorkspaceTab}" Checked="OnWorkspaceChanged" />
            <RadioButton Content="网络与维护" Tag="network" GroupName="DropsWorkspace" Style="{StaticResource WorkspaceTab}" Checked="OnWorkspaceChanged" />
            <RadioButton Content="运行日志" Tag="logs" GroupName="DropsWorkspace" Style="{StaticResource WorkspaceTab}" Checked="OnWorkspaceChanged" />
            <RadioButton Content="游戏优先级" Tag="games" GroupName="DropsWorkspace" Style="{StaticResource WorkspaceTab}" Checked="OnWorkspaceChanged" Visibility="Collapsed" />
            <RadioButton Content="自动化" Tag="automation" GroupName="DropsWorkspace" Style="{StaticResource WorkspaceTab}" Checked="OnWorkspaceChanged" Visibility="Collapsed" />
            <RadioButton Content="刷新与恢复" Tag="advanced" GroupName="DropsWorkspace" Style="{StaticResource WorkspaceTab}" Checked="OnWorkspaceChanged" Visibility="Collapsed" />
        </WrapPanel>
        <ScrollViewer x:Name="DropsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="3">
            <StackPanel Margin="0,0,4,12">
                <Border x:Name="DropsRuntimeSummary" Style="{StaticResource SurfaceCard}" Margin="0,0,0,8" Padding="8" CornerRadius="10" Visibility="{Binding ActivePlatform.NoticeVisibility}">
                    <Border x:Name="DropsNoticeBanner" Visibility="{Binding ActivePlatform.NoticeVisibility}" Background="{DynamicResource App.SurfaceAlt}" CornerRadius="7" Padding="6" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{Binding ActivePlatform.NoticeLevel}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActivePlatform.NoticeLevel}" Value="成功">
                                                <Setter Property="Foreground" Value="{DynamicResource Status.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActivePlatform.NoticeLevel}" Value="警告">
                                                <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActivePlatform.NoticeLevel}" Value="错误">
                                                <Setter Property="Foreground" Value="{DynamicResource Status.Error}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActivePlatform.NoticeLevel}" Value="需要操作">
                                                <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ActivePlatform.Notice}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <WrapPanel Margin="0,7,0,0">
                                <Button Content="重试连接 / 刷新" Style="{StaticResource SecondaryButton}" Padding="10,0" Click="OnActiveRetry" />
                                <Button Content="查看日志" Style="{StaticResource SecondaryButton}" Padding="10,0" Margin="8,0,0,0" Click="OnShowDropsLog" />
                                <Button x:Name="DropsDismissNoticeButton" Content="关闭提醒" Style="{StaticResource SecondaryButton}" Padding="10,0" Margin="8,0,0,0" Click="OnDismissNotice" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Border>
                <soop:SoopWorkspace x:Name="SoopWorkspace" />
                <twitch:TwitchWorkspace x:Name="TwitchWorkspace" />
                <bilibili:BilibiliWorkspace x:Name="BilibiliWorkspace" />
                <youtube:YouTubeWorkspace x:Name="YouTubeWorkspace" />
                <StackPanel Tag="workspace:network">
                    <Border Style="{StaticResource SectionCard}">
                        <Expander Header="旧版数据导入（高级）" IsExpanded="False">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="导入所选平台的旧版设置、账号或 Session 与缓存。同名文件继续由原有对话框逐项确认覆盖、跳过或取消；原目录保留。请先停止当前平台。" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,12" />
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActivePlatform.Running}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Content="导入 SOOP 旧版数据" Tag="Soop" Visibility="{Binding SoopPanelVisibility}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="14,0" Click="OnImport" />
                                    <Button Content="导入 Twitch 旧版数据" Tag="Twitch" Visibility="{Binding TwitchPanelVisibility}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="14,0" Click="OnImport" />
                                    <Button Content="导入 Bilibili 旧版数据" Tag="Bilibili" Visibility="{Binding BilibiliPanelVisibility}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="14,0" Click="OnImport" />
                                    <Button Content="导入 YouTube 旧版数据" Tag="YouTube" Visibility="{Binding YouTubePanelVisibility}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="14,0" Click="OnImport" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </Border>
                    <Expander x:Name="DropsDiagnosticsExpander" Header="网络、代理与诊断" Margin="0,14,0,0" Foreground="{DynamicResource Text.Primary}" IsExpanded="True">
                        <Border x:Name="DropsNetworkSummary" Style="{StaticResource SurfaceCard}" Margin="0,16,0,0" Padding="14,11" CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Text="网络与代理" Style="{StaticResource SectionTitle}" FontSize="16" />
                                        <Button Content="网络测试" Style="{StaticResource SecondaryButton}" Padding="12,0" Margin="10,0,0,0" Click="OnNetworkCheck" />
                                        <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Padding="8,3">
                                            <TextBlock Text="{Binding NetworkProxyModeText}" Foreground="{DynamicResource Accent.Primary}" FontSize="13" />
                                        </Border>
                                    </WrapPanel>
                                    <UniformGrid Columns="2" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="代理地址" Foreground="{DynamicResource Text.Muted}" FontSize="13" />
                                            <TextBlock Text="{Binding NetworkProxyUrlText}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding NetworkProxyUrlText}" />
                                        </StackPanel>
                                        <StackPanel Margin="14,0,0,0">
                                            <TextBlock Text="失败策略" Foreground="{DynamicResource Text.Muted}" FontSize="13" />
                                            <TextBlock Text="{Binding NetworkProxyFallbackText}" FontSize="13" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Padding="10,8" Margin="0,9,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="掉宝代理范围" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding NetworkProxyScopeText}" Foreground="{DynamicResource Text.Muted}" FontSize="13" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <CheckBox x:Name="SoopUseProxyCheck" Content="SOOP" Style="{StaticResource ThemeCheckBox}" Margin="0,0,16,0" Checked="OnDropsProxyScopeChanged" Unchecked="OnDropsProxyScopeChanged" />
                                                <CheckBox x:Name="YouTubeUseProxyCheck" Content="YouTube" Style="{StaticResource ThemeCheckBox}" Margin="0,0,16,0" Checked="OnDropsProxyScopeChanged" Unchecked="OnDropsProxyScopeChanged" />
                                                <CheckBox x:Name="TwitchUseProxyCheck" Content="Twitch" Style="{StaticResource ThemeCheckBox}" Margin="0,0,16,0" Checked="OnDropsProxyScopeChanged" Unchecked="OnDropsProxyScopeChanged" />
                                                <CheckBox x:Name="BilibiliUseProxyCheck" Content="哔哩哔哩" Style="{StaticResource ThemeCheckBox}" Checked="OnDropsProxyScopeChanged" Unchecked="OnDropsProxyScopeChanged" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="代理地址、总开关和失败策略仍在设置页管理；Chrome / Brave 调试连接始终直连。" Foreground="{DynamicResource Text.Muted}" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="前往设置" Style="{StaticResource SecondaryButton}" Padding="13,0" Margin="16,0,0,0" VerticalAlignment="Center" Click="OnOpenProxySettings" />
                            </Grid>
                        </Border>
                    </Expander>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="平台维护快捷操作" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="DropsActiveStartButton" Content="{Binding ActiveStartText}" IsEnabled="{Binding CanActiveStart}" Style="{StaticResource SecondaryButton}" Padding="14,0" Click="OnActiveStart" Margin="0,0,8,8" />
                                <Button x:Name="DropsActiveStopButton" Content="停止" IsEnabled="{Binding CanActiveStop}" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="0,0,8,8" Click="OnActiveStop" />
                                <Button Content="刷新当前平台" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="0,0,8,8" Click="OnRefresh" />
                                <Button Content="官方背包 / 平台" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="0,0,8,8" Click="OnActiveInventory" />
                                <Button Content="打开直播间" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="0,0,8,8" Click="OnOpenCurrentWatch" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="运行状态" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="{Binding ActivePlatform.Name}" Style="{StaticResource SectionTitle}" Margin="0,0,14,0" />
                                    <TextBlock Text="{Binding ActivePlatform.Status}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </WrapPanel>
                                <TextBlock Text="{Binding ActiveAccountText, StringFormat=账号：{0}}" Margin="0,7,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ActivePlatform.Summary}" Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Tag="workspace:logs">
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,14,0,0" CornerRadius="14">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="运行日志" Style="{StaticResource SectionTitle}" />
                                <WrapPanel DockPanel.Dock="Right">
                                    <Button Content="复制全部" Style="{StaticResource SecondaryButton}" Padding="12,0" Click="OnCopyAllLogs" />
                                    <Button Content="清空显示" Style="{StaticResource SecondaryButton}" Padding="12,0" Margin="8,0,0,0" Click="OnClearLogDisplay" />
                                </WrapPanel>
                            </DockPanel>
                            <Grid Margin="0,10,0,0" MinHeight="86">
                                <TextBox x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource App.SurfaceAlt}" Foreground="{DynamicResource Text.Primary}" CaretBrush="{DynamicResource Text.Primary}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" FontFamily="Consolas" FontSize="13" Height="220" Padding="8" TextChanged="OnLogTextChanged">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="复制" Command="Copy" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                            <MenuItem Header="全选" Command="SelectAll" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>
                                <TextBlock x:Name="LogEmptyHint" Text="暂无日志。" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="PlatformSettingsFooter" Grid.Row="4" Style="{StaticResource SurfaceCard}" Padding="16,12" Margin="0,12,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PlatformDraftHint" Text="更改会保留在当前页面，点击保存后应用。" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center" />
                <WrapPanel Grid.Column="1">
                    <Button Content="保存设置" IsEnabled="{Binding IsTwitchCoreAvailable}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="14,0" Margin="8,0,0,0" x:Name="TwitchSaveSettingsButton" Click="OnSaveTwitch" Visibility="{Binding TwitchPanelVisibility}" />
                    <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Padding="14,0" x:Name="SoopSaveSettingsButton" Click="OnSaveSoop" Margin="8,0,0,0" Visibility="{Binding SoopPanelVisibility}" />
                    <Button Content="保存设置" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="14,0" Margin="8,0,0,0" x:Name="YouTubeSaveSettingsButton" Click="OnSaveYouTube" Visibility="{Binding YouTubePanelVisibility}" />
                    <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Padding="12,0" Command="{Binding BilibiliDetails.SaveSettingsCommand}" Visibility="{Binding BilibiliPanelVisibility}" Margin="8,0,0,0" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
