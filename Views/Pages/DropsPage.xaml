                                       Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SoopCurrentProgress.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,7,0" VerticalAlignment="Top"><StackPanel><TextBlock Text="掉宝任务" Style="{StaticResource SectionTitle}"/><Grid Margin="0,10,0,0" MinHeight="120"><ListBox ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource DropsRowTemplate}" MaxHeight="280"/><TextBlock Text="当前没有可用任务。" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tasks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Margin="7,0,0,0" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Button Content="打开背包" DockPanel.Dock="Right"
                                        Style="{StaticResource SecondaryButton}" Height="26" Padding="10,0"
                                        FontSize="11" Click="OnOpenSoopInventory"/>
                                <TextBlock Text="奖励背包" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Margin="0,10,0,10" MinHeight="96">
                                <ListBox x:Name="SoopInventoryList" ItemsSource="{Binding Inventory}"
                                         ItemTemplate="{StaticResource DropsRowTemplate}" MaxHeight="240"/>
                                <TextBlock Text="背包中暂无奖励。" Foreground="{DynamicResource Text.Muted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Inventory.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <WrapPanel>
                                <Button Content="领取选中奖励" Style="{StaticResource SecondaryButton}" Padding="14,0" Click="OnClaimSoopReward"/>
                                <Button Content="复制选中兑换码" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="8,0,0,0" Click="OnCopySoopCode"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="SoopAccountsCard" Style="{StaticResource SurfaceCard}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="SOOP 账号" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0"><TextBlock Text="SOOP 账号" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SoopUserId" Style="{StaticResource HintTextBox}" Tag="请输入 SOOP 登录账号"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="密码" Style="{StaticResource FieldLabel}"/><Grid><PasswordBox x:Name="SoopPassword" PasswordChanged="OnSoopPasswordChanged"/><TextBlock x:Name="SoopPasswordHint" Text="请输入密码" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="11,0" IsHitTestVisible="False"/></Grid></StackPanel>
                            <Button Grid.Column="2" Content="添加账号" Style="{StaticResource PrimaryButton}" Padding="14,0" Margin="0,23,0,0" Click="OnSoopAddAccount"/>
                        </Grid>
                        <Grid Margin="0,12,0,10" MinHeight="86">
                            <ListBox x:Name="SoopAccountsList" ItemsSource="{Binding Accounts}" ItemTemplate="{StaticResource DropsRowTemplate}" MaxHeight="220"/>
                            <TextBlock Text="尚未添加 SOOP 账号。" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Accounts.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <WrapPanel><Button Content="启动选中账号" Style="{StaticResource PrimaryButton}" Padding="14,0" Click="OnSoopStartAccount"/><Button Content="停止选中账号" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="8,0,0,0" Click="OnSoopStopAccount"/><Button Content="设为主账号" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="8,0,0,0" Click="OnSoopSetPrimaryAccount"/><Button Content="删除选中账号" Style="{StaticResource DangerButton}" Padding="14,0" Margin="8,0,0,0" Click="OnSoopDeleteAccount"/><Button Content="全部开始" Tag="Soop" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="18,0,0,0" Click="OnStart"/><Button Content="全部停止" Tag="Soop" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="8,0,0,0" Click="OnStop"/></WrapPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="SoopSettingsCard" Style="{StaticResource SurfaceCard}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="直播间与任务策略" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="自动选择适合的直播间，或指定频道；同一账号同一时间只进入一个直播间。" Style="{StaticResource FieldHint}"/>
                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0"><TextBlock Text="直播间选择" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="SoopChannelMode" Style="{StaticResource ThemeComboBox}" SelectionChanged="OnSoopChannelModeChanged"><ComboBoxItem Content="自动选择" Tag="smart"/><ComboBoxItem Content="手动指定" Tag="manual"/><ComboBoxItem Content="仅守望先锋赛事频道" Tag="owesports"/></ComboBox></StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="优先任务" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="SoopPriorityMission" Style="{StaticResource ThemeComboBox}" DisplayMemberPath="Content" SelectedValuePath="Tag"/></StackPanel>
                        </Grid>
                        <StackPanel x:Name="SoopManualChannelPanel" Margin="0,12,0,0" Visibility="Collapsed"><TextBlock Text="直播间地址或频道 ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SoopManualChannel" Style="{StaticResource HintTextBox}" Tag="例如 owesports 或 https://play.sooplive.com/owesports"/></StackPanel>
                        <StackPanel x:Name="SoopPreferredChannelPanel" Margin="0,12,0,0" Visibility="Collapsed"><TextBlock Text="赛事频道" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SoopPreferredChannel" Style="{StaticResource HintTextBox}" Tag="owesports"/></StackPanel>
                        <WrapPanel Margin="0,14,0,0"><CheckBox x:Name="SoopLowBandwidth" Style="{StaticResource ThemeCheckBox}" Content="低流量模式" Margin="0,0,18,0"/><CheckBox x:Name="SoopAutoClaim" Style="{StaticResource ThemeCheckBox}" Content="自动领取奖励" Margin="0,0,18,0"/><CheckBox x:Name="SoopHangWithoutMissions" Style="{StaticResource ThemeCheckBox}" Content="没有任务时继续等待"/></WrapPanel>
                        <CheckBox x:Name="SoopAutoStart" Style="{StaticResource ThemeCheckBox}"
                                  Content="启动 CloudLight Blizzard 时自动运行 SOOP"
                                  Margin="0,14,0,0" Click="OnAutoStartChanged"/>
                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0"><TextBlock Text="任务刷新间隔" Style="{StaticResource FieldLabel}"/><DockPanel><TextBlock Text="秒" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="SoopMissionInterval" Style="{StaticResource HintTextBox}" Tag="90"/></DockPanel></StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="背包刷新间隔" Style="{StaticResource FieldLabel}"/><DockPanel><TextBlock Text="秒" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="SoopInventoryInterval" Style="{StaticResource HintTextBox}" Tag="300"/></DockPanel></StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="直播间刷新间隔" Style="{StaticResource FieldLabel}"/><DockPanel><TextBlock Text="秒" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="SoopChannelInterval" Style="{StaticResource HintTextBox}" Tag="300"/></DockPanel></StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,14,0,0"><Button Content="保存设置" Style="{StaticResource SecondaryButton}" Padding="14,0" Click="OnSaveSoop"/><Button Content="{Binding SoopRefreshButtonText}" IsEnabled="{Binding CanRefreshSoop}" Style="{StaticResource PrimaryButton}" Padding="14,0" Margin="8,0,0,0" Click="OnSoopRefresh"/><ProgressBar Width="70" Height="5" Margin="12,0,0,0" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding SoopRefreshProgressVisibility}" Background="{DynamicResource App.SurfaceAlt}" Foreground="{DynamicResource Accent.Primary}"/><TextBlock Text="{Binding SoopRefreshStatus}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="10,0,0,0"/></WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="YouTubePanel" Visibility="{Binding YouTubePanelVisibility}">
                <Border Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="使用帮助" Tag="YouTube"
                                        Style="{StaticResource SecondaryButton}" Padding="12,0" Click="OnToggleHelp"/>
                                <Button x:Name="YouTubeStartButton" Content="开始观看" Tag="YouTube"
                                        Visibility="{Binding YouTube.StartVisibility}" Style="{StaticResource PrimaryButton}"
                                        Padding="12,0" Margin="8,0,0,0" Click="OnStart"/>
                                <Button x:Name="YouTubeStopButton" Content="停止观看" Tag="YouTube"
                                        Visibility="{Binding YouTube.StopVisibility}" Style="{StaticResource SecondaryButton}"
                                        Padding="12,0" Margin="8,0,0,0" Click="OnStop"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="YouTube" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="CloudLight Blizzard 会使用所选 Chrome / Brave 和独立观看账号检查已启用频道，发现直播后自动开始观看。"
                                           Foreground="{DynamicResource Text.Secondary}" Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <Border x:Name="YouTubeHelp" Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8"
                                Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Text="选择 Chrome 或 Brave，添加观看账号并通过“打开登录窗口”完成 YouTube 登录。随后添加并启用要监控的频道。启动后，程序会定期检查直播并自动开始观看。"
                                       Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                        </Border>
                        <Expander Header="{Binding YouTubeQuickStart.Summary}" IsExpanded="{Binding YouTubeQuickStart.IsExpanded, Mode=TwoWay}"
                                  Foreground="{DynamicResource Text.Primary}" Margin="0,12,0,0">
                            <ItemsControl ItemsSource="{Binding YouTubeQuickStart.Steps}" ItemTemplate="{StaticResource QuickStartStepTemplate}"
                                          Margin="12,6,0,0"/>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SurfaceCard}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="直播与浏览器状态" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding YouTubeLastSuccessText}"
                                   Visibility="{Binding YouTubeLastSuccessVisibility}"
                                   Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,5,0,0"/>
                        <Grid Margin="0,10,0,0" MinHeight="110">
                            <ListBox ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource DropsRowTemplate}" MaxHeight="240"/>
                            <TextBlock Text="当前没有正在观看的直播。" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tasks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border x:Name="YouTubeAccountsCard" Style="{StaticResource SurfaceCard}" Margin="0,0,7,0"><StackPanel>
                        <TextBlock Text="观看账号" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="每个观看账号使用独立的 Chrome / Brave 浏览器资料目录，登录状态互不影响。" Style="{StaticResource FieldHint}"/>
                        <Grid Margin="0,10,0,10" MinHeight="110"><ListBox x:Name="YouTubeProfilesList" ItemsSource="{Binding Accounts}" ItemTemplate="{StaticResource DropsRowTemplate}" MaxHeight="220"/><TextBlock Text="暂无观看账号。" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Accounts.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                        <TextBlock Text="账号名称" Style="{StaticResource FieldLabel}"/><TextBox x:Name="YouTubeProfileName" Style="{StaticResource HintTextBox}" Tag="例如：主账号" Width="240" HorizontalAlignment="Left"/>
                        <WrapPanel Margin="0,10,0,0"><Button Content="添加账号" Style="{StaticResource SecondaryButton}" Padding="12,0" Click="OnYouTubeAddProfile"/><Button Content="打开登录窗口" Style="{StaticResource PrimaryButton}" Padding="12,0" Margin="8,0,0,0" Click="OnYouTubeLogin"/><Button Content="删除账号" Style="{StaticResource DangerButton}" Padding="12,0" Margin="8,0,0,0" Click="OnYouTubeDeleteProfile"/></WrapPanel>
                        <TextBlock Text="首次使用请在打开的浏览器中完成 YouTube 登录。" Style="{StaticResource FieldHint}"/>
                    </StackPanel></Border>
                    <Border x:Name="YouTubeChannelsCard" Grid.Column="1" Style="{StaticResource SurfaceCard}" Margin="7,0,0,0"><StackPanel>
                        <TextBlock Text="频道列表" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="程序只会自动检查已启用的频道。绿色圆点表示启用，灰色圆点表示停用。" Style="{StaticResource FieldHint}"/>
                        <Grid Margin="0,10,0,10" MinHeight="100"><ListBox x:Name="YouTubeChannelsList" ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource YouTubeChannelRowTemplate}" MaxHeight="180"/><TextBlock Text="尚未添加频道。" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Channels.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                        <TextBlock Text="频道名称" Style="{StaticResource FieldLabel}"/><TextBox x:Name="YouTubeChannelName" Style="{StaticResource HintTextBox}" Tag="例如：Overwatch Esports"/>
                        <TextBlock Text="频道 ID" Style="{StaticResource FieldLabel}" Margin="0,10,0,6"/><TextBox x:Name="YouTubeChannelId" Style="{StaticResource HintTextBox}" Tag="例如：UC..."/>
                        <TextBlock Text="频道地址" Style="{StaticResource FieldLabel}" Margin="0,10,0,6"/><TextBox x:Name="YouTubeChannelUrl" Style="{StaticResource HintTextBox}" Tag="也可以直接粘贴频道 URL"/>
                        <TextBlock Text="频道 ID 与频道地址填写任意一项即可。" Style="{StaticResource FieldHint}"/>
                        <WrapPanel Margin="0,10,0,0"><Button Content="添加频道" Style="{StaticResource SecondaryButton}" Padding="12,0" Click="OnYouTubeAddChannel"/><Button Content="启用 / 停用" Style="{StaticResource SecondaryButton}" Padding="12,0" Margin="8,0,0,0" Click="OnYouTubeToggleChannel"/><Button Content="删除" Style="{StaticResource DangerButton}" Padding="12,0" Margin="8,0,0,0" Click="OnYouTubeDeleteChannel"/></WrapPanel>
                    </StackPanel></Border>
                </Grid>
                <Border x:Name="YouTubeBrowserCard" Style="{StaticResource SurfaceCard}" Margin="0,14,0,0"><StackPanel>
                    <TextBlock Text="浏览器与观看设置" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="浏览器" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="YouTubeBrowser" Style="{StaticResource ThemeComboBox}" SelectionChanged="OnYouTubeBrowserChanged"><ComboBoxItem Content="Google Chrome" Tag="chrome"/><ComboBoxItem Content="Brave" Tag="brave"/></ComboBox></StackPanel>
                        <Expander Grid.Column="1" Header="自定义浏览器路径（可选）"
                                  Foreground="{DynamicResource Text.Secondary}" Margin="8,0,0,0">
                            <DockPanel Margin="0,8,0,0">
                                <Button Content="浏览..." DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                        Padding="12,0" Margin="8,0,0,0" Click="OnBrowseYouTubeBrowser"/>
                                <TextBox x:Name="YouTubeBrowserPath" Style="{StaticResource HintTextBox}"
                                         Tag="自动检测，通常无需填写"
                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </DockPanel>
                        </Expander>
                    </Grid>
                    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="观看模式" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="YouTubeMode" Style="{StaticResource ThemeComboBox}" SelectionChanged="OnYouTubeModeChanged"><ComboBoxItem Content="自动检测直播" Tag="auto"/><ComboBoxItem Content="手动指定直播" Tag="manual"/></ComboBox></StackPanel>
                        <StackPanel x:Name="YouTubeManualUrlPanel" Grid.Column="1" Margin="8,0,0,0" Visibility="Collapsed"><TextBlock Text="直播地址" Style="{StaticResource FieldLabel}"/><TextBox x:Name="YouTubeManualUrl" Style="{StaticResource HintTextBox}" Tag="粘贴 YouTube 直播地址"/></StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,14,0,0"><CheckBox x:Name="YouTubeHeadless" Style="{StaticResource ThemeCheckBox}" Content="无头模式" Margin="0,0,18,0"/><CheckBox x:Name="YouTubeMute" Style="{StaticResource ThemeCheckBox}" Content="静音播放"/></WrapPanel>
                    <StackPanel Margin="0,14,0,0" Width="300" HorizontalAlignment="Left"><TextBlock Text="直播检查间隔" Style="{StaticResource FieldLabel}"/><DockPanel><TextBlock Text="秒" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="YouTubeInterval" Style="{StaticResource HintTextBox}" Tag="300"/></DockPanel><TextBlock Text="每隔多久检查一次频道是否开播。" Style="{StaticResource FieldHint}"/></StackPanel>
                    <Button Content="保存设置" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="14,0" Margin="0,14,0,0" Click="OnSaveYouTube"/>
                </StackPanel></Border>

                <Border Style="{StaticResource SurfaceCard}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="观看时间与历史" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,10,0,0" MinHeight="110">
                            <ListBox ItemsSource="{Binding History}" ItemTemplate="{StaticResource DropsRowTemplate}" MaxHeight="240"/>
                            <TextBlock Text="暂无观看记录。" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="TwitchPanel" Visibility="{Binding TwitchPanelVisibility}">
                <Border Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <DockPanel>
                            <Button Content="使用帮助" Tag="Twitch" DockPanel.Dock="Right"
                                    Style="{StaticResource SecondaryButton}" Padding="12,0" Click="OnToggleHelp"/>
                            <StackPanel>
                                <TextBlock Text="Twitch" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="先完成登录，再设置掉宝偏好并明确启动 Twitch 掉宝。"
                                           Foreground="{DynamicResource Text.Secondary}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Border x:Name="TwitchHelp" Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8"
                                Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Text="首先完成 Twitch 登录。优先游戏决定程序优先处理哪些游戏的掉宝，排除游戏不会被自动选择。启动后，程序会获取掉宝活动、寻找符合条件的频道并持续更新掉宝进度。"
                                       Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                        </Border>
                        <Expander Header="{Binding TwitchQuickStart.Summary}" IsExpanded="{Binding TwitchQuickStart.IsExpanded, Mode=TwoWay}"
                                  Foreground="{DynamicResource Text.Primary}" Margin="0,12,0,0">
                            <ItemsControl ItemsSource="{Binding TwitchQuickStart.Steps}" ItemTemplate="{StaticResource QuickStartStepTemplate}"
                                          Margin="12,6,0,0"/>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border x:Name="TwitchLoginCard" Style="{StaticResource SurfaceCard}" Margin="0,14,0,0"><StackPanel>
                    <TextBlock Text="Twitch 登录与掉宝" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="登录信息仅保存在本机。登录成功与已经启动 Twitch 掉宝是两个不同状态，请以顶部状态和快速开始为准。" Style="{StaticResource FieldHint}"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Width="28" Height="4" Margin="0,0,12,0" VerticalAlignment="Center"
                                     IsIndeterminate="True" Foreground="{DynamicResource Accent.Primary}"
                                     Background="{DynamicResource App.SurfaceAlt}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TwitchConnectionStage}" Value="Unconnected"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding TwitchConnectionStage}" Value="Connected"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding TwitchConnectionStage}" Value="Running"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding TwitchConnectionStage}" Value="LoginSucceeded"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding TwitchConnectionStage}" Value="Stopped"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding TwitchConnectionStage}" Value="AuthenticationExpired"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding TwitchConnectionStage}" Value="NetworkFailed"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding TwitchConnectionStage}" Value="ProxyUnavailable"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding TwitchConnectionStage}" Value="SslCertificateError"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding TwitchConnectionStage}" Value="SslRuntimeError"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding TwitchConnectionStage}" Value="WorkerError"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Twitch.Status}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Twitch.Summary}" Foreground="{DynamicResource Text.Secondary}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
                        <Button Content="{Binding TwitchLoginButtonText}" IsEnabled="{Binding CanTwitchLogin}"
                                Visibility="{Binding TwitchLoginVisibility}" Style="{StaticResource PrimaryButton}"
                                Padding="14,0" Click="OnTwitchLogin"/>
                        <Button Content="清除登录信息" IsEnabled="{Binding CanClearTwitchLogin}"
                                Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="8,0,0,0"
                                Click="OnTwitchLogout"/>
                        <Button Content="重新检测" Visibility="{Binding TwitchRetryVisibility}"
                                Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="8,0,0,0"
                                Click="OnTwitchRetry"/>
                        <Button Content="开始 Twitch 掉宝" Tag="Twitch" Visibility="{Binding Twitch.StartVisibility}" Style="{StaticResource PrimaryButton}" Padding="14,0" Margin="18,0,0,0" Click="OnStart"/>
                        <Button Content="停止 Twitch 掉宝" Tag="Twitch" Visibility="{Binding Twitch.StopVisibility}" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="8,0,0,0" Click="OnStop"/>
                        <Button x:Name="TwitchRefreshButton" Content="{Binding TwitchRefreshButtonText}"
                                IsEnabled="{Binding CanRefreshTwitch}" Style="{StaticResource SecondaryButton}"
                                Padding="14,0" Margin="8,0,0,0" Click="OnTwitchReload"/>
                        <ProgressBar Width="72" Height="5" Margin="12,0,0,0" VerticalAlignment="Center"
                                     IsIndeterminate="True" Visibility="{Binding TwitchRefreshProgressVisibility}"
                                     Background="{DynamicResource App.SurfaceAlt}"
                                     Foreground="{DynamicResource Accent.Primary}"/>
                        <TextBlock Text="{Binding TwitchRefreshStatus}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Visibility="{Binding TwitchRefreshStatusVisibility}"/>
                    </WrapPanel>
                    <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="7" Padding="10,8"
                            Margin="0,12,0,0" Visibility="{Binding TwitchRetryStatusVisibility}">
                        <DockPanel LastChildFill="True">
                            <Button Content="立即重试" DockPanel.Dock="Right"
                                    Visibility="{Binding TwitchRetryNowVisibility}"
                                    Style="{StaticResource SecondaryButton}" Height="28" Padding="11,0"
                                    Click="OnTwitchRetryNow"/>
                            <TextBlock Text="{Binding TwitchRetryStatusText}"
                                       Foreground="{DynamicResource Status.Warning}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,0,10,0"/>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="{Binding TwitchLastSuccessText}"
                               Visibility="{Binding TwitchLastSuccessVisibility}"
                               Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,7,0,0"/>
                    <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Padding="14"
                            Margin="0,14,0,0" Visibility="{Binding TwitchAuthorizationVisibility}">
                        <StackPanel>
                            <TextBlock Text="Twitch 授权" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="请在 Twitch 官方页面完成授权。" Style="{StaticResource FieldHint}"/>
                            <TextBlock Text="授权码" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding TwitchAuthorizationCode}" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent.Primary}" Margin="0,4,0,0"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="打开 Twitch 授权页面" Style="{StaticResource PrimaryButton}"
                                        Padding="14,0" Click="OnOpenTwitchAuthorization"/>
                                <Button Content="复制授权码" Style="{StaticResource SecondaryButton}"
                                        Padding="14,0" Margin="8,0,0,0" Click="OnCopyTwitchAuthorizationCode"/>
                                <TextBlock Text="正在等待授权……" Foreground="{DynamicResource Text.Secondary}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <CheckBox x:Name="TwitchAutoStart" Style="{StaticResource ThemeCheckBox}"
                              Content="启动 CloudLight Blizzard 时自动运行 Twitch"
                              Margin="0,14,0,0" Click="OnAutoStartChanged"/>
                </StackPanel></Border>

                <StackPanel Margin="0,14,0,0">
                    <Border Style="{StaticResource SurfaceCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="掉宝进度与奖励" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="打开背包" Style="{StaticResource SecondaryButton}"
                                        Padding="12,0" Click="OnOpenTwitchInventory"/>
                            </Grid>
                            <Grid Margin="0,10,0,0" MinHeight="145">
                                <ListBox ItemsSource="{Binding Inventory}" ItemTemplate="{StaticResource TwitchDropRowTemplate}"
                                         MaxHeight="300" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                <TextBlock Text="{Binding TwitchInventoryEmptyText}" Foreground="{DynamicResource Text.Muted}"
                                           TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="12" IsHitTestVisible="False">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Inventory.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="当前频道与可用频道" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,10,0,10" MinHeight="145">
                                <ListBox x:Name="TwitchChannelsList" ItemsSource="{Binding Channels}"
                                         ItemTemplate="{StaticResource DropsRowTemplate}" MaxHeight="250"/>
                                <TextBlock Text="{Binding TwitchChannelsEmptyText}" Foreground="{DynamicResource Text.Muted}"
                                           TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="12" IsHitTestVisible="False">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Channels.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Content="选择并切换频道" Style="{StaticResource SecondaryButton}"
                                    Padding="12,0" HorizontalAlignment="Left" Click="OnTwitchSelectChannel"/>
                        </StackPanel>
                </Border>
            </StackPanel>
            </StackPanel>

            <StackPanel x:Name="BilibiliPanel" Visibility="{Binding BilibiliPanelVisibility}">
                <Border x:Name="BilibiliAccountCard" Style="{StaticResource SurfaceCard}" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="166"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="哔哩哔哩" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="官方扫码登录；请求由独立 Worker 按当前网络策略完成。" Style="{StaticResource FieldHint}"/>
                            <TextBlock Text="{Binding BilibiliDetails.LoginStateText}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding BilibiliDetails.AccountStatus}" Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding BilibiliDetails.NetworkModeText}" Foreground="{DynamicResource Status.Success}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding BilibiliDetails.NetworkPolicyText}" Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock Text="运行状态：" Foreground="{DynamicResource Text.Secondary}"/>
                                <TextBlock Text="{Binding Bilibili.Status}" FontWeight="SemiBold" Margin="2,0,10,0"/>
                                <TextBlock Text="{Binding Bilibili.ConnectionStateText}" Foreground="{DynamicResource Accent.Primary}"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,9,0,0">
                                <Button x:Name="BilibiliQrLoginButton" Content="扫码登录" Visibility="{Binding BilibiliDetails.LoginVisibility}" Style="{StaticResource PrimaryButton}" Padding="11,0"
                                        Command="{Binding BilibiliDetails.ScanQrLoginCommand}"/>
                                <Button Content="退出登录" Visibility="{Binding BilibiliDetails.LogoutVisibility}" Style="{StaticResource DangerButton}" Padding="11,0" Margin="6,0,0,0"
                                        Command="{Binding BilibiliDetails.LogoutCommand}"/>
                                <Button x:Name="BilibiliStartButton" Content="开始掉宝" Visibility="{Binding Bilibili.StartVisibility}" Style="{StaticResource PrimaryButton}" Padding="11,0" Margin="12,0,0,0"
                                        Command="{Binding BilibiliDetails.StartCommand}"/>
                                <Button x:Name="BilibiliStopButton" Content="停止掉宝" Visibility="{Binding Bilibili.StopVisibility}" Style="{StaticResource SecondaryButton}" Padding="11,0" Margin="6,0,0,0"
                                        Command="{Binding BilibiliDetails.StopCommand}"/>
                                <Button x:Name="BilibiliRefreshButton" Content="刷新进度" Style="{StaticResource SecondaryButton}" Padding="11,0" Margin="6,0,0,0"
                                        Command="{Binding BilibiliDetails.RefreshCommand}"/>
                                <Button x:Name="BilibiliDiscoverButton" Content="发现活动" Style="{StaticResource SecondaryButton}" Padding="11,0" Margin="6,0,0,0"
                                        Command="{Binding BilibiliDetails.DiscoverCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding BilibiliDetails.QrStateText}" Foreground="{DynamicResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,6,0,0">
                                <Button x:Name="BilibiliQrCancelButton" Content="取消扫码" Visibility="{Binding BilibiliDetails.QrCancelVisibility}" Style="{StaticResource SecondaryButton}" Padding="11,0"
                                        Command="{Binding BilibiliDetails.CancelQrCommand}"/>
                                <Button Content="重新获取二维码" Visibility="{Binding BilibiliDetails.QrRetryVisibility}" Style="{StaticResource SecondaryButton}" Padding="11,0" Margin="6,0,0,0"
                                        Command="{Binding BilibiliDetails.ReacquireQrCommand}"/>
                                <TextBlock Text="登录成功后自动保存账号与凭据。" Foreground="{DynamicResource Text.Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </WrapPanel>
                        </StackPanel>
                        <Border x:Name="BilibiliQrCard" Grid.Column="1" Background="{DynamicResource App.SurfaceAlt}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="14,0,0,0"
                                Visibility="{Binding BilibiliDetails.QrAreaVisibility}">
                            <Image Source="{Binding BilibiliDetails.QrImagePath}" Visibility="{Binding BilibiliDetails.QrImageVisibility}" Width="150" Height="150" Stretch="Uniform"/>
                        </Border>
                    </Grid>
                </Border>

                <Expander x:Name="BilibiliQuickStartCard" Header="{Binding BilibiliQuickStart.Summary}" IsExpanded="{Binding BilibiliQuickStart.IsExpanded, Mode=TwoWay}"
                          Foreground="{DynamicResource Text.Primary}" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}"
                          BorderThickness="1" Padding="12,8" Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding BilibiliQuickStart.Steps}" ItemTemplate="{StaticResource QuickStartStepTemplate}"
                                  Margin="8,2,0,0"/>
                </Expander>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SurfaceCard}" Padding="14" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="高级登录（可选）" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="故障排查或无法扫码时使用；Cookie 仅在受控 Worker 内加密保存。" Style="{StaticResource FieldHint}"/>
                            <TextBlock Text="手动导入 Cookie" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/>
                            <PasswordBox x:Name="BilibiliCookieBox"/>
                            <Button Content="导入并验证 Cookie" Style="{StaticResource SecondaryButton}" Padding="11,0" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Command="{Binding BilibiliDetails.ManualCookieCommand}"/>
                            <TextBlock Text="不写入 settings.json，不出现在命令行、日志或诊断包中。" Style="{StaticResource FieldHint}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="14" Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="活动与直播间" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="自动发现活动；也可手动指定 URL 或房间号。" Style="{StaticResource FieldHint}"/>
                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="BilibiliRoomInput" Style="{StaticResource HintTextBox}" Tag="直播间 URL 或 Room ID"
                                         Text="{Binding BilibiliDetails.RoomReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="添加" Style="{StaticResource SecondaryButton}" Padding="11,0" Margin="6,0,0,0"
                                        Command="{Binding BilibiliDetails.AddRoomCommand}"/>
                            </Grid>
                            <TextBox x:Name="BilibiliRoomNameInput" Style="{StaticResource HintTextBox}" Tag="直播间名称（可选）" Margin="0,6,0,0"
                                     Text="{Binding BilibiliDetails.RoomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <ListBox x:Name="BilibiliRoomList" ItemsSource="{Binding BilibiliDetails.Rooms}" ItemTemplate="{StaticResource BilibiliRoomRowTemplate}" MinHeight="58" MaxHeight="170" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding BilibiliDetails.Activities.Count, StringFormat=已发现活动：{0} 个}" Foreground="{DynamicResource Text.Secondary}" Margin="0,8,0,0"/>
                            <ListBox x:Name="BilibiliActivityList" ItemsSource="{Binding BilibiliDetails.Activities}" ItemTemplate="{StaticResource BilibiliActivityRowTemplate}" MinHeight="42" MaxHeight="120" Margin="0,4,0,0">
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="BilibiliSettingsCard" Style="{StaticResource SurfaceCard}" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="观看模式与任务设置" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="多线程模式控制每个直播间的 Session 数；每个 Session 独立连接并错峰启动。" Style="{StaticResource FieldHint}"/>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0"><TextBlock Text="观看模式" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="BilibiliWatchModePicker" Style="{StaticResource ThemeComboBox}" SelectedValue="{Binding BilibiliDetails.WatchMode, Mode=TwoWay}" SelectedValuePath="Tag"><ComboBoxItem Content="标准模式（每房间 1 Session）" Tag="standard"/><ComboBoxItem Content="多线程加速模式" Tag="multi"/></ComboBox></StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="每房间并发 Session" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BilibiliSessionsPerRoomText" Style="{StaticResource HintTextBox}" Tag="1" Text="{Binding BilibiliDetails.SessionsPerRoomText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="错峰重连延迟" Style="{StaticResource FieldLabel}"/><DockPanel><TextBlock Text="秒" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="BilibiliReconnectDelayText" Style="{StaticResource HintTextBox}" Tag="8" Text="{Binding BilibiliDetails.ReconnectDelayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DockPanel></StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding BilibiliDetails.SessionEstimateText}" Foreground="{DynamicResource Accent.Primary}" Margin="0,10,0,0"/>
                        <Border x:Name="BilibiliNetworkCard" Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="前往网络设置" Style="{StaticResource SecondaryButton}" Padding="11,0"
                                            Margin="12,0,0,0" Click="OnOpenProxySettings"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="网络" Style="{StaticResource SectionTitle}"/>
                                        <CheckBox x:Name="BilibiliUseProxyCheck" Style="{StaticResource ThemeCheckBox}"
                                                  Content="使用 CloudLight Blizzard 全局代理" Margin="12,0,0,0"
                                                  IsChecked="{Binding BilibiliDetails.BilibiliUseProxy, Mode=TwoWay}"/>
                                    </StackPanel>
                                </DockPanel>
                                <WrapPanel Margin="0,5,0,0">
                                    <TextBlock Text="{Binding BilibiliDetails.NetworkModeText}" Foreground="{DynamicResource Text.Secondary}"
                                               FontSize="11" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding BilibiliDetails.NetworkPolicyText}" Foreground="{DynamicResource Text.Muted}"
                                               FontSize="11" TextWrapping="Wrap"/>
                                </WrapPanel>
                                <TextBlock Text="全局代理尚未启用/配置，哔哩哔哩当前使用直连。"
                                           Foreground="{DynamicResource Status.Warning}" FontSize="11" Margin="0,4,0,0"
                                           Visibility="{Binding BilibiliDetails.ProxyConfigurationWarningVisibility}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0"><TextBlock Text="官方任务查询间隔" Style="{StaticResource FieldLabel}"/><DockPanel><TextBlock Text="秒（至少 10）" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="BilibiliTaskIntervalText" Style="{StaticResource HintTextBox}" Tag="30" Text="{Binding BilibiliDetails.TaskIntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DockPanel></StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="高级 Task IDs（可选）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BilibiliTaskIdsText" Style="{StaticResource HintTextBox}" Tag="多个 ID 用逗号或空格分隔" Text="{Binding BilibiliDetails.TaskIdsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                            <StackPanel>
                        <WrapPanel>
                            <CheckBox x:Name="BilibiliEnabledCheck" Style="{StaticResource ThemeCheckBox}" Content="启用哔哩哔哩" Margin="0,0,18,0" IsChecked="{Binding BilibiliDetails.Enabled, Mode=TwoWay}"/>
                            <CheckBox x:Name="BilibiliAutoTaskProgress" Style="{StaticResource ThemeCheckBox}" Content="自动查询任务进度" Margin="0,0,18,0" IsChecked="{Binding BilibiliDetails.AutoTaskProgress, Mode=TwoWay}"/>
                            <CheckBox x:Name="BilibiliAutoDiscoverCheck" Style="{StaticResource ThemeCheckBox}" Content="自动发现当前活动" Margin="0,0,18,0" IsChecked="{Binding BilibiliDetails.AutoDiscover, Mode=TwoWay}"/>
                            <CheckBox x:Name="BilibiliAutoClaimCheck" Style="{StaticResource ThemeCheckBox}" Content="自动领取奖励" Margin="0,0,18,0" IsChecked="{Binding BilibiliDetails.AutoClaim, Mode=TwoWay}"/>
                            <CheckBox x:Name="BilibiliTaskNotificationsCheck" Style="{StaticResource ThemeCheckBox}" Content="任务完成通知" Margin="0,0,18,0" IsChecked="{Binding BilibiliDetails.TaskNotifications, Mode=TwoWay}"/>
                            <CheckBox x:Name="BilibiliReconnectCheck" Style="{StaticResource ThemeCheckBox}" Content="断线自动重连" IsChecked="{Binding BilibiliDetails.ReconnectEnabled, Mode=TwoWay}"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox x:Name="BilibiliAutoStart" Style="{StaticResource ThemeCheckBox}" Content="启动 CloudLight Blizzard 时自动恢复 Worker" Margin="0,0,18,0" IsChecked="{Binding BilibiliDetails.AutoRestore, Mode=TwoWay}" Click="OnAutoStartChanged"/>
                            <CheckBox x:Name="BilibiliAutoResume" Style="{StaticResource ThemeCheckBox}" Content="上次正在掉宝时自动恢复掉宝" IsChecked="{Binding BilibiliDetails.AutoResume, Mode=TwoWay}" Click="OnAutoStartChanged"/>
                        </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding BilibiliDetails.ProxyConfigurationText}" Foreground="{DynamicResource Status.Success}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Gotify / Server 酱 URL（可选，保存后加密）" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/>
                        <PasswordBox x:Name="BilibiliNotifierUrlBox"/>
                        <TextBlock Text="{Binding BilibiliDetails.NotifierText}" Style="{StaticResource FieldHint}"/>
                        <WrapPanel Margin="0,10,0,0"><Button Content="保存设置" Style="{StaticResource PrimaryButton}" Padding="12,0" Command="{Binding BilibiliDetails.SaveSettingsCommand}"/><Button Content="清除第三方通知" Style="{StaticResource SecondaryButton}" Padding="11,0" Margin="6,0,0,0" Command="{Binding BilibiliDetails.ClearNotifierCommand}"/><Button Content="刷新 Session 详情" Style="{StaticResource SecondaryButton}" Padding="11,0" Margin="6,0,0,0" Command="{Binding BilibiliDetails.RefreshSessionsCommand}"/></WrapPanel>
                    </StackPanel>
                </Border>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SurfaceCard}" Padding="14" Margin="0,0,5,0">
                        <StackPanel>
                            <DockPanel><TextBlock Text="官方任务进度" Style="{StaticResource SectionTitle}"/><TextBlock DockPanel.Dock="Right" Text="{Binding BilibiliDetails.SessionSummary}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/></DockPanel>
                            <TextBlock Text="{Binding BilibiliDetails.LastApiSuccessAt, StringFormat=最近成功 API：{0}}" Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,4,0,0"/>
                            <ListBox x:Name="BilibiliTaskList" ItemsSource="{Binding BilibiliDetails.Tasks}" ItemTemplate="{StaticResource BilibiliTaskRowTemplate}" MinHeight="80" MaxHeight="300" Margin="0,8,0,0"/>
                            <TextBlock Text="尚未读取到官方任务进度。请先发现活动或填写 Task IDs。" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" Margin="8,10" TextWrapping="Wrap">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding BilibiliDetails.Tasks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="奖励领取记录" Style="{StaticResource SectionTitle}" Margin="0,10,0,0"/>
                            <ListBox ItemsSource="{Binding BilibiliDetails.Rewards}" MinHeight="34" MaxHeight="130" Margin="0,4,0,0"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,4"><DockPanel><TextBlock Text="{Binding TaskName}" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{DynamicResource Accent.Primary}"/></DockPanel><TextBlock Text="{Binding Reward}" Foreground="{DynamicResource Text.Secondary}" FontSize="11" Margin="0,2,0,0"/><TextBlock Text="{Binding Message}" Foreground="{DynamicResource Text.Muted}" FontSize="10.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="14" Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="会话状态" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="按聚合状态查看每个独立运行的 Session。" Style="{StaticResource FieldHint}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="目标" Foreground="{DynamicResource Text.Muted}" FontSize="11"/><TextBlock Text="{Binding BilibiliDetails.ConfiguredSessions}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="活动" Foreground="{DynamicResource Text.Muted}" FontSize="11"/><TextBlock Text="{Binding BilibiliDetails.ActiveSessions}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Status.Success}"/></StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0"><TextBlock Text="连接中" Foreground="{DynamicResource Text.Muted}" FontSize="11"/><TextBlock Text="{Binding BilibiliDetails.ConnectingSessions}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Accent.Primary}"/></StackPanel>
                                <StackPanel Grid.Column="3" Margin="6,0,0,0"><TextBlock Text="重连中" Foreground="{DynamicResource Text.Muted}" FontSize="11"/><TextBlock Text="{Binding BilibiliDetails.RetryingSessions}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Status.Warning}"/></StackPanel>
                                <StackPanel Grid.Column="4" Margin="6,0,0,0"><TextBlock Text="失败" Foreground="{DynamicResource Text.Muted}" FontSize="11"/><TextBlock Text="{Binding BilibiliDetails.FailedSessions}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Status.Error}"/></StackPanel>
                            </Grid>
                            <ListBox x:Name="BilibiliSessionList" ItemsSource="{Binding BilibiliDetails.Sessions}" ItemTemplate="{StaticResource BilibiliSessionRowTemplate}" MinHeight="80" MaxHeight="320" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <Border Style="{StaticResource SurfaceCard}" Margin="0,14,0,0" Visibility="{Binding TwitchPanelVisibility}">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="显示范围：" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="TwitchCampaignScopePicker" Width="150"
                                          Style="{StaticResource ThemeComboBox}" SelectionChanged="OnTwitchCampaignScopeChanged">
                                    <ComboBoxItem Content="当前可掉宝" Tag="available"/>
                                    <ComboBoxItem Content="仅优先游戏" Tag="priority"/>
                                    <ComboBoxItem Content="全部活动" Tag="all"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="掉宝活动" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                            <Grid Margin="12,0,18,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" MinWidth="100"/>
                                    <ColumnDefinition Width="1.8*" MinWidth="150"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="游戏" Foreground="{DynamicResource Text.Muted}" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="活动或奖励名称" Margin="14,0,0,0" Foreground="{DynamicResource Text.Muted}" FontSize="11"/>
                                <TextBlock Grid.Column="2" Text="状态" Margin="14,0,0,0" Foreground="{DynamicResource Text.Muted}" FontSize="11"/>
                                <TextBlock Grid.Column="3" Text="进度 / 剩余" Foreground="{DynamicResource Text.Muted}" FontSize="11"/>
                            </Grid>
                            <Grid Grid.Row="1" MinHeight="145">
                                <ListBox ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TwitchCampaignRowTemplate}"
                                         MaxHeight="320" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                <TextBlock Text="{Binding TwitchCampaignsEmptyText}" Foreground="{DynamicResource Text.Muted}"
                                           TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="12" IsHitTestVisible="False">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tasks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="TwitchSettingsCard" Style="{StaticResource SurfaceCard}" Margin="0,14,0,0" Visibility="{Binding TwitchPanelVisibility}"><StackPanel>
                    <TextBlock Text="Twitch 设置" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="不确定如何设置时保持默认即可。优先游戏会影响程序选择掉宝活动和频道的顺序。" Style="{StaticResource FieldHint}"/>
                    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="界面语言" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="TwitchLanguage" Style="{StaticResource ThemeComboBox}" DisplayMemberPath="Content" SelectedValuePath="Tag"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="掉宝优先策略" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="TwitchPriorityMode" Style="{StaticResource ThemeComboBox}"><ComboBoxItem Content="仅挂机优先游戏" Tag="PRIORITY_ONLY"/><ComboBoxItem Content="最早结束的活动优先" Tag="ENDING_SOONEST"/><ComboBoxItem Content="剩余可用时间最少优先" Tag="LOW_AVBL_FIRST"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="连接质量" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="TwitchConnectionQuality" Style="{StaticResource ThemeComboBox}"><ComboBoxItem Content="等级 1" Tag="1"/><ComboBoxItem Content="等级 2" Tag="2"/><ComboBoxItem Content="等级 3" Tag="3"/><ComboBoxItem Content="等级 4" Tag="4"/><ComboBoxItem Content="等级 5" Tag="5"/><ComboBoxItem Content="等级 6" Tag="6"/></ComboBox></StackPanel>
                    </Grid>
                    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="优先游戏" Style="{StaticResource FieldLabel}"/><DockPanel><Button Content="添加" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="12,0" Margin="8,0,0,0" Click="OnAddPriorityGame"/><ComboBox x:Name="TwitchPriorityPicker" Style="{StaticResource SearchComboBox}" ItemsSource="{Binding TwitchPriorityChoices}"/></DockPanel><ListBox x:Name="TwitchPriorityList" ItemsSource="{Binding TwitchPriorityGames}" MinHeight="96" MaxHeight="190" Margin="0,8,0,0"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="6,4"><WrapPanel DockPanel.Dock="Right"><Button Content="↑" ToolTip="上移" Tag="{Binding}" Style="{StaticResource SecondaryButton}" Width="28" Height="26" Padding="0" Click="OnPriorityUp"/><Button Content="↓" ToolTip="下移" Tag="{Binding}" Style="{StaticResource SecondaryButton}" Width="28" Height="26" Padding="0" Margin="4,0,0,0" Click="OnPriorityDown"/><Button Content="移除" Tag="{Binding}" Style="{StaticResource DangerButton}" Height="26" Padding="8,0" Margin="4,0,0,0" Click="OnRemovePriorityGame"/></WrapPanel><TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="排除游戏" Style="{StaticResource FieldLabel}"/><DockPanel><Button Content="添加" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="12,0" Margin="8,0,0,0" Click="OnAddExcludedGame"/><ComboBox x:Name="TwitchExcludePicker" Style="{StaticResource SearchComboBox}" ItemsSource="{Binding TwitchExcludeChoices}"/></DockPanel><ListBox x:Name="TwitchExcludeList" ItemsSource="{Binding TwitchExcludedGames}" MinHeight="96" MaxHeight="190" Margin="0,8,0,0"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="6,4"><Button Content="移除" Tag="{Binding}" DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Height="26" Padding="8,0" Click="OnRemoveExcludedGame"/><TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
                    </Grid>
                    <TextBlock x:Name="TwitchGamesEmptyHint" Text="登录 Twitch 并刷新掉宝活动后即可选择游戏。" Style="{StaticResource FieldHint}" Visibility="Collapsed"/>
                    <WrapPanel Margin="0,14,0,0"><CheckBox x:Name="TwitchTrayNotifications" Style="{StaticResource ThemeCheckBox}" Content="托盘通知" Margin="0,0,18,0"/><CheckBox x:Name="TwitchBadgesEmotes" Style="{StaticResource ThemeCheckBox}" Content="显示徽章和表情" Margin="0,0,18,0"/><CheckBox x:Name="TwitchAvailableDrops" Style="{StaticResource ThemeCheckBox}" Content="检查可用掉宝" Margin="0,0,18,0"/><CheckBox x:Name="TwitchAutoClaim" Style="{StaticResource ThemeCheckBox}" Content="自动领取掉宝"/></WrapPanel>
                    <Button Content="保存设置" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="14,0" Margin="0,14,0,0" Click="OnSaveTwitch"/>
                </StackPanel></Border>

            <Border Style="{StaticResource SurfaceCard}" Margin="0,14,0,0">
                <StackPanel><DockPanel><TextBlock Text="运行日志" Style="{StaticResource SectionTitle}"/><WrapPanel DockPanel.Dock="Right"><Button Content="复制全部" Style="{StaticResource SecondaryButton}" Padding="12,0" Click="OnCopyAllLogs"/><Button Content="清空显示" Style="{StaticResource SecondaryButton}" Padding="12,0" Margin="8,0,0,0" Click="OnClearLogDisplay"/></WrapPanel></DockPanel>
                    <Grid Margin="0,10,0,0" MinHeight="86">
                        <TextBox x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="{DynamicResource App.SurfaceAlt}" Foreground="{DynamicResource Text.Primary}"
                                 CaretBrush="{DynamicResource Text.Primary}" BorderBrush="{DynamicResource App.Border}"
                                 BorderThickness="1" FontFamily="Consolas" FontSize="11" Height="220" Padding="8"
                                 TextChanged="OnLogTextChanged">
                            <TextBox.ContextMenu><ContextMenu><MenuItem Header="复制" Command="Copy" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/><MenuItem Header="全选" Command="SelectAll" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/></ContextMenu></TextBox.ContextMenu>
                        </TextBox>
                        <TextBlock x:Name="LogEmptyHint" Text="暂无日志。" Foreground="{DynamicResource Text.Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
