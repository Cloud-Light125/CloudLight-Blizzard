<UserControl x:Class="CloudLightBlizzard.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls"
             Foreground="{DynamicResource Text.Primary}" Background="{DynamicResource App.Background}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24,22,30">
        <ctrl:PageHeader Title="关于" Description="CloudLight Blizzard 的版本与运行信息。"/>
        <Border Style="{StaticResource SurfaceCard}" Margin="0,18,0,0"><StackPanel>
            <TextBlock Text="CloudLight Blizzard" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding AppVersion}" Foreground="{DynamicResource Accent.Primary}" Margin="0,8,0,0"/>
            <TextBlock Text="国服 / 国际服切换、Drops、公告与在线更新工具。" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,14,0,0"/>
            <TextBlock Text="本版本为 2.1.0。" Foreground="{DynamicResource Text.Muted}" Margin="0,10,0,0"/>
        </StackPanel></Border>
        <Border Style="{StaticResource SurfaceCard}" Margin="0,14,0,0"><StackPanel>
            <TextBlock Text="开源组件 / Third-party licenses" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="BiliBiliDropsMiner" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <TextBlock Text="Source: https://github.com/mi0e/BiliBiliDropsMiner" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="License: MIT · Integrated upstream commit: a0d8bd51728aabaef66c651613324adba15d9ce8" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <Button Content="打开上游项目" Style="{StaticResource SecondaryButton}" Padding="12,0" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnOpenBilibiliSource"/>
            <TextBlock Text="完整第三方声明与许可证随安装包提供于 THIRD_PARTY_NOTICES.md / THIRD_PARTY_LICENSES。" Style="{StaticResource FieldHint}"/>
        </StackPanel></Border>
    </StackPanel></ScrollViewer>
</UserControl>
