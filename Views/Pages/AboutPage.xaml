<UserControl xmlns:behaviors="clr-namespace:CloudLightBlizzard.Behaviors" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CloudLightBlizzard.Views.Pages.AboutPage" x:Name="AboutRoot" Foreground="{DynamicResource Text.Primary}" Background="{DynamicResource App.Background}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="AboutLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="AboutValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,22,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ctrl:PageHeader Title="关于" Description="CloudLight Blizzard 的版本与运行信息。" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,12,4,16">
                <Border Style="{DynamicResource HeroCard}" Margin="0,8,0,18" Background="{DynamicResource AccSoft}">
                    <StackPanel>
                        <Image Source="pack://application:,,,/Assets/app.png" Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,18" />
                        <TextBlock Text="CloudLight Blizzard" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AppVersion}" Foreground="{DynamicResource Accent.Primary}" Margin="0,8,0,0" />
                        <TextBlock Text="国服 / 国际服切换、Drops、公告与在线更新工具。" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,14,0,0" />
                        <TextBlock Text="第三方组件和许可证随当前产品分发内容一并整理如下。" Foreground="{DynamicResource Text.Muted}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Expander Header="开源组件与许可证" IsExpanded="True" Margin="0,16,0,0">
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,14,0,0">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="12,0,0,0">
                                    <TextBlock Text="随产品分发" Foreground="{DynamicResource Accent.Primary}" FontSize="13" />
                                </Border>
                                <TextBlock Text="开源组件 / Third-party licenses" Style="{StaticResource SectionTitle}" />
                            </DockPanel>
                            <TextBlock Text="仅列出已在 Worker、NuGet 发布内容或项目第三方声明中确认的组件。" Style="{StaticResource FieldHint}" Margin="0,5,0,0" />
                            <ItemsControl x:Name="ThirdPartyComponentsList" ItemsSource="{Binding Components, ElementName=AboutRoot}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource App.SurfaceAlt}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <DockPanel LastChildFill="True">
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding License}" Foreground="{DynamicResource Accent.Primary}" FontSize="13" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Purpose}" Foreground="{DynamicResource Text.Secondary}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="88" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Source URL" Style="{StaticResource AboutLabel}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding SourceUrl}" Style="{StaticResource AboutValue}" ToolTip="{Binding SourceUrl}" />
                                                </Grid>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="88" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="版本 / 集成" Style="{StaticResource AboutLabel}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding VersionInfo}" Style="{StaticResource AboutValue}" />
                                                </Grid>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="88" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="分发信息" Style="{StaticResource AboutLabel}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DistributionInfo}" Style="{StaticResource AboutValue}" />
                                                </Grid>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="88" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="本地文件" Style="{StaticResource AboutLabel}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding LicenseLocation}" Style="{StaticResource AboutValue}" />
                                                        <TextBlock Text="{Binding NoticeLocation}" Style="{StaticResource AboutValue}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                                <WrapPanel Margin="88,10,0,0">
                                                    <Button Content="打开上游项目" Tag="{Binding SourceOpenUrl}" Visibility="{Binding HasSourceOpenUrl, Converter={StaticResource BoolVisibility}}" Style="{StaticResource SecondaryButton}" Padding="11,0" Click="OnOpenSource" />
                                                    <Button Content="打开许可证" Tag="{Binding LicenseOpenPath}" Visibility="{Binding HasLicenseOpenPath, Converter={StaticResource BoolVisibility}}" Style="{StaticResource SecondaryButton}" Padding="11,0" Margin="8,0,0,0" Click="OnOpenLocalPath" />
                                                    <Button Content="打开第三方说明" Tag="{Binding NoticeOpenPath}" Visibility="{Binding HasNoticeOpenPath, Converter={StaticResource BoolVisibility}}" Style="{StaticResource SecondaryButton}" Padding="11,0" Margin="8,0,0,0" Click="OnOpenLocalPath" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
