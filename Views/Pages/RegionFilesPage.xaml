<UserControl x:Class="CloudLightBlizzard.Views.Pages.RegionFilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:CloudLightBlizzard.Behaviors"
             behaviors:NestedScrollBehavior.IsEnabled="True"
             Foreground="{DynamicResource Text.Primary}" Background="{DynamicResource App.Background}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <DataTemplate x:Key="PreparationWarningCard">
            <Border Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnBd}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding PreparationWarningTitle}" Foreground="{DynamicResource WarnTx}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PreparationWarningText}" Foreground="{DynamicResource WarnTx}"
                               TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,22,28">
            <TextBlock Text="区服文件" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="使用本地备份快速切换守望先锋国服和国际服，减少 Battle.net 重复下载。" Style="{StaticResource PageDescription}"/>

            <TextBlock Text="当前状态" Style="{StaticResource SectionTitle}" Margin="0,26,0,12"/>
            <Border Style="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="当前文件" Foreground="{DynamicResource Text.Secondary}"/>
                        <TextBlock Text="国服备份" Foreground="{DynamicResource Text.Secondary}" Margin="0,10,0,0"/>
                        <TextBlock Text="国际服备份" Foreground="{DynamicResource Text.Secondary}" Margin="0,10,0,0"/>
                        <TextBlock Text="备份状态" Foreground="{DynamicResource Text.Secondary}" Margin="0,10,0,0"/>
                        <TextBlock Text="备份模式" Foreground="{DynamicResource Text.Secondary}" Margin="0,10,0,0"/>
                        <TextBlock Text="备份大小" Foreground="{DynamicResource Text.Secondary}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding RegionGuide.CurrentFileText}"/>
                        <TextBlock Text="{Binding RegionGuide.ChinaBackupText}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding RegionGuide.InternationalBackupText}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding RegionGuide.BackupStateText}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding RegionGuide.BackupModeText}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding RegionGuide.BackupSizeText}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="24,0,0,0"
                                Visibility="{Binding RegionGuide.ShowTopRegionActions, Converter={StaticResource BoolVisibility}}">
                        <Button Content="{Binding RegionGuide.SwitchChinaText}" IsEnabled="{Binding RegionGuide.CanSwitchChina}"
                                Style="{StaticResource PrimaryButton}" Padding="18,0" Margin="0,0,0,8" Click="OnSwitchChina"/>
                        <Button Content="{Binding RegionGuide.SwitchInternationalText}" IsEnabled="{Binding RegionGuide.CanSwitchInternational}"
                                Style="{StaticResource PrimaryButton}" Padding="18,0" Click="OnSwitchInternational"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SurfaceCard}" Margin="0,18,0,0"
                    Visibility="{Binding RegionGuide.ShowTopRegionActions, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <TextBlock Text="区服文件状态" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="检查当前游戏目录与已保存区服状态的差异。可以发现区服永久文件是否缺失、内容是否变化，以及游戏运行后新增的临时/额外文件。该功能只检查，不会自动修改或删除任何文件，可在游戏运行并退出后重复检查。"
                               TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" LineHeight="20" Margin="0,8,0,12"/>
                    <Button Content="检查当前区服文件状态" IsEnabled="{Binding CanCheckRegionFiles}"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="16,0"
                            Click="OnCheckCurrentFiles"/>
                    <Border Background="{DynamicResource Body}" BorderBrush="{DynamicResource Bd}" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,13,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding RegionFileCheckSummary}" TextWrapping="Wrap" LineHeight="21"/>
                            <Expander Header="查看详情" Margin="0,10,0,0"
                                      Visibility="{Binding HasRegionFileCheck, Converter={StaticResource BoolVisibility}}">
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding RegionFileCheckDetails}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Text.Secondary}" FontSize="12" LineHeight="18"/>
                                </ScrollViewer>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="清除临时文件" IsEnabled="{Binding CanClearTemporaryFiles}"
                                Style="{StaticResource DangerButton}" Padding="15,0" Margin="0,0,8,0" Click="OnClearTemporary"/>
                        <Button Content="重设当前区服状态" IsEnabled="{Binding CanResetCurrentRegion}"
                                Style="{StaticResource SecondaryButton}" Padding="15,0" Click="OnResetCurrentRegion"/>
                    </WrapPanel>
                    <TextBlock Text="清除按钮只处理本次检查中明确标记的临时/额外文件候选；请先检查。任何切服、账号切换、验证或软件启动都不会自动删除文件。"
                               TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" FontSize="12" LineHeight="18" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SurfaceCard}" Margin="0,18,0,0"
                    Visibility="{Binding ShowStep4Card, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <TextBlock Text="可选：进一步验证区服文件" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="当前智能差异备份已经可正常使用。你还可以在切换到另一地区后执行一次第四步验证，进一步确认稳定差异并排除少量动态文件。第四步不是准备完成的必需条件，失败也不会影响当前备份。"
                               TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" LineHeight="20" Margin="0,8,0,4"/>
                    <TextBlock Text="{Binding Step4RegionText, StringFormat=需要在当前文件为 {0} 时执行。}"
                               Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,12"/>
                    <WrapPanel>
                        <Button Content="执行第四步验证" IsEnabled="{Binding CanRunStep4}" Style="{StaticResource PrimaryButton}"
                                Padding="16,0" Margin="0,0,8,0" Click="OnStep4"/>
                        <Button Content="恢复第四步提醒" IsEnabled="{Binding Step4ReminderIgnored}"
                                Style="{StaticResource SecondaryButton}" Padding="16,0" Click="OnRestoreStep4Reminder"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Text="游戏位置" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="守望先锋安装目录" Foreground="{DynamicResource Text.Muted}" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding RegionGuide.GamePathText}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,9,0,12"/>
                        <WrapPanel>
                            <Button Content="自动查找" IsEnabled="{Binding RegionGuide.CanChangePaths}" Style="{StaticResource SecondaryButton}" Padding="13,0" Margin="0,0,8,0" Click="OnDetectGame"/>
                            <Button Content="更改位置" IsEnabled="{Binding RegionGuide.CanChangePaths}" Style="{StaticResource SecondaryButton}" Padding="13,0" Click="OnChooseGame"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Text="区服备份位置" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding RegionGuide.BackupPathText}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,9,0,8"/>
                        <TextBlock Text="用于保存国服和国际服之间不同的文件，以及首次准备时需要的临时文件。建议选择空间充足的磁盘。"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" FontSize="12" LineHeight="18" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Content="更改位置" IsEnabled="{Binding RegionGuide.CanChangePaths}" Style="{StaticResource SecondaryButton}" Padding="13,0" Margin="0,0,8,0" Click="OnChooseStorage"/>
                            <Button Content="打开备份文件夹" Style="{StaticResource SecondaryButton}" Padding="13,0" Click="OnOpenStorage"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource SurfaceCard}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="区服文件准备" Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="备份模式" FontWeight="SemiBold" Margin="0,13,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource Body}" BorderBrush="{DynamicResource Bd}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <RadioButton x:Name="VerifiedModeRadio" GroupName="RegionBackupMode"
                                             IsEnabled="{Binding RegionGuide.CanChangePaths}"
                                             IsChecked="{Binding IsVerifiedDifferenceMode, Mode=OneWay}"
                                             Click="OnVerifiedMode" Content="智能差异备份（推荐）" FontWeight="SemiBold"/>
                                <TextBlock Text="仅保存经过国服 → 国际服 → 国服往返验证的真实区服差异文件。占用空间更小。准备期间必须保持游戏关闭，避免缓存、日志等运行时变化影响验证准确性。"
                                           TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" FontSize="12" LineHeight="18" Margin="22,7,0,0"/>
                                <TextBlock Text="需要依次记录当前区服、另一区服，再切回当前区服。"
                                           TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" FontSize="12" Margin="22,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource Body}" BorderBrush="{DynamicResource Bd}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <RadioButton x:Name="FullModeRadio" GroupName="RegionBackupMode"
                                             IsEnabled="{Binding RegionGuide.CanChangePaths}"
                                             IsChecked="{Binding IsFullSnapshotMode, Mode=OneWay}"
                                             Click="OnFullMode" Content="完整备份" FontWeight="SemiBold"/>
                                <TextBlock Text="保留当前完整区服快照方式。占用空间更大，但适合智能差异备份无法正常完成的特殊环境。"
                                           TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" FontSize="12" LineHeight="18" Margin="22,7,0,0"/>
                                <TextBlock Text="仅在智能差异备份无法正常完成时建议使用。"
                                           TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" FontSize="12" Margin="22,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="如果智能差异备份无法正常完成，可重新准备并改用完整备份模式。"
                               TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" FontSize="12" Margin="0,8,0,2"/>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding RegionGuide.ShowNotPrepared, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding RegionGuide.StepText}" Foreground="{DynamicResource Accent.Primary}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RegionGuide.Title}" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding RegionGuide.Description}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" LineHeight="21" Margin="0,9,0,14"/>
                        <ContentControl Content="{Binding RegionGuide}" ContentTemplate="{StaticResource PreparationWarningCard}"
                                        Visibility="{Binding RegionGuide.ShowPreparationWarning, Converter={StaticResource BoolVisibility}}"/>
                        <Border Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnBd}" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,12"
                                Visibility="{Binding RegionGuide.ShowGamePathRequired, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="请先在上方设置正确的守望先锋安装目录。" Foreground="{DynamicResource WarnTx}" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Text="当前电脑上的守望先锋是：" FontWeight="SemiBold" Margin="0,0,0,9"/>
                        <WrapPanel>
                            <Button Content="当前游戏是国服" IsEnabled="{Binding RegionGuide.CanChooseCurrentRegion}" Style="{StaticResource PrimaryButton}" Padding="17,0" Margin="0,0,9,0" Click="OnCaptureChina"/>
                            <Button Content="当前游戏是国际服" IsEnabled="{Binding RegionGuide.CanChooseCurrentRegion}" Style="{StaticResource PrimaryButton}" Padding="17,0" Click="OnCaptureInternational"/>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding RegionGuide.ShowWaiting, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding RegionGuide.FirstStepCompleteText}" Foreground="{DynamicResource Status.Success}" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <TextBlock Text="{Binding RegionGuide.StepText}" Foreground="{DynamicResource Accent.Primary}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RegionGuide.Title}" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding RegionGuide.PreparationRouteText}" Foreground="{DynamicResource Text.Muted}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding RegionGuide.Description}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" LineHeight="22" Margin="0,10,0,13"/>
                        <ContentControl Content="{Binding RegionGuide}" ContentTemplate="{StaticResource PreparationWarningCard}"
                                        Visibility="{Binding RegionGuide.ShowPreparationWarning, Converter={StaticResource BoolVisibility}}"/>
                        <WrapPanel>
                            <Button Content="{Binding RegionGuide.ContinueButtonText}" IsEnabled="{Binding RegionGuide.CanContinueOtherRegion}"
                                    Style="{StaticResource PrimaryButton}" Padding="18,0" Margin="0,0,8,8" Click="OnComplete"/>
                            <Button Content="重新执行步骤 1" IsEnabled="{Binding RegionGuide.CanRedoStep1}"
                                    Visibility="{Binding RegionGuide.CanRedoStep1, Converter={StaticResource BoolVisibility}}"
                                    Style="{StaticResource SecondaryButton}" Padding="15,0" Margin="0,0,8,8" Click="OnRedoStep1"/>
                            <Button Content="重新执行步骤 2" IsEnabled="{Binding RegionGuide.CanRedoStep2}"
                                    Visibility="{Binding RegionGuide.CanRedoStep2, Converter={StaticResource BoolVisibility}}"
                                    Style="{StaticResource SecondaryButton}" Padding="15,0" Margin="0,0,8,8" Click="OnRedoStep2"/>
                            <Button Content="返回步骤 1" IsEnabled="{Binding RegionGuide.CanReturnToStep1}"
                                    Visibility="{Binding RegionGuide.CanReturnToStep1, Converter={StaticResource BoolVisibility}}"
                                    Style="{StaticResource SecondaryButton}" Padding="15,0" Margin="0,0,8,8" Click="OnReturnStep1"/>
                            <Button Content="重新开始准备" IsEnabled="{Binding RegionGuide.CanRestart}"
                                    Style="{StaticResource SecondaryButton}" Padding="15,0" Margin="0,0,0,8" Click="OnReprepare"/>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding RegionGuide.ShowProgress, Converter={StaticResource BoolVisibility}}">
                        <StackPanel Visibility="{Binding RegionGuide.ShowCompletedPreparationSteps, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{Binding RegionGuide.FirstStepCompleteText}" Foreground="{DynamicResource Status.Success}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding RegionGuide.SecondStepCompleteText}" Foreground="{DynamicResource Status.Success}" FontWeight="SemiBold" Margin="0,5,0,8"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RegionGuide.StepText}" Foreground="{DynamicResource Accent.Primary}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RegionGuide.Title}" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding RegionGuide.Description}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" LineHeight="21" Margin="0,9,0,13"/>
                        <ContentControl Content="{Binding RegionGuide}" ContentTemplate="{StaticResource PreparationWarningCard}"
                                        Visibility="{Binding RegionGuide.ShowPreparationWarning, Converter={StaticResource BoolVisibility}}"/>
                        <TextBlock Text="{Binding RegionGuide.ProgressText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ProgressBar Style="{StaticResource ThemeProgressBar}" Height="9" Minimum="0"
                                     Maximum="{Binding RegionGuide.ProgressTotal}" Value="{Binding RegionGuide.ProgressCurrent}"
                                     IsIndeterminate="{Binding RegionGuide.ProgressIndeterminate}"/>
                        <Button Content="取消" IsEnabled="{Binding RegionGuide.CanCancel}"
                                Visibility="{Binding RegionGuide.CanCancel, Converter={StaticResource BoolVisibility}}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="15,0" Margin="0,13,0,0" Click="OnCancel"/>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding RegionGuide.ShowReady, Converter={StaticResource BoolVisibility}}">
                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                            <TextBlock Text="✓ 准备完成" Foreground="{DynamicResource Status.Success}" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding RegionGuide.Title}" FontSize="19" FontWeight="SemiBold" Margin="0,9,0,0"/>
                        <TextBlock Text="{Binding RegionGuide.Description}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" LineHeight="21" Margin="0,8,0,13"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="国服文件" Foreground="{DynamicResource Text.Secondary}"/><TextBlock Text="国际服文件" Foreground="{DynamicResource Text.Secondary}" Margin="0,7,0,0"/><TextBlock Text="区服差异" Foreground="{DynamicResource Text.Secondary}" Margin="0,7,0,0"/><TextBlock Text="本地备份" Foreground="{DynamicResource Text.Secondary}" Margin="0,7,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding RegionGuide.ChinaBackupText}"/><TextBlock Text="{Binding RegionGuide.InternationalBackupText}" Margin="0,7,0,0"/><TextBlock Text="{Binding RegionGuide.DifferenceText}" Margin="0,7,0,0"/><TextBlock Text="{Binding RegionGuide.BackupBytesText}" Margin="0,7,0,0"/></StackPanel>
                        </Grid>
                        <Expander Header="{Binding RegionGuide.WarningSummaryText}" Margin="0,0,0,14"
                                  Foreground="{DynamicResource Status.Warning}"
                                  Visibility="{Binding RegionGuide.ShowWarningDetails, Converter={StaticResource BoolVisibility}}">
                            <Border Background="{DynamicResource Body}" BorderBrush="{DynamicResource Bd}"
                                    BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,8,0,0">
                                <TextBlock Text="{Binding RegionGuide.WarningDetailsText}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Text.Secondary}" FontSize="12" LineHeight="18"/>
                            </Border>
                        </Expander>
                        <WrapPanel>
                            <Button Content="检查备份完整性" IsEnabled="{Binding RegionGuide.CanValidate}" Style="{StaticResource SecondaryButton}" Padding="15,0" Margin="0,0,8,0" Click="OnValidate"/>
                            <Button Content="重新准备区服文件" IsEnabled="{Binding RegionGuide.CanRestart}" Style="{StaticResource SecondaryButton}" Padding="15,0" Click="OnReprepare"/>
                        </WrapPanel>
                        <Expander Header="高级操作" Margin="0,14,0,0" Foreground="{DynamicResource Text.Secondary}">
                            <StackPanel Margin="0,10,0,0">
                                <Button Content="打开备份文件夹" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="14,0" Margin="0,0,0,9" Click="OnOpenStorage"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding RegionGuide.ShowOutdated, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding RegionGuide.StepText}" Foreground="{DynamicResource Status.Warning}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RegionGuide.Title}" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding RegionGuide.Description}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" LineHeight="21" Margin="0,9,0,13"/>
                        <Button Content="重新准备区服文件" IsEnabled="{Binding RegionGuide.CanRestart}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="18,0" Click="OnReprepare"/>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding RegionGuide.ShowMixed, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding RegionGuide.Title}" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RegionGuide.Description}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" LineHeight="21" Margin="0,9,0,13"/>
                        <WrapPanel>
                            <Button Content="恢复到国服" IsEnabled="{Binding RegionGuide.CanRestore}" Style="{StaticResource PrimaryButton}" Padding="17,0" Margin="0,0,9,0" Click="OnSwitchChina"/>
                            <Button Content="恢复到国际服" IsEnabled="{Binding RegionGuide.CanRestore}" Style="{StaticResource PrimaryButton}" Padding="17,0" Margin="0,0,9,0" Click="OnSwitchInternational"/>
                            <Button Content="重新准备" IsEnabled="{Binding RegionGuide.CanRestart}" Style="{StaticResource SecondaryButton}" Padding="17,0" Click="OnReprepare"/>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding RegionGuide.ShowError, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding RegionGuide.Title}" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RegionGuide.Description}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" LineHeight="21" Margin="0,9,0,13"/>
                        <WrapPanel>
                            <Button Content="重试" IsEnabled="{Binding RegionGuide.CanRetry}" Style="{StaticResource PrimaryButton}" Padding="16,0" Margin="0,0,8,0" Click="OnRetry"/>
                            <Button Content="重新执行步骤 2" IsEnabled="{Binding RegionGuide.CanRedoStep2}"
                                    Visibility="{Binding RegionGuide.CanRedoStep2, Converter={StaticResource BoolVisibility}}"
                                    Style="{StaticResource SecondaryButton}" Padding="16,0" Margin="0,0,8,0" Click="OnRedoStep2"/>
                            <Button Content="返回步骤 1" IsEnabled="{Binding RegionGuide.CanReturnToStep1}"
                                    Visibility="{Binding RegionGuide.CanReturnToStep1, Converter={StaticResource BoolVisibility}}"
                                    Style="{StaticResource SecondaryButton}" Padding="16,0" Margin="0,0,8,0" Click="OnReturnStep1"/>
                            <Button Content="改用完整备份" IsEnabled="{Binding RegionGuide.CanUseFullSnapshot}"
                                    Visibility="{Binding RegionGuide.CanUseFullSnapshot, Converter={StaticResource BoolVisibility}}"
                                    Style="{StaticResource SecondaryButton}" Padding="16,0" Margin="0,0,8,0" Click="OnUseFullSnapshot"/>
                            <Button Content="打开日志文件夹" Style="{StaticResource SecondaryButton}" Padding="16,0" Click="OnOpenLogs"/>
                            <Button Content="重新准备区服文件" IsEnabled="{Binding RegionGuide.CanRestart}" Style="{StaticResource SecondaryButton}" Padding="16,0" Margin="8,0,0,0" Click="OnReprepare"/>
                        </WrapPanel>
                    </StackPanel>

                    <Border BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                            Visibility="{Binding RegionGuide.ShowNotice, Converter={StaticResource BoolVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource WarnBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource WarnBd}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RegionGuide.ShowSuccessNotice}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource OkSoft}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Status.Success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RegionGuide.Notice}" Foreground="{DynamicResource WarnTx}" TextWrapping="Wrap" LineHeight="20"/>
                    </Border>

                    <Separator Margin="0,18,0,14"/>
                    <StackPanel>
                        <TextBlock Text="备份管理" FontWeight="SemiBold"/>
                        <TextBlock Text="“重新开始准备”只删除未完成的准备数据；下面的操作会删除 Active Generation、所有历史 Generation 和临时数据。"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" FontSize="12" LineHeight="18" Margin="0,5,0,9"/>
                        <Button Content="删除所有区服备份" IsEnabled="{Binding RegionGuide.CanClear}"
                                Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Padding="15,0" Click="OnClear"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Expander Header="为什么需要准备？" Margin="0,18,0,0" Foreground="{DynamicResource Text.Secondary}">
                <Border Style="{StaticResource SurfaceCard}" Margin="0,10,0,0">
                    <TextBlock Text="国服和国际服的大部分游戏文件相同，但仍有一部分文件存在差异。&#10;&#10;智能差异备份通过当前区服 → 另一区服 → 当前区服的往返记录，保守确认真正稳定的区服差异；完整备份则保留完整临时快照作为兼容方案。&#10;&#10;以后切换区服时，只会恢复或删除当前 Active Generation 已知的区服差异文件。"
                               TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" LineHeight="21"/>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
