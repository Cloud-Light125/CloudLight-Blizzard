<UserControl x:Class="CloudLightBlizzard.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls"
             xmlns:pages="clr-namespace:CloudLightBlizzard.Views.Pages"
             xmlns:behaviors="clr-namespace:CloudLightBlizzard.Behaviors"
             behaviors:NestedScrollBehavior.IsEnabled="True"
             Foreground="{DynamicResource Text.Primary}" Background="{DynamicResource App.Background}">
    <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,22,28">
            <ctrl:PageHeader Title="设置" Description="调整应用行为、Battle.net 路径与本地数据。"/>

            <Border Style="{StaticResource SurfaceCard}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="常规" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                    <CheckBox x:Name="CloseToTrayBox" Style="{StaticResource ThemeCheckBox}" Content="关闭主窗口时最小化到托盘" Margin="0,0,0,12" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    <CheckBox x:Name="StartMinimizedBox" Style="{StaticResource ThemeCheckBox}" Content="启动时进入托盘" Margin="0,0,0,12" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    <CheckBox x:Name="StartupBox" Style="{StaticResource ThemeCheckBox}" Content="开机自动启动" Margin="0,0,0,12" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    <CheckBox x:Name="DarkModeBox" Style="{StaticResource ThemeCheckBox}" Content="深色模式" Checked="OnThemeChanged" Unchecked="OnThemeChanged"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SurfaceCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Battle.net" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Battle.net.exe 路径" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    <TextBlock x:Name="ExePathText" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,5,0,11"/>
                    <WrapPanel><Button Content="自动检测" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="0,0,8,0" Click="OnAutoDetect"/><Button Content="更改" Style="{StaticResource SecondaryButton}" Padding="14,0" Click="OnChooseExe"/></WrapPanel>
                </StackPanel>
            </Border>

            <Border x:Name="NetworkProxyCard" Style="{StaticResource SurfaceCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="网络代理" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="公告、反馈、软件更新与 SOOP、YouTube、Twitch 共用这一套 HTTP / HTTPS 代理。"
                               Foreground="{DynamicResource Text.Secondary}" Margin="0,7,0,13"/>
                    <CheckBox x:Name="EnableProxyBox" Style="{StaticResource ThemeCheckBox}" Content="启用网络代理"
                              Checked="OnProxyInputChanged" Unchecked="OnProxyInputChanged"/>
                    <TextBlock Text="代理地址" FontWeight="SemiBold" Margin="0,12,0,5"/>
                    <TextBox x:Name="ProxyUrlBox" Style="{StaticResource InputBox}" ToolTip="例如 http://127.0.0.1:7897"
                             TextChanged="OnProxyInputChanged"/>
                    <CheckBox x:Name="FallbackDirectBox" Style="{StaticResource ThemeCheckBox}" Content="代理连接失败时允许直连"
                              Margin="0,12,0,0" Checked="OnProxyInputChanged" Unchecked="OnProxyInputChanged"/>
                    <TextBlock x:Name="ProxyNoticeText" Foreground="{DynamicResource Text.Muted}" Margin="0,9,0,0" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="保存代理设置" Style="{StaticResource PrimaryButton}"
                                Padding="15,0" Click="OnSaveProxy"/>
                        <Button x:Name="NetworkTestButton" Content="测试连接"
                                Style="{StaticResource SecondaryButton}" Padding="15,0" Margin="8,0,0,0"
                                Click="OnTestNetwork"/>
                        <Button x:Name="CopyDiagnosticButton" Content="复制诊断结果" IsEnabled="False"
                                Style="{StaticResource SecondaryButton}" Padding="15,0" Margin="8,0,0,0"
                                Click="OnCopyDiagnostic"/>
                    </WrapPanel>
                    <Border x:Name="NetworkDiagnosticPanel" Background="{DynamicResource App.SurfaceAlt}"
                            CornerRadius="8" Padding="12,10" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="网络诊断" FontWeight="SemiBold"/>
                            <TextBlock x:Name="NetworkDiagnosticText" TextWrapping="Wrap" LineHeight="20"
                                       Foreground="{DynamicResource Text.Secondary}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SurfaceCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="公告提醒" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="AnnouncementBadgeBox" Style="{StaticResource ThemeCheckBox}"
                              Content="有新公告时显示小蓝点" Margin="0,14,0,0"
                              Checked="OnAnnouncementBadgeChanged" Unchecked="OnAnnouncementBadgeChanged"/>
                    <TextBlock Text="关闭后仍会获取公告，铃铛和公告列表也会保留。"
                               Foreground="{DynamicResource Text.Muted}" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>

            <pages:FeedbackPanel x:Name="FeedbackPanel" Margin="0,16,0,0"/>

            <Border Style="{StaticResource SurfaceCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="软件更新" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="当前版本" FontWeight="SemiBold" Margin="0,14,0,0" />
                    <TextBlock x:Name="CurrentVersionText" Foreground="{DynamicResource Text.Secondary}" Margin="0,5,0,0" />
                    <TextBlock Text="启动 CloudLight Blizzard 后会自动检查正式版本更新。"
                               Foreground="{DynamicResource Text.Muted}" Margin="0,6,0,12" />
                    <Button x:Name="CheckUpdateButton" Content="检查更新" HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryButton}" Padding="16,0" Click="OnCheckUpdate" />
                    <StackPanel x:Name="SkippedUpdatePanel" Margin="0,15,0,0" Visibility="Collapsed">
                        <TextBlock Text="已忽略更新" FontWeight="SemiBold" />
                        <TextBlock x:Name="SkippedVersionText" Foreground="{DynamicResource Text.Secondary}" Margin="0,5,0,9" />
                        <Button Content="恢复此版本提示" HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButton}" Padding="14,0" Click="OnRestoreSkippedUpdate" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SurfaceCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="数据" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="数据位置" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    <TextBlock x:Name="DataPathText" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,5,0,0"/>
                    <TextBlock Text="账号备份、日志和程序设置保存在这里。" Foreground="{DynamicResource Text.Muted}" Margin="0,5,0,12"/>
                    <WrapPanel><Button Content="打开数据文件夹" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="0,0,8,0" Click="OnOpenData"/><Button Content="清理战绩缓存" Style="{StaticResource SecondaryButton}" Padding="14,0" Click="OnClearCache"/></WrapPanel>
                    <TextBlock x:Name="CacheText" Foreground="{DynamicResource Text.Muted}" Margin="0,9,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
