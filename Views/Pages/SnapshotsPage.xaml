<UserControl x:Class="CloudLightBlizzard.Views.Pages.SnapshotsPage"
             x:Name="SnapshotsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls"
             xmlns:behaviors="clr-namespace:CloudLightBlizzard.Behaviors"
             behaviors:NestedScrollBehavior.IsEnabled="True"
             Foreground="{DynamicResource Text.Primary}" Background="{DynamicResource App.Background}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="SnapshotStateText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Normal"><Setter Property="Foreground" Value="{DynamicResource Status.Success}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Expired"><Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Corrupt"><Setter Property="Foreground" Value="{DynamicResource Status.Error}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Missing"><Setter Property="Foreground" Value="{DynamicResource Status.Error}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unknown"><Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SnapshotDetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="SnapshotDetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <DataTemplate x:Key="SnapshotTemplate">
            <Border Background="{DynamicResource App.SurfaceAlt}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                    CornerRadius="9" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="{Binding ModeText}" FontSize="14" FontWeight="SemiBold"/>
                                <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Padding="7,2"
                                        Visibility="{Binding ActiveVisibility}">
                                    <TextBlock Text="当前使用" Foreground="{DynamicResource Accent.Primary}" FontSize="10.5"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock Margin="0,5,0,0">
                                <Run Text="{Binding SourceText}"/><Run Text=" → "/><Run Text="{Binding TargetText}"/>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="10,0,0,0" VerticalAlignment="Top">
                            <TextBlock Text="{Binding StateText}" Style="{StaticResource SnapshotStateText}" FontSize="10.5"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding StateReason}" Visibility="{Binding StateReasonVisibility}"
                               Foreground="{DynamicResource Text.Secondary}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="文件数量" Style="{StaticResource SnapshotDetailLabel}"/>
                            <TextBlock Text="{Binding FileCountText}" Style="{StaticResource SnapshotDetailValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="总大小" Style="{StaticResource SnapshotDetailLabel}"/>
                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource SnapshotDetailValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="创建时间" Style="{StaticResource SnapshotDetailLabel}"/>
                            <TextBlock Text="{Binding CreatedText}" Style="{StaticResource SnapshotDetailValue}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,7,0,0">
                        <TextBlock Text="最近使用" Style="{StaticResource SnapshotDetailLabel}"/>
                        <TextBlock Text="{Binding UsedText}" Style="{StaticResource SnapshotDetailValue}"/>
                    </StackPanel>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="查看详情" Tag="details" Height="28" Padding="10,0" Click="OnSnapshotAction"/>
                        <Button Content="重新生成" Tag="regenerate" Height="28" Padding="10,0" Margin="6,0,0,0" Click="OnSnapshotAction"/>
                        <Button Content="打开目录" Tag="open" Height="28" Padding="10,0" Margin="6,0,0,0" Click="OnSnapshotAction"/>
                        <Button Content="删除" Tag="delete" Height="28" Padding="10,0" Margin="6,0,0,0"
                                Style="{StaticResource DangerButton}" Click="OnSnapshotAction"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,22,30">
            <ctrl:PageHeader Title="区服快照" Description="查看和管理 CloudLight Blizzard 创建的区服文件快照。">
                <ctrl:PageHeader.HeaderActions>
                    <Button Content="刷新" Style="{StaticResource SecondaryButton}" Padding="14,0" Click="OnRefresh"/>
                </ctrl:PageHeader.HeaderActions>
            </ctrl:PageHeader>

            <Border x:Name="SnapshotSummaryCard" Style="{StaticResource SurfaceCard}" Margin="0,16,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="{Binding SnapshotCount, StringFormat=共 {0} 个快照}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Text.Secondary}"
                               Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid x:Name="SnapshotWorkspace" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" MinWidth="390"/>
                    <ColumnDefinition Width="1*" MinWidth="300"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="SnapshotListPanel" Style="{StaticResource SurfaceCard}" Padding="14" Margin="0,0,7,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="快照列表" Style="{StaticResource SectionTitle}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SnapshotCount, StringFormat=共 {0} 个}"
                                       Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Margin="0,10,0,0" MinHeight="140">
                            <ListBox x:Name="SnapshotsList" ItemsSource="{Binding Items}"
                                     SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}"
                                     ItemTemplate="{StaticResource SnapshotTemplate}"
                                     MaxHeight="540" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            <TextBlock Text="当前没有已生成的快照。" Foreground="{DynamicResource Text.Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="SnapshotDetailsPanel" Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="14"
                        Visibility="{Binding HasSelectedSnapshot, Converter={StaticResource BoolVisibility}}">
                    <StackPanel DataContext="{Binding SelectedSnapshot}">
                        <DockPanel>
                            <Button Content="关闭" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                    Padding="11,0" Click="OnCloseDetails"/>
                            <StackPanel>
                                <TextBlock Text="快照详情" Style="{StaticResource SectionTitle}"/>
                                <WrapPanel Margin="0,4,0,0">
                                    <TextBlock Text="{Binding ModeText}" Foreground="{DynamicResource Text.Secondary}" FontSize="11"/>
                                    <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Padding="7,2">
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource SnapshotStateText}" FontSize="10.5"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </DockPanel>

                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="基本信息" FontSize="13" FontWeight="SemiBold"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="来源 → 目标" Style="{StaticResource SnapshotDetailLabel}"/>
                                        <TextBlock Style="{StaticResource SnapshotDetailValue}"><Run Text="{Binding SourceText}"/><Run Text=" → "/><Run Text="{Binding TargetText}"/></TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="快照 ID" Style="{StaticResource SnapshotDetailLabel}"/>
                                        <TextBlock Text="{Binding GenerationId}" Style="{StaticResource SnapshotDetailValue}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GenerationId}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Padding="10" Margin="0,9,0,0">
                            <StackPanel>
                                <TextBlock Text="状态" FontSize="13" FontWeight="SemiBold"/>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="当前状态" Style="{StaticResource SnapshotDetailLabel}"/>
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource SnapshotStateText}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding StateReason}" Visibility="{Binding StateReasonVisibility}"
                                           Foreground="{DynamicResource Text.Secondary}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Padding="10" Margin="0,9,0,0">
                            <StackPanel>
                                <TextBlock Text="文件与大小" FontSize="13" FontWeight="SemiBold"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="文件数量" Style="{StaticResource SnapshotDetailLabel}"/>
                                        <TextBlock Text="{Binding FileCountText}" Style="{StaticResource SnapshotDetailValue}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="总大小" Style="{StaticResource SnapshotDetailLabel}"/>
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource SnapshotDetailValue}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Padding="10" Margin="0,9,0,0">
                            <StackPanel>
                                <TextBlock Text="路径与时间" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="受管理目录" Style="{StaticResource SnapshotDetailLabel}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding RootPath}" Style="{StaticResource SnapshotDetailValue}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RootPath}"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="创建时间" Style="{StaticResource SnapshotDetailLabel}"/>
                                        <TextBlock Text="{Binding CreatedText}" Style="{StaticResource SnapshotDetailValue}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="最近使用" Style="{StaticResource SnapshotDetailLabel}"/>
                                        <TextBlock Text="{Binding UsedText}" Style="{StaticResource SnapshotDetailValue}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="SnapshotDetailsEmptyPanel" Grid.Column="1" Padding="14" Margin="7,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedSnapshot}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="选择一个快照" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="从左侧列表选择快照后，这里会按基本信息、状态、文件大小、路径和时间分组显示详情。"
                                   Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="SnapshotsEmptyCard" Padding="16" Margin="0,14,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="尚未生成区服快照" FontWeight="SemiBold"/>
                    <TextBlock Text="先打开“区服切换”，选择 VerifiedDifference 或 FullSnapshot，完成当前区服与另一区服文件准备。"
                               Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Button Content="前往区服切换" Style="{StaticResource PrimaryButton}" Padding="14,0"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnOpenRegion"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
