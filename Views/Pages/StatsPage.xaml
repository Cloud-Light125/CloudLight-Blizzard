<UserControl x:Class="CloudLightBlizzard.Views.Pages.StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls"
             Foreground="{DynamicResource Text.Primary}"
             Background="{DynamicResource App.Background}">
    <Grid Margin="28,24,22,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ctrl:PageHeader Title="国际服战绩"
                         Description="输入 BattleTag 后，查询暴雪公开的守望先锋生涯数据。"/>

        <Border Grid.Row="1" Margin="0,20,0,0"
                Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <ContentControl x:Name="CareerHost"/>
        </Border>
    </Grid>
</UserControl>
