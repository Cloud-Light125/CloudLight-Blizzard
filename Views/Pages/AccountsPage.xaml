<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:accounts="clr-namespace:CloudLightBlizzard.Views.Accounts" xmlns:behaviors="clr-namespace:CloudLightBlizzard.Behaviors" xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CloudLightBlizzard.Views.Pages.AccountsPage" behaviors:NestedScrollBehavior.IsEnabled="True" Foreground="{DynamicResource Text.Primary}" Background="{DynamicResource App.Background}">
    <Grid Margin="24,22,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ctrl:PageHeader Title="账号管理" Description="管理 Battle.net 账号并快速切换。" />
        <WrapPanel x:Name="AccountWorkspaceNavigation" Margin="0,8,0,8" Grid.Row="1">
            <RadioButton Content="账号库" Tag="library" GroupName="AccountWorkspace" Style="{StaticResource WorkspaceTab}" Checked="OnAccountWorkspaceChanged" />
            <RadioButton Content="备份与存储" Tag="storage" GroupName="AccountWorkspace" Style="{StaticResource WorkspaceTab}" Checked="OnAccountWorkspaceChanged" />
        </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="2">
            <StackPanel Margin="0,12,4,16">
                <StackPanel Tag="workspace:library">
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,8,0,20" Background="{DynamicResource AccSoft}">
                        <Grid behaviors:ResponsiveGrid.IsEnabled="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ctrl:PlatformIcon Platform="BattleNet" Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,14" />
                                <TextBlock Text="当前账号（本地配置指向，认证请在 Battle.net 确认）" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" />
                                <StackPanel Visibility="{Binding HasCurrentVisibility}" Margin="0,7,0,0">
                                    <TextBlock Text="{Binding CurrentAccount.DisplayName}" FontSize="21" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding CurrentAccount.BattleTag}" Foreground="{DynamicResource Text.Secondary}" />
                                        <TextBlock Text="  ·  " Foreground="{DynamicResource Text.Muted}" />
                                        <TextBlock Text="{Binding CurrentAccount.RegionText}" Foreground="{DynamicResource Accent.Primary}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="当前未检测到登录账号。" Visibility="{Binding NoCurrentVisibility}" Margin="0,7,0,0" Foreground="{DynamicResource Text.Secondary}" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                <Button Content="打开 Battle.net" Style="{StaticResource PrimaryButton}" Padding="15,0" Margin="0,0,8,8" Click="OnLaunchClient" />
                                <Button Content="更新账号备份" Style="{StaticResource SecondaryButton}" Padding="15,0" Margin="0,0,8,8" Click="OnSaveCurrent" />
                                <Button Content="登录新账号" Style="{StaticResource SecondaryButton}" Padding="15,0" Margin="0,0,0,8" Click="OnAddAccount" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <DockPanel Margin="0,28,0,12">
                        <TextBlock Text="账号快照" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding ReadyCountText}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Text.Muted}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding SavedAccounts}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <accounts:AccountTile />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Visibility="{Binding UnsavedVisibility}" Margin="0,16,0,0">
                        <TextBlock Text="检测到但尚未保存" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding UnsavedCountText}" Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,10" />
                        <ItemsControl ItemsSource="{Binding UnsavedAccounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,8" Padding="14">
                                        <DockPanel>
                                            <Button Content="隐藏" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Click="OnHide" />
                                            <Button Content="重新登录并保存" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,8,0" Click="OnSwitchCard" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding BattleTag}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ProfileText}" ToolTip="{Binding ProfileDetail}" Foreground="{DynamicResource Text.Muted}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
                <StackPanel Tag="workspace:storage">
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Battle.net 账号快照位置" FontWeight="SemiBold" />
                            <TextBlock x:Name="AccountSnapshotPathText" Text="{Binding AccountSnapshotPath}" TextWrapping="Wrap" TextOptions.TextFormattingMode="Display" Margin="0,5,0,0" />
                            <TextBlock Text="守望先锋的自定义区服备份位置不影响此目录。快照只保存账号配置，不能保证认证永久有效。" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding AccountMigrationWarning}" TextWrapping="Wrap" Foreground="{DynamicResource Status.Warning}" />
                            <Button Content="打开账号快照目录" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Padding="12,0" Click="OnOpenSnapshots" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
