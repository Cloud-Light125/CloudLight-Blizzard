<UserControl x:Class="CloudLightBlizzard.Views.Pages.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls"
             xmlns:behaviors="clr-namespace:CloudLightBlizzard.Behaviors"
             behaviors:NestedScrollBehavior.IsEnabled="True"
             Foreground="{DynamicResource Text.Primary}" Background="{DynamicResource App.Background}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <DataTemplate x:Key="DiagnosticItemTemplate">
            <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusIcon}" FontSize="17" FontWeight="Bold" VerticalAlignment="Top">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/><Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Healthy"><Setter Property="Foreground" Value="{DynamicResource Status.Success}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource Status.Error}"/></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="2" Margin="12,0,12,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Text.Secondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,22,30">
            <ctrl:PageHeader Title="诊断中心" Description="检查 CloudLight Blizzard、Battle.net、网络、更新、Drops 与区服数据状态。"/>
            <Border Style="{StaticResource SurfaceCard}" Margin="0,18,0,0">
                <StackPanel>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Right">
                            <Button Content="开始诊断" Style="{StaticResource PrimaryButton}" Padding="16,0" Margin="0,0,8,0" Click="OnStart"/>
                            <Button Content="复制诊断结果" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="0,0,8,0" IsEnabled="{Binding CanExport}" Click="OnCopy"/>
                            <Button Content="导出诊断包" Style="{StaticResource SecondaryButton}" Padding="14,0" IsEnabled="{Binding CanExport}" Click="OnExport"/>
                        </WrapPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource Text.Secondary}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar Height="8" Margin="0,14,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding IsRunning, Mode=OneWay}"/>
                    <Button Content="取消诊断" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Padding="13,0" Margin="0,10,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}" Click="OnCancel"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SectionTitle}" Margin="0,20,0,10"/>
            <ItemsControl ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource DiagnosticItemTemplate}">
                <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Checks.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
            </ItemsControl>
            <Border Padding="16,14" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="还没有诊断结果" FontWeight="SemiBold"/>
                    <TextBlock Text="运行一次诊断后，这里会列出每一项检查及其技术详情；导出包只包含最近 3 天、最多 50 MB 的脱敏日志。" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource SurfaceCard}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Checks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
