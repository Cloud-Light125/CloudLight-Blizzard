<UserControl x:Class="CloudLightBlizzard.Views.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls"
             Foreground="{DynamicResource Text.Primary}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,22,24,24">
            <ctrl:PageHeader Title="总览" Description="账号、游戏与掉宝状态，一目了然。"/>
            <Border Style="{StaticResource SectionCard}" Margin="0,22,0,16" Background="{DynamicResource AccSoft}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="欢迎使用 CloudLight Blizzard" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,8,18,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="管理账号" Tag="accounts" Click="OnNavigate" Style="{StaticResource PrimaryButton}" Padding="18,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource SectionCard}" Margin="0,0,8,0"><StackPanel>
                    <TextBlock Text="Battle.net" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding CurrentAccount.DisplayName, TargetNullValue=尚未检测到当前账号, FallbackValue=尚未检测到当前账号}" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ReadyCountText}" Foreground="{DynamicResource Text.Secondary}" Margin="0,7,0,0"/>
                    <TextBlock Foreground="{DynamicResource Accent.Primary}" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="未检测到 Battle.net 进程"/><Style.Triggers><DataTrigger Binding="{Binding ClientRunning}" Value="True"><Setter Property="Text" Value="Battle.net 客户端运行中"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <TextBlock Text="本地账号指向，认证状态请在 Battle.net 确认。" Style="{StaticResource FieldHint}"/>
                </StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource SectionCard}" Margin="8,0,0,0"><StackPanel>
                    <TextBlock Text="守望先锋" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding GameRegionTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    <TextBlock Text="{Binding GameRegionSummary}" Foreground="{DynamicResource Text.Secondary}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding GameRegionPath}" Style="{StaticResource FieldHint}" TextTrimming="CharacterEllipsis"/>
                    <Button Content="查看区服与路径" Tag="region" Click="OnNavigate" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="12,0" Margin="0,12,0,0"/>
                </StackPanel></Border>
            </Grid>
            <TextBlock Text="掉宝平台" Style="{StaticResource SectionTitle}" Margin="0,4,0,12"/>
            <ItemsControl x:Name="PlatformStatusList">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Style="{StaticResource SectionCard}" Padding="16" Margin="0,0,10,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="8,0,16,0"><TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                        <Button Grid.Column="2" Content="查看平台" Tag="{Binding Platform}" Click="OnPlatform" Style="{StaticResource SecondaryButton}" Padding="12,0" VerticalAlignment="Center"/>
                    </Grid></Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource SectionCard}" Margin="0,8,0,0"><StackPanel>
                <TextBlock Text="常用操作与消息" Style="{StaticResource SectionTitle}"/>
                <WrapPanel Margin="0,14,0,0">
                    <Button Content="区服快照" Tag="snapshots" Click="OnNavigate" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="0,0,8,8"/>
                    <Button Content="诊断中心" Tag="diagnostics" Click="OnNavigate" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="0,0,8,8"/>
                    <Button Content="查看公告" Click="OnAnnouncements" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="0,0,8,8"/>
                </WrapPanel>
                <TextBlock Text="最新公告可通过右上角铃铛查看；提醒状态与已有公告服务同步。" Style="{StaticResource FieldHint}"/>
                <ItemsControl x:Name="LatestAnnouncements" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding PublishedAt, StringFormat={}{0:MM-dd}}" Foreground="{DynamicResource Text.Secondary}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
