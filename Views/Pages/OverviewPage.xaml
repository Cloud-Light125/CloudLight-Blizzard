<UserControl x:Class="CloudLightBlizzard.Views.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls"
             xmlns:behaviors="clr-namespace:CloudLightBlizzard.Behaviors"
             behaviors:NestedScrollBehavior.IsEnabled="True"
             Foreground="{DynamicResource Text.Primary}" Background="{DynamicResource App.Background}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24,22,30">
        <ctrl:PageHeader Title="CloudLight Blizzard" Description="区服、Drops、网络与软件更新状态总览。">
            <ctrl:PageHeader.HeaderActions><Button Content="刷新" Style="{StaticResource SecondaryButton}" Padding="14,0" Click="OnRefresh"/></ctrl:PageHeader.HeaderActions>
        </ctrl:PageHeader>
        <Border Style="{StaticResource SurfaceCard}" Margin="0,18,0,0" Padding="18,15">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="切换区服" Style="{StaticResource PrimaryButton}" Padding="15,0" Margin="0,0,8,0" Click="OnOpenRegion"/>
                    <Button Content="运行诊断" Style="{StaticResource SecondaryButton}" Padding="15,0" Click="OnOpenDiagnostics"/>
                </StackPanel>
                <StackPanel><TextBlock Text="{Binding OverallText}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding OverallDetail}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
            </DockPanel>
        </Border>
        <UniformGrid Columns="2" Margin="0,16,0,0">
            <Border Style="{StaticResource SurfaceCard}" Margin="0,0,8,8"><StackPanel><DockPanel><TextBlock Text="当前区服" Style="{StaticResource SectionTitle}"/><TextBlock Text="Battle.net" DockPanel.Dock="Right" Foreground="{DynamicResource Text.Muted}"/></DockPanel><TextBlock Text="{Binding RegionText}" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="{Binding BattleNetText}" Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0"/><Button Content="{Binding RegionActionText}" Style="{StaticResource SecondaryButton}" Padding="14,0" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnOpenRegion"/></StackPanel></Border>
            <Border Style="{StaticResource SurfaceCard}" Margin="8,0,0,8"><StackPanel><TextBlock Text="Drops" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding SoopText}" Margin="0,12,0,0"/><TextBlock Text="{Binding TwitchText}" Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0"/><TextBlock Text="{Binding DropsProgressText}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/><Button Content="打开 Drops" Style="{StaticResource SecondaryButton}" Padding="14,0" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnOpenDrops"/></StackPanel></Border>
            <Border Style="{StaticResource SurfaceCard}" Margin="0,8,8,8"><StackPanel><TextBlock Text="网络" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ProxyText}" Margin="0,12,0,0"/><TextBlock Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0"><Run Text="公告："/><Run Text="{Binding AnnouncementText, Mode=OneWay}"/></TextBlock><TextBlock Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0"><Run Text="更新："/><Run Text="{Binding NetworkUpdateText, Mode=OneWay}"/></TextBlock></StackPanel></Border>
            <Border Style="{StaticResource SurfaceCard}" Margin="8,8,0,8"><StackPanel><DockPanel><TextBlock Text="软件更新" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding CurrentVersionText}" DockPanel.Dock="Right" Foreground="{DynamicResource Text.Muted}"/></DockPanel><TextBlock Margin="0,12,0,0"><Run Text="最新："/><Run Text="{Binding LatestVersionText, Mode=OneWay}"/></TextBlock><Button Content="检查更新" Style="{StaticResource SecondaryButton}" Padding="14,0" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnCheckUpdate"/></StackPanel></Border>
            <Border Style="{StaticResource SurfaceCard}" Margin="0,8,8,8"><StackPanel><TextBlock Text="快照" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding SnapshotText}" Margin="0,12,0,0"/><TextBlock Text="{Binding SnapshotTimeText}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/><Button Content="管理区服快照" Style="{StaticResource SecondaryButton}" Padding="14,0" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnOpenSnapshots"/></StackPanel></Border>
            <Border Style="{StaticResource SurfaceCard}" Margin="8,8,0,8"><StackPanel><TextBlock Text="最近活动" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ActivityText}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
        </UniformGrid>
        <TextBlock Text="快捷操作" Style="{StaticResource SectionTitle}" Margin="0,14,0,10"/>
        <WrapPanel><Button Content="切换区服" Style="{StaticResource PrimaryButton}" Padding="15,0" Margin="0,0,8,0" Click="OnOpenRegion"/><Button Content="检查更新" Style="{StaticResource SecondaryButton}" Padding="15,0" Margin="0,0,8,0" Click="OnCheckUpdate"/><Button Content="打开 Drops" Style="{StaticResource SecondaryButton}" Padding="15,0" Margin="0,0,8,0" Click="OnOpenDrops"/><Button Content="运行诊断" Style="{StaticResource SecondaryButton}" Padding="15,0" Click="OnOpenDiagnostics"/></WrapPanel>
    </StackPanel></ScrollViewer>
</UserControl>
