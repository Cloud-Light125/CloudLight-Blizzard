<Window x:Class="CloudLightBlizzard.Views.RegionActionConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="区服文件准备" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="456" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Border Background="{DynamicResource Win}" CornerRadius="12" Margin="16"
            BorderBrush="{DynamicResource Bd}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="18,15,18,0" MouseLeftButtonDown="OnDrag">
                <TextBlock x:Name="TitleText" Foreground="{DynamicResource Tx1}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                <Button Style="{StaticResource TitleIconButton}" HorizontalAlignment="Right" Click="OnCancel" Width="26" Height="26" Content="×" Foreground="{DynamicResource Tx3}" FontSize="17" />
            </Grid>

            <StackPanel Margin="18,14,18,0">
                <TextBlock x:Name="MessageText" Foreground="{DynamicResource Tx2}" TextWrapping="Wrap" LineHeight="21" />
                <Border x:Name="BulletBox" Background="{DynamicResource Body}" CornerRadius="8" Padding="12,10" Margin="0,11,0,0">
                    <TextBlock x:Name="BulletText" Foreground="{DynamicResource Tx2}" TextWrapping="Wrap" LineHeight="23" />
                </Border>
                <TextBlock x:Name="FooterText" Foreground="{DynamicResource Tx3}" TextWrapping="Wrap" LineHeight="20" Margin="0,11,0,0" />
            </StackPanel>

            <Grid Margin="18,17,18,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Height="34" Padding="18,0" Margin="0,0,9,0" Click="OnCancel" Content="取消" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Height="34" Padding="18,0" Click="OnConfirm" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
