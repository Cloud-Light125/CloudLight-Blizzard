<Window x:Class="BnetSwitch.DeleteConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:BnetSwitch.Controls"
        Title="删除账号备份" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="344" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Border Background="{DynamicResource Win}" CornerRadius="12" Margin="16"
            BorderBrush="{DynamicResource Bd}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="15,13,15,0" MouseLeftButtonDown="OnDrag">
                <StackPanel Orientation="Horizontal">
                    <ctrl:IconView Geometry="{StaticResource GeoDelete}" Stroke="{DynamicResource Danger}" Thickness="2" IconSize="15" Margin="0,0,8,0" />
                    <TextBlock x:Name="HeadText" Text="删除账号备份" Foreground="{DynamicResource Tx1}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource TitleIconButton}" HorizontalAlignment="Right" Click="OnCancel" Width="26" Height="26">
                    <ctrl:IconView Geometry="{StaticResource GeoX}" Stroke="{DynamicResource Tx3}" Thickness="2" IconSize="14" />
                </Button>
            </Grid>

            <StackPanel Margin="15,10,15,0">
                <TextBlock Foreground="{DynamicResource Tx2}" FontSize="12.5" TextWrapping="Wrap" LineHeight="20">
                    <Run x:Name="BodyPrefix" Text="确定删除 " /><Run x:Name="NameRun" Foreground="{DynamicResource Tx1}" FontWeight="SemiBold" /><Run x:Name="BodySuffix" Text=" 的账号备份吗?" />
                </TextBlock>
                <TextBlock x:Name="SubText" Text="这不会影响 Battle.net 登录；之后要切换到它，需要重新保存一次账号备份。"
                           Foreground="{DynamicResource Tx3}" FontSize="11.5" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="17" />
            </StackPanel>

            <Grid Margin="15,15,15,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Height="32" Padding="16,0" Margin="0,0,8,0" Click="OnCancel" Content="取消" FontSize="12.5" />
                    <Button Style="{StaticResource DangerButton}" Height="32" Padding="18,0" Click="OnConfirm" FontSize="12.5">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:IconView Geometry="{StaticResource GeoDelete}" Stroke="{DynamicResource OnAcc}" Thickness="2" IconSize="13" Margin="0,0,6,0" />
                            <TextBlock x:Name="ConfirmText" Text="删除" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
