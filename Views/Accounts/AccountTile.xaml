<UserControl x:Class="CloudLightBlizzard.Views.Accounts.AccountTile" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:CloudLightBlizzard.Controls">
    <Border Style="{DynamicResource HeroCard}" Margin="0,0,16,16"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="50" Height="50" CornerRadius="16" Background="{Binding AvatarBg}" VerticalAlignment="Top"><TextBlock Text="{Binding AvatarText}" Foreground="{Binding AvatarFg}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding BattleTag}" FontSize="14" Foreground="{DynamicResource Text.Secondary}" Margin="0,5,0,0"/></StackPanel>
            <c:PlatformIcon Grid.Column="2" Platform="BattleNet" Width="30" Height="30" VerticalAlignment="Top"/>
        </Grid>
        <WrapPanel Margin="0,18,0,14"><Border Style="{DynamicResource Badge}" Margin="0,0,8,0"><TextBlock Text="{Binding RegionText}" FontSize="13" Foreground="{DynamicResource Accent.Primary}"/></Border><Border Style="{DynamicResource Badge}" Visibility="{Binding CurrentVisibility}" Margin="0,0,8,0"><TextBlock Text="当前账号" FontSize="13" Foreground="{DynamicResource Status.Success}"/></Border></WrapPanel>
        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="10" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="备份状态" FontSize="13" Foreground="{DynamicResource Text.Secondary}"/><TextBlock Text="{Binding ProfileText}" ToolTip="{Binding ProfileDetail}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,10,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="最近保存" FontSize="13" Foreground="{DynamicResource Text.Secondary}"/><TextBlock Text="{Binding SavedRelative}" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Grid></Border>
        <TextBlock Text="{Binding Remark}" Visibility="{Binding RemarkVisibility}" FontSize="13" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="需要重新登录 Battle.net" Visibility="{Binding ExpiredVisibility}" Foreground="{DynamicResource Status.Warning}" FontSize="13" Margin="0,10,0,0"/>
        <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="{Binding SwitchText}" IsEnabled="{Binding CanSwitch}" c:WorkspaceAction.Name="account:switch" Style="{DynamicResource PrimaryButton}"/><Button Grid.Column="1" Content="•••" ToolTip="更多账号操作" Click="OnMore" Style="{DynamicResource IconButton}" Margin="10,0,0,0"><Button.ContextMenu><ContextMenu><MenuItem Header="自定义名称与备注" Tag="account:edit" Click="OnMenuAction"/><MenuItem Header="查看战绩" Tag="account:stats" Visibility="{Binding StatsVisibility}" Click="OnMenuAction"/><Separator/><MenuItem Header="删除账号备份" Tag="account:delete" Foreground="{DynamicResource Status.Error}" Click="OnMenuAction"/></ContextMenu></Button.ContextMenu></Button></Grid>
    </StackPanel></Border>
</UserControl>
