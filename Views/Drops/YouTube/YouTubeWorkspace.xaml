<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:youtube="clr-namespace:CloudLightBlizzard.Views.Drops.YouTube" x:Class="CloudLightBlizzard.Views.Drops.YouTube.YouTubeWorkspace">
    <StackPanel x:Name="YouTubePanel" Visibility="{Binding YouTubePanelVisibility}" x:FieldModifier="internal">
        <youtube:YouTubeOverview x:Name="YouTubeOverview" x:FieldModifier="internal" Tag="workspace:overview" />
        <StackPanel Tag="workspace:accounts">
            <Border x:Name="YouTubeAccountsCard" Style="{StaticResource SurfaceCard}" Margin="0,0,0,16" CornerRadius="14" x:FieldModifier="internal">
                <StackPanel>
                    <TextBlock Text="观看账号" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="每个观看账号使用独立的 Chrome / Brave 浏览器资料目录，登录状态互不影响。" Style="{StaticResource FieldHint}" />
                    <Grid Margin="0,10,0,10" MinHeight="110">
                        <ListBox x:Name="YouTubeProfilesList" ItemsSource="{Binding Accounts}" ItemTemplate="{StaticResource DropsRowTemplate}" MaxHeight="220" x:FieldModifier="internal" />
                        <TextBlock Text="暂无观看账号。" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Accounts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="账号名称" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="YouTubeProfileName" Style="{StaticResource HintTextBox}" Tag="例如：主账号" Width="240" HorizontalAlignment="Left" x:FieldModifier="internal" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="添加账号" Style="{StaticResource SecondaryButton}" Padding="12,0" Click="OnYouTubeAddProfile" />
                        <Button Content="打开登录窗口" Style="{StaticResource PrimaryButton}" Padding="12,0" Margin="8,0,0,0" Click="OnYouTubeLogin" />
                        <Button Content="删除账号" Style="{StaticResource DangerButton}" Padding="12,0" Margin="8,0,0,0" Click="OnYouTubeDeleteProfile" />
                    </WrapPanel>
                    <TextBlock Text="首次使用请在打开的浏览器中完成 YouTube 登录。" Style="{StaticResource FieldHint}" />
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel Tag="workspace:activities">
            <Border x:Name="YouTubeChannelsCard" Style="{StaticResource SurfaceCard}" Margin="0,0,0,16" CornerRadius="14" x:FieldModifier="internal">
                <StackPanel>
                    <TextBlock Text="频道列表" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="程序只会自动检查已启用的频道。绿色圆点表示启用，灰色圆点表示停用。" Style="{StaticResource FieldHint}" />
                    <Grid Margin="0,10,0,10" MinHeight="100">
                        <ListBox x:Name="YouTubeChannelsList" ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource YouTubeChannelRowTemplate}" MaxHeight="180" x:FieldModifier="internal" />
                        <TextBlock Text="尚未添加频道。" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Channels.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="频道名称" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="YouTubeChannelName" Style="{StaticResource HintTextBox}" Tag="例如：Overwatch Esports" x:FieldModifier="internal" />
                    <TextBlock Text="频道 ID" Style="{StaticResource FieldLabel}" Margin="0,10,0,6" />
                    <TextBox x:Name="YouTubeChannelId" Style="{StaticResource HintTextBox}" Tag="例如：UC..." x:FieldModifier="internal" />
                    <TextBlock Text="频道地址" Style="{StaticResource FieldLabel}" Margin="0,10,0,6" />
                    <TextBox x:Name="YouTubeChannelUrl" Style="{StaticResource HintTextBox}" Tag="也可以直接粘贴频道 URL" x:FieldModifier="internal" />
                    <TextBlock Text="频道 ID 与频道地址填写任意一项即可。" Style="{StaticResource FieldHint}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="添加频道" Style="{StaticResource SecondaryButton}" Padding="12,0" Click="OnYouTubeAddChannel" />
                        <Button Content="启用 / 停用" Style="{StaticResource SecondaryButton}" Padding="12,0" Margin="8,0,0,0" Click="OnYouTubeToggleChannel" />
                        <Button Content="删除" Style="{StaticResource DangerButton}" Padding="12,0" Margin="8,0,0,0" Click="OnYouTubeDeleteChannel" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCard}" Margin="0,14,0,0" CornerRadius="14">
                <StackPanel>
                    <TextBlock Text="观看时间与历史" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,10,0,0" MinHeight="110">
                        <ListBox ItemsSource="{Binding History}" ItemTemplate="{StaticResource DropsRowTemplate}" MaxHeight="240" />
                        <TextBlock Text="暂无观看记录。" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding History.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel Tag="workspace:settings">
            <Border x:Name="YouTubeBrowserCard" Style="{StaticResource SurfaceCard}" Margin="0,14,0,0" CornerRadius="14" x:FieldModifier="internal">
                <StackPanel>
                    <TextBlock Text="浏览器与观看设置" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="浏览器" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="YouTubeBrowser" Style="{StaticResource ThemeComboBox}" SelectionChanged="OnYouTubeBrowserChanged" x:FieldModifier="internal">
                                <ComboBoxItem Content="Google Chrome" Tag="chrome" />
                                <ComboBoxItem Content="Brave" Tag="brave" />
                            </ComboBox>
                        </StackPanel>
                        <Expander Grid.Column="1" Header="自定义浏览器路径（可选）" Foreground="{DynamicResource Text.Secondary}" Margin="8,0,0,0">
                            <DockPanel Margin="0,8,0,0">
                                <Button Content="浏览..." DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="12,0" Margin="8,0,0,0" Click="OnBrowseYouTubeBrowser" />
                                <TextBox x:Name="YouTubeBrowserPath" Style="{StaticResource HintTextBox}" Tag="自动检测，通常无需填写" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" x:FieldModifier="internal" />
                            </DockPanel>
                        </Expander>
                    </Grid>
                    <StackPanel>
                        <ctrl:SettingRow Title="观看模式" Description="自动检测频道开播，或手动指定直播地址。">
                            <ctrl:SettingRow.Editor>
                                <StackPanel>
                                    <ComboBox x:Name="YouTubeMode" Style="{StaticResource ThemeComboBox}" SelectionChanged="OnYouTubeModeChanged" x:FieldModifier="internal">
                                        <ComboBoxItem Content="自动检测直播" Tag="auto" />
                                        <ComboBoxItem Content="手动指定直播" Tag="manual" />
                                    </ComboBox>
                                </StackPanel>
                            </ctrl:SettingRow.Editor>
                        </ctrl:SettingRow>
                        <ctrl:SettingRow Title="直播地址" Description="更改后点击下方“保存设置”应用。" Visibility="{Binding Editor.Visibility,RelativeSource={RelativeSource Self}}">
                            <ctrl:SettingRow.Editor>
                                <StackPanel x:Name="YouTubeManualUrlPanel" Visibility="Collapsed" x:FieldModifier="internal">
                                    <TextBox x:Name="YouTubeManualUrl" Style="{StaticResource HintTextBox}" Tag="粘贴 YouTube 直播地址" x:FieldModifier="internal" />
                                </StackPanel>
                            </ctrl:SettingRow.Editor>
                        </ctrl:SettingRow>
                    </StackPanel>
                    <WrapPanel Margin="0,14,0,0">
                        <CheckBox x:Name="YouTubeHeadless" Style="{StaticResource ThemeCheckBox}" Content="无头模式" Margin="0,0,18,0" x:FieldModifier="internal" />
                        <CheckBox x:Name="YouTubeMute" Style="{StaticResource ThemeCheckBox}" Content="静音播放" x:FieldModifier="internal" />
                    </WrapPanel>
                    <StackPanel Margin="0,14,0,0" Width="300" HorizontalAlignment="Left">
                        <TextBlock Text="直播检查间隔" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <TextBlock Text="秒" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox x:Name="YouTubeInterval" Style="{StaticResource HintTextBox}" Tag="300" x:FieldModifier="internal" />
                        </DockPanel>
                        <TextBlock Text="每隔多久检查一次频道是否开播。" Style="{StaticResource FieldHint}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>