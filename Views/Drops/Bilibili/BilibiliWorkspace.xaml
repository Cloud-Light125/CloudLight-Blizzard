<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:behaviors="clr-namespace:CloudLightBlizzard.Behaviors" xmlns:bilibili="clr-namespace:CloudLightBlizzard.Views.Drops.Bilibili" xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CloudLightBlizzard.Views.Drops.Bilibili.BilibiliWorkspace">
    <StackPanel x:Name="BilibiliPanel" Visibility="{Binding BilibiliPanelVisibility}" x:FieldModifier="internal">
        <bilibili:BilibiliOverview x:Name="BilibiliOverview" x:FieldModifier="internal" Tag="workspace:overview" />
        <StackPanel Tag="workspace:accounts">
            <Border Style="{DynamicResource HeroCard}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="退出登录" Command="{Binding BilibiliDetails.LogoutCommand}" Visibility="{Binding BilibiliDetails.LogoutVisibility}" Style="{DynamicResource DangerButton}" />
                    <ctrl:PlatformIcon Platform="Bilibili" Width="40" Height="40" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding BilibiliDetails.AccountStatus}" FontSize="20" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Expander Header="高级 Cookie 导入" Margin="0,12,0,16">
                <Border Style="{StaticResource SurfaceCard}" Padding="14" Margin="0,0,0,16" CornerRadius="14">
                    <StackPanel>
                        <TextBlock Text="高级登录（可选）" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="故障排查或无法扫码时使用；Cookie 仅在受控 Worker 内加密保存。" Style="{StaticResource FieldHint}" />
                        <TextBlock Text="手动导入 Cookie" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                        <PasswordBox x:Name="BilibiliCookieBox" x:FieldModifier="internal" />
                        <Button Content="导入并验证 Cookie" Style="{StaticResource SecondaryButton}" Padding="11,0" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding BilibiliDetails.ManualCookieCommand}" />
                        <TextBlock Text="不写入 settings.json，不出现在命令行、日志或诊断包中。" Style="{StaticResource FieldHint}" />
                    </StackPanel>
                </Border>
            </Expander>
            <Border Style="{StaticResource SurfaceCard}" Padding="14" Margin="0,0,0,16" CornerRadius="14">
                <StackPanel>
                    <TextBlock Text="会话状态" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="按聚合状态查看每个独立运行的 Session。" Style="{StaticResource FieldHint}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="目标" Foreground="{DynamicResource Text.Muted}" FontSize="13" />
                            <TextBlock Text="{Binding BilibiliDetails.ConfiguredSessions}" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="活动" Foreground="{DynamicResource Text.Muted}" FontSize="13" />
                            <TextBlock Text="{Binding BilibiliDetails.WatchingSessions}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Status.Success}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                            <TextBlock Text="连接中" Foreground="{DynamicResource Text.Muted}" FontSize="13" />
                            <TextBlock Text="{Binding BilibiliDetails.ConnectingSessions}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Accent.Primary}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="6,0,0,0">
                            <TextBlock Text="重连中" Foreground="{DynamicResource Text.Muted}" FontSize="13" />
                            <TextBlock Text="{Binding BilibiliDetails.RetryingSessions}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Status.Warning}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="6,0,0,0">
                            <TextBlock Text="失败" Foreground="{DynamicResource Text.Muted}" FontSize="13" />
                            <TextBlock Text="{Binding BilibiliDetails.FailedSessions}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Status.Error}" />
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="BilibiliSessionList" ItemsSource="{Binding BilibiliDetails.Sessions}" ItemTemplate="{StaticResource BilibiliSessionRowTemplate}" MinHeight="80" MaxHeight="320" Margin="0,8,0,0" x:FieldModifier="internal" />
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel Tag="workspace:activities"><Border Style="{DynamicResource HeroCard}" Padding="14"><StackPanel><WrapPanel><Button Content="开始观看" Command="{Binding BilibiliDetails.StartCommand}" Visibility="{Binding BilibiliDetails.LogoutVisibility}" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="停止" Command="{Binding BilibiliDetails.StopCommand}" Visibility="{Binding Bilibili.StopVisibility}" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,8"/><Button Content="刷新任务" Command="{Binding BilibiliDetails.RefreshCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="{Binding BilibiliDetails.WatchStateText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding BilibiliDetails.TaskStateText}" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>

            <Border Style="{StaticResource SurfaceCard}" Padding="14" Margin="0,0,0,16" CornerRadius="14">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="官方任务进度" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding BilibiliDetails.SessionSummary}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding BilibiliDetails.LastApiSuccessAt, StringFormat=最近成功 API：{0}}" Foreground="{DynamicResource Text.Muted}" FontSize="13" Margin="0,4,0,0" />
                    <ListBox x:Name="BilibiliTaskList" ItemsSource="{Binding BilibiliDetails.Tasks}" ItemTemplate="{StaticResource BilibiliTaskRowTemplate}" MinHeight="80" MaxHeight="800" Margin="0,8,0,0" x:FieldModifier="internal" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><ctrl:RewardTilePanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle></ListBox>
                    <TextBlock Text="尚未读取到官方任务进度。请先发现活动或填写 Task IDs。" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" Margin="8,10" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BilibiliDetails.Tasks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="奖励领取记录" Style="{StaticResource SectionTitle}" Margin="0,10,0,0" />
                    <ListBox ItemsSource="{Binding BilibiliDetails.Rewards}" MinHeight="34" MaxHeight="130" Margin="0,4,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,4">
                                    <DockPanel>
                                        <TextBlock Text="{Binding TaskName}" FontWeight="SemiBold" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{DynamicResource Accent.Primary}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Reward}" Foreground="{DynamicResource Text.Secondary}" FontSize="13" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Text.Muted}" FontSize="13" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border><Expander Header="活动与直播间 · 管理" IsExpanded="True" Margin="0,0,0,16"><Border Style="{StaticResource SurfaceCard}" Padding="14" Margin="0,0,0,16" CornerRadius="14">
                <StackPanel>
                    <TextBlock Text="活动与直播间" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="自动发现活动；也可手动指定 URL 或房间号。" Style="{StaticResource FieldHint}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BilibiliRoomInput" Style="{StaticResource HintTextBox}" Tag="直播间 URL 或 Room ID" Text="{Binding BilibiliDetails.RoomReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:FieldModifier="internal" />
                        <Button Grid.Column="1" Content="添加" Style="{StaticResource SecondaryButton}" Padding="11,0" Margin="6,0,0,0" Command="{Binding BilibiliDetails.AddRoomCommand}" />
                    </Grid>
                    <TextBox x:Name="BilibiliRoomNameInput" Style="{StaticResource HintTextBox}" Tag="直播间名称（可选）" Margin="0,6,0,0" Text="{Binding BilibiliDetails.RoomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:FieldModifier="internal" />
                    <ListBox x:Name="BilibiliRoomList" ItemsSource="{Binding BilibiliDetails.Rooms}" ItemTemplate="{StaticResource BilibiliRoomRowTemplate}" MinHeight="58" MaxHeight="170" Margin="0,8,0,0" x:FieldModifier="internal" />
                    <TextBlock Text="{Binding BilibiliDetails.Activities.Count, StringFormat=已发现活动：{0} 个}" Foreground="{DynamicResource Text.Secondary}" Margin="0,8,0,0" />
                    <ListBox x:Name="BilibiliActivityList" ItemsSource="{Binding BilibiliDetails.Activities}" ItemTemplate="{StaticResource BilibiliActivityRowTemplate}" MinHeight="42" MaxHeight="120" Margin="0,4,0,0" x:FieldModifier="internal" />
                </StackPanel>
            </Border></Expander>
        </StackPanel>
        <StackPanel Tag="workspace:settings">
            <Border x:Name="BilibiliSettingsCard" Style="{StaticResource SurfaceCard}" Padding="14" Margin="0,10,0,0" CornerRadius="14" x:FieldModifier="internal">
                <StackPanel>
                    <TextBlock Text="观看模式与任务设置" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="多线程模式控制每个直播间的 Session 数；每个 Session 独立连接并错峰启动。" Style="{StaticResource FieldHint}" />
                    <StackPanel>
                        <ctrl:SettingRow Title="观看模式" Description="标准模式或为每个直播间建立多个独立 Session。">
                            <ctrl:SettingRow.Editor>
                                <StackPanel>
                                    <ComboBox x:Name="BilibiliWatchModePicker" Style="{StaticResource ThemeComboBox}" SelectedValue="{Binding BilibiliDetails.WatchMode, Mode=TwoWay}" SelectedValuePath="Tag" x:FieldModifier="internal">
                                        <ComboBoxItem Content="标准模式（每房间 1 Session）" Tag="standard" />
                                        <ComboBoxItem Content="多线程加速模式" Tag="multi" />
                                    </ComboBox>
                                </StackPanel>
                            </ctrl:SettingRow.Editor>
                        </ctrl:SettingRow>
                        <ctrl:SettingRow Title="每房间并发 Session" Description="每个启用直播间各自建立的观看连接数量。">
                            <ctrl:SettingRow.Editor>
                                <StackPanel>
                                    <TextBox x:Name="BilibiliSessionsPerRoomText" Style="{StaticResource HintTextBox}" Tag="1" Text="{Binding BilibiliDetails.SessionsPerRoomText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:FieldModifier="internal" />
                                </StackPanel>
                            </ctrl:SettingRow.Editor>
                        </ctrl:SettingRow>
                        <ctrl:SettingRow Title="错峰重连延迟" Description="各 Session 错开启动和重连的等待时间。">
                            <ctrl:SettingRow.Editor>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="秒" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBox x:Name="BilibiliReconnectDelayText" Style="{StaticResource HintTextBox}" Tag="8" Text="{Binding BilibiliDetails.ReconnectDelayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:FieldModifier="internal" />
                                    </DockPanel>
                                </StackPanel>
                            </ctrl:SettingRow.Editor>
                        </ctrl:SettingRow>
                    </StackPanel>
                    <TextBlock Text="{Binding BilibiliDetails.SessionEstimateText}" Foreground="{DynamicResource Accent.Primary}" Margin="0,10,0,0" />
                    <StackPanel>
                        <ctrl:SettingRow Title="官方任务查询间隔" Description="查询官方进度的间隔；进度数值仍以平台返回为准。">
                            <ctrl:SettingRow.Editor>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="秒（至少 10）" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBox x:Name="BilibiliTaskIntervalText" Style="{StaticResource HintTextBox}" Tag="30" Text="{Binding BilibiliDetails.TaskIntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:FieldModifier="internal" />
                                    </DockPanel>
                                </StackPanel>
                            </ctrl:SettingRow.Editor>
                        </ctrl:SettingRow>
                        <ctrl:SettingRow Title="高级 Task IDs（可选）" Description="自动发现无法识别任务时使用，多个 ID 用逗号或空格分隔。">
                            <ctrl:SettingRow.Editor>
                                <StackPanel>
                                    <TextBox x:Name="BilibiliTaskIdsText" Style="{StaticResource HintTextBox}" Tag="多个 ID 用逗号或空格分隔" Text="{Binding BilibiliDetails.TaskIdsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:FieldModifier="internal" />
                                </StackPanel>
                            </ctrl:SettingRow.Editor>
                        </ctrl:SettingRow>
                    </StackPanel>
                    <TextBlock Text="{Binding BilibiliDetails.ProxyConfigurationText}" Foreground="{DynamicResource Status.Success}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="刷新 Session 详情" Style="{StaticResource SecondaryButton}" Padding="11,0" Margin="6,0,0,0" Command="{Binding BilibiliDetails.RefreshSessionsCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel Tag="workspace:network">
            <Border x:Name="BilibiliNetworkCard" Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Padding="10,8" Margin="0,10,0,0" x:FieldModifier="internal">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="前往网络设置" Style="{StaticResource SecondaryButton}" Padding="11,0" Margin="12,0,0,0" Click="OnOpenProxySettings" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="网络" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="使用范围在网络与维护分类设置" Foreground="{DynamicResource Text.Muted}" FontSize="13" Margin="12,1,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel Margin="0,5,0,0">
                        <TextBlock Text="{Binding BilibiliDetails.NetworkModeText}" Foreground="{DynamicResource Text.Secondary}" FontSize="13" Margin="0,0,12,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding BilibiliDetails.NetworkPolicyText}" Foreground="{DynamicResource Text.Muted}" FontSize="13" TextWrapping="Wrap" />
                    </WrapPanel>
                    <TextBlock Text="全局代理尚未启用/配置，哔哩哔哩当前使用直连。" Foreground="{DynamicResource Status.Warning}" FontSize="13" Margin="0,4,0,0" Visibility="{Binding BilibiliDetails.ProxyConfigurationWarningVisibility}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel Tag="workspace:automation">
            <Border Style="{StaticResource SectionCard}">
                <Grid behaviors:ResponsiveGrid.IsEnabled="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ctrl:SettingRow Title="启用哔哩哔哩" Description="更改后点击下方“保存设置”应用。" ReflowWidth="300" Grid.Row="0" Grid.Column="0">
                        <ctrl:SettingRow.Editor>
                            <CheckBox x:Name="BilibiliEnabledCheck" Style="{StaticResource SwitchCheckBox}" Content="" Margin="0" IsChecked="{Binding BilibiliDetails.Enabled, Mode=TwoWay}" x:FieldModifier="internal" Width="48" />
                        </ctrl:SettingRow.Editor>
                    </ctrl:SettingRow>
                    <ctrl:SettingRow Title="自动查询任务进度" Description="更改后点击下方“保存设置”应用。" ReflowWidth="300" Grid.Row="0" Grid.Column="1">
                        <ctrl:SettingRow.Editor>
                            <CheckBox x:Name="BilibiliAutoTaskProgress" Style="{StaticResource SwitchCheckBox}" Content="" Margin="0" IsChecked="{Binding BilibiliDetails.AutoTaskProgress, Mode=TwoWay}" x:FieldModifier="internal" Width="48" />
                        </ctrl:SettingRow.Editor>
                    </ctrl:SettingRow>
                    <ctrl:SettingRow Title="自动发现当前活动" Description="更改后点击下方“保存设置”应用。" ReflowWidth="300" Grid.Row="1" Grid.Column="0">
                        <ctrl:SettingRow.Editor>
                            <CheckBox x:Name="BilibiliAutoDiscoverCheck" Style="{StaticResource SwitchCheckBox}" Content="" Margin="0" IsChecked="{Binding BilibiliDetails.AutoDiscover, Mode=TwoWay}" x:FieldModifier="internal" Width="48" />
                        </ctrl:SettingRow.Editor>
                    </ctrl:SettingRow>
                    <ctrl:SettingRow Title="自动领取奖励" Description="更改后点击下方“保存设置”应用。" ReflowWidth="300" Grid.Row="1" Grid.Column="1">
                        <ctrl:SettingRow.Editor>
                            <CheckBox x:Name="BilibiliAutoClaimCheck" Style="{StaticResource SwitchCheckBox}" Content="" Margin="0" IsChecked="{Binding BilibiliDetails.AutoClaim, Mode=TwoWay}" x:FieldModifier="internal" Width="48" />
                        </ctrl:SettingRow.Editor>
                    </ctrl:SettingRow>
                    <ctrl:SettingRow Title="任务完成通知" Description="更改后点击下方“保存设置”应用。" ReflowWidth="300" Grid.Row="2" Grid.Column="0">
                        <ctrl:SettingRow.Editor>
                            <CheckBox x:Name="BilibiliTaskNotificationsCheck" Style="{StaticResource SwitchCheckBox}" Content="" Margin="0" IsChecked="{Binding BilibiliDetails.TaskNotifications, Mode=TwoWay}" x:FieldModifier="internal" Width="48" />
                        </ctrl:SettingRow.Editor>
                    </ctrl:SettingRow>
                    <ctrl:SettingRow Title="断线自动重连" Description="更改后点击下方“保存设置”应用。" ReflowWidth="300" Grid.Row="2" Grid.Column="1">
                        <ctrl:SettingRow.Editor>
                            <CheckBox x:Name="BilibiliReconnectCheck" Style="{StaticResource SwitchCheckBox}" Content="" IsChecked="{Binding BilibiliDetails.ReconnectEnabled, Mode=TwoWay}" Margin="0" x:FieldModifier="internal" Width="48" />
                        </ctrl:SettingRow.Editor>
                    </ctrl:SettingRow>
                    <ctrl:SettingRow Title="启动 CloudLight Blizzard 时自动恢复 Worker" Description="更改后点击下方“保存设置”应用。" ReflowWidth="300" Grid.Row="3" Grid.Column="0">
                        <ctrl:SettingRow.Editor>
                            <CheckBox x:Name="BilibiliAutoStart" Style="{StaticResource SwitchCheckBox}" Content="" Margin="0" IsChecked="{Binding BilibiliDetails.AutoRestore, Mode=TwoWay}" Click="OnAutoStartChanged" x:FieldModifier="internal" Width="48" />
                        </ctrl:SettingRow.Editor>
                    </ctrl:SettingRow>
                    <ctrl:SettingRow Title="上次正在掉宝时自动恢复掉宝" Description="更改后点击下方“保存设置”应用。" ReflowWidth="300" Grid.Row="3" Grid.Column="1">
                        <ctrl:SettingRow.Editor>
                            <CheckBox x:Name="BilibiliAutoResume" Style="{StaticResource SwitchCheckBox}" Content="" IsChecked="{Binding BilibiliDetails.AutoResume, Mode=TwoWay}" Click="OnAutoStartChanged" Margin="0" x:FieldModifier="internal" Width="48" />
                        </ctrl:SettingRow.Editor>
                    </ctrl:SettingRow>
                </Grid>
            </Border>
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="第三方通知" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                    <TextBlock Text="Gotify / Server 酱 URL（可选，保存后加密）" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                    <PasswordBox x:Name="BilibiliNotifierUrlBox" PasswordChanged="OnNotifierDraftChanged" x:FieldModifier="internal" />
                    <TextBlock Text="{Binding BilibiliDetails.NotifierText}" Style="{StaticResource FieldHint}" />
                    <TextBlock Text="地址通过原有凭据服务保存，界面不回显已保存的敏感内容。" TextWrapping="Wrap" Style="{StaticResource FieldHint}" />
                    <Button Content="清除第三方通知" Style="{StaticResource SecondaryButton}" Padding="11,0" Margin="6,0,0,0" Command="{Binding BilibiliDetails.ClearNotifierCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
