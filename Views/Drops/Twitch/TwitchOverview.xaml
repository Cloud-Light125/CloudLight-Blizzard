<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:behaviors="clr-namespace:CloudLightBlizzard.Behaviors" xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CloudLightBlizzard.Views.Drops.Twitch.TwitchOverview">
    <StackPanel>
        <Border x:Name="TwitchLoginCard" Style="{DynamicResource HeroCard}" Visibility="{Binding TwitchLoginCardVisibility}" Padding="12,8" Margin="0,0,0,6" Background="{DynamicResource AccSoft}" x:FieldModifier="internal">
            <Grid behaviors:ResponsiveGrid.IsEnabled="True" behaviors:ResponsiveGrid.Breakpoint="760">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <ctrl:PlatformIcon Platform="Twitch" Width="36" Height="36" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <WrapPanel VerticalAlignment="Center"><TextBlock Text="Twitch" FontSize="18" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBlock Text="{Binding TwitchVisual.AccountText}" FontSize="14" Margin="0,0,12,0"/><TextBlock Text="{Binding TwitchVisual.SessionText}" FontSize="12.5" Foreground="{DynamicResource Accent.Primary}" Margin="0,0,12,0"/><TextBlock Text="{Binding Twitch.WorkerHealth,StringFormat=Worker · {0}}" FontSize="12.5" Foreground="{DynamicResource Text.Secondary}" MaxWidth="150" TextTrimming="CharacterEllipsis" ToolTip="{Binding Twitch.WorkerHealth}"/></WrapPanel>
                        <TextBlock Text="{Binding TwitchInventory.CountText}" FontSize="12.5" Foreground="{DynamicResource Text.Secondary}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="开始观看" ctrl:WorkspaceAction.Name="legacy:OnStart" Tag="Twitch" IsEnabled="{Binding IsTwitchCoreAvailable}" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTwitchLoggedIn}" Value="True">
                                        <Setter Property="Visibility" Value="{Binding Twitch.StartVisibility}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="停止观看" ctrl:WorkspaceAction.Name="legacy:OnStop" Tag="Twitch" Visibility="{Binding Twitch.StopVisibility}" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0" />
                    <Button x:Name="TwitchRefreshButton" Content="刷新进度" ctrl:WorkspaceAction.Name="legacy:OnRefresh" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0" x:FieldModifier="internal" />
                    <Button Content="设置" ctrl:WorkspaceAction.Name="section:settings" Style="{DynamicResource SecondaryButton}" />
                    <Button Content="调整观看优先级" ctrl:WorkspaceAction.Name="twitch:priority" Style="{DynamicResource SecondaryButton}" Margin="8,0,0,0"/>
                </WrapPanel>
            </Grid>
        </Border>
        <TextBlock Text="{Binding TwitchInventory.PrioritySummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TwitchInventory.PrioritySummary}" Margin="0,0,0,10"/>
        <TextBlock Text="已优先选择符合条件的频道，但 Twitch 实际进度以官方返回为准。" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource Text.Secondary}"/>
        <Grid behaviors:ResponsiveGrid.IsEnabled="True" behaviors:ResponsiveGrid.Breakpoint="850">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="{Binding TwitchLoginVisibility}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TwitchAuthorizationVisibility}" Value="Visible">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{DynamicResource HeroCard}" Margin="0,0,16,16">
                <StackPanel HorizontalAlignment="Center" MaxWidth="500" Margin="12,16">
                    <Border x:Name="LoginIllustration" Background="{DynamicResource AccSoft}" CornerRadius="28" Padding="30" HorizontalAlignment="Center">
                        <ctrl:PlatformIcon Platform="Twitch" Width="86" Height="86" />
                    </Border>
                    <TextBlock x:Name="LoginHeadline" Text="连接账号，开始收集奖励" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" Margin="0,24,0,10" />
                    <TextBlock x:Name="TwitchIntro" Text="通过 Twitch 官方设备授权连接账号。活动、奖励与观看进度将在这里汇集。" Style="{DynamicResource VisualCaption}" TextAlignment="Center" x:FieldModifier="internal" />
                    <Button x:Name="TwitchLoginAction" Content="{Binding TwitchLoginButtonText}" IsEnabled="{Binding CanTwitchLogin}" ctrl:WorkspaceAction.Name="legacy:OnTwitchLogin" Style="{DynamicResource PrimaryButton}" MinWidth="230" HorizontalAlignment="Center" Margin="0,24,0,16" x:FieldModifier="internal" />
                    <TextBlock Text="1  连接 Twitch    →    2  选择偏好    →    3  开始观看" FontSize="13" Foreground="{DynamicResource Accent.Primary}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{DynamicResource HeroCard}">
                <StackPanel>
                    <TextBlock Text="连接与准备" Style="{DynamicResource VisualHeading}" />
                    <TextBlock Text="{Binding Twitch.Status}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,8" />
                    <TextBlock Text="{Binding Twitch.Summary}" Style="{DynamicResource VisualCaption}" />
                    <Button Content="配置诊断与恢复" Visibility="{Binding TwitchConfigRepairVisibility}" ctrl:WorkspaceAction.Name="section:network" Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    <Separator Margin="0,16" />
                    <TextBlock Text="网络与代理" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding NetworkProxyStatus}" Style="{DynamicResource VisualCaption}" Margin="0,8,0,16" />
                    <TextBlock Text="本地 Session" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TwitchVisual.SessionText}" Style="{DynamicResource VisualCaption}" Margin="0,8,0,16" />
                    <WrapPanel>
                        <Button Content="重新检测" Visibility="{Binding TwitchRetryVisibility}" ctrl:WorkspaceAction.Name="legacy:OnTwitchRetry" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,8" />
                        <Button Content="网络测试" ctrl:WorkspaceAction.Name="legacy:OnNetworkCheck" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,8" />
                        <Button Content="使用帮助" Tag="Twitch" ctrl:WorkspaceAction.Name="legacy:OnToggleHelp" Style="{DynamicResource SecondaryButton}" Margin="0,0,0,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Border Style="{DynamicResource HeroCard}" Visibility="{Binding TwitchAuthorizationVisibility}">
            <Grid behaviors:ResponsiveGrid.IsEnabled="True" behaviors:ResponsiveGrid.Breakpoint="700">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="8,8,28,8">
                    <DockPanel>
                        <ctrl:PlatformIcon Platform="Twitch" Width="42" Height="42" Margin="0,0,14,0" />
                        <TextBlock Text="连接 Twitch" FontSize="26" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Text="在官方页面完成授权后，这里会自动继续。" Style="{DynamicResource VisualCaption}" Margin="0,14,0,24" />
                    <TextBlock Text="01  复制完整设备授权码" FontSize="16" FontWeight="SemiBold" />
                    <Border Background="{DynamicResource AccSoft}" CornerRadius="12" Padding="18" Margin="0,12,0,22">
                        <DockPanel>
                            <Button x:Name="TwitchCopyCodeButton" Content="复制" DockPanel.Dock="Right" ctrl:WorkspaceAction.Name="legacy:OnCopyTwitchAuthorizationCode" Style="{DynamicResource SecondaryButton}" x:FieldModifier="internal" />
                            <TextBox x:Name="TwitchAuthorizationCodeBox" Text="{Binding TwitchAuthorizationCode,Mode=OneWay}" IsReadOnly="True" FontSize="27" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Accent.Primary}" VerticalContentAlignment="Center" x:FieldModifier="internal" />
                        </DockPanel>
                    </Border>
                    <TextBlock Text="02  打开 Twitch 官方授权页面" FontSize="16" FontWeight="SemiBold" />
                    <Button Content="打开官方授权页面 ↗" ctrl:WorkspaceAction.Name="legacy:OnOpenTwitchAuthorization" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,22" />
                    <TextBlock Text="03  输入设备码，完成官方授权" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource App.SurfaceAlt}" CornerRadius="12" Padding="24">
                    <StackPanel VerticalAlignment="Center">
                        <ctrl:PlatformIcon Platform="Twitch" Width="66" Height="66" HorizontalAlignment="Center" />
                        <TextBlock Text="等待官方授权" FontSize="21" FontWeight="SemiBold" TextAlignment="Center" Margin="0,20,0,12" />
                        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,8,0,18" />
                        <TextBlock Text="{Binding TwitchAuthorizationRemainingText}" FontSize="17" Foreground="{DynamicResource Accent.Primary}" TextAlignment="Center" />
                        <TextBlock Text="{Binding TwitchAuthorizationExpiryText}" Style="{DynamicResource VisualCaption}" TextAlignment="Center" Margin="0,10,0,22" />
                        <Button Content="取消授权" ctrl:WorkspaceAction.Name="legacy:OnCancelTwitchAuthorization" Style="{DynamicResource SecondaryButton}" Margin="0,0,0,10" />
                        <Button Content="重新获取授权码" ctrl:WorkspaceAction.Name="legacy:OnRenewTwitchAuthorization" Style="{DynamicResource SecondaryButton}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <StackPanel Visibility="{Binding TwitchAuthenticatedVisibility}">
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="显示范围：" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="OverviewScopePicker" Width="242" SelectedValuePath="Tag" SelectedValue="{Binding TwitchInventory.OverviewScope,Mode=TwoWay}" Style="{DynamicResource ThemeComboBox}" Margin="0,0,12,0">
                    <ComboBoxItem Content="全部活动（优先游戏置顶）" Tag="all"/>
                    <ComboBoxItem Content="仅显示优先游戏" Tag="priority"/>
                </ComboBox>
                <TextBlock Text="{Binding TwitchInventory.OverviewHint}" FontSize="12.5" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="设置优先游戏 →" ctrl:WorkspaceAction.Name="section:games" Visibility="{Binding TwitchInventory.PrioritySetupVisibility}" Style="{DynamicResource SecondaryButton}" MinHeight="32" Padding="8,0"/>
            </WrapPanel>
            <Border x:Name="TwitchCurrentProgressCard" x:FieldModifier="internal" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="12" Padding="10,6" Margin="0,0,0,8">
                <Grid behaviors:ResponsiveGrid.IsEnabled="True" behaviors:ResponsiveGrid.Breakpoint="680"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <WrapPanel><TextBlock Text="{Binding TwitchInventory.WatchState}" FontSize="16" FontWeight="SemiBold" Margin="0,0,16,0"/><TextBlock Text="{Binding TwitchInventory.Game}" FontSize="13" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,12,0"/><TextBlock Text="{Binding TwitchInventory.Channel}" FontSize="13" Foreground="{DynamicResource Text.Secondary}"/></WrapPanel>
                        <TextBlock Text="{Binding TwitchInventory.CurrentSummary}" Visibility="{Binding TwitchInventory.CurrentSummaryVisibility}" FontSize="13.5" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <WrapPanel Margin="0,4,0,0"><TextBlock Text="{Binding TwitchInventory.SyncText}" FontSize="12.5" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,16,0"/><TextBlock Text="{Binding TwitchInventory.EstimateText}" FontSize="12.5" Foreground="{DynamicResource Text.Secondary}"/></WrapPanel>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" Margin="12,4,0,0" VerticalAlignment="Center"><Button Content="直播间 ↗" ctrl:WorkspaceAction.Name="legacy:OnOpenCurrentWatch" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0"/><Button Content="切换频道" ctrl:WorkspaceAction.Name="twitch:channels" Style="{DynamicResource SecondaryButton}"/></WrapPanel>
                </Grid>
            </Border>
            <StackPanel Visibility="{Binding TwitchInventory.OverviewEmptyVisibility}" Margin="12,16">
                <TextBlock Text="{Binding TwitchInventory.OverviewEmptyText}" FontSize="15" TextWrapping="Wrap"/>
                <Button Content="查看全部活动 →" ctrl:WorkspaceAction.Name="twitch:overview-all" Visibility="{Binding TwitchInventory.ViewAllVisibility}" Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>
            <ctrl:CampaignInventoryView ItemsSource="{Binding TwitchInventory.OverviewGroups}" IsOverview="True"><ctrl:CampaignInventoryView.Style><Style TargetType="ctrl:CampaignInventoryView"><Style.Triggers><DataTrigger Binding="{Binding TwitchInventory.OverviewGroups.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ctrl:CampaignInventoryView.Style></ctrl:CampaignInventoryView>
        </StackPanel>
        <Border x:Name="TwitchHelp" Visibility="Collapsed" Style="{DynamicResource HeroCard}" x:FieldModifier="internal">
            <TextBlock Text="连接 Twitch → 设置优先游戏 → 开始观看。官方进度由 Twitch 确认；本地观察与请求成功不等于奖励已计入。网络、账号与高级维护可通过上方分类访问。" Style="{DynamicResource VisualBody}" />
        </Border>
        <Expander Header="{Binding TwitchQuickStart.Summary}" IsExpanded="{Binding TwitchQuickStart.IsExpanded,Mode=TwoWay}" Margin="0,8,0,16">
            <StackPanel Margin="8,12">
                <ItemsControl ItemsSource="{Binding TwitchQuickStart.Steps}" ItemTemplate="{DynamicResource QuickStartStepTemplate}" />
                <TextBlock Text="{Binding TwitchDataSourceText}" Style="{DynamicResource VisualCaption}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding TwitchNetworkRouteText}" Style="{DynamicResource VisualCaption}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding TwitchRefreshStatus}" Style="{DynamicResource VisualCaption}" Margin="0,6,0,0" Visibility="{Binding TwitchRefreshStatusVisibility}" />
                <TextBlock Text="{Binding TwitchRetryStatusText}" Style="{DynamicResource VisualCaption}" Margin="0,6,0,0" Visibility="{Binding TwitchRetryStatusVisibility}" />
                <TextBlock Text="{Binding TwitchLastSuccessText}" Style="{DynamicResource VisualCaption}" Margin="0,6,0,0" Visibility="{Binding TwitchLastSuccessVisibility}" />
                <Button Content="立即重试" Visibility="{Binding TwitchRetryNowVisibility}" ctrl:WorkspaceAction.Name="legacy:OnTwitchRetryNow" Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                <Button Content="使用帮助" ctrl:WorkspaceAction.Name="legacy:OnToggleHelp" Tag="Twitch" Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
            </StackPanel>
        </Expander>
        <ProgressBar Height="4" Width="96" HorizontalAlignment="Left" IsIndeterminate="True" Visibility="{Binding TwitchRefreshProgressVisibility}" Style="{DynamicResource ThemeProgressBar}" />
    </StackPanel>
</UserControl>
