<UserControl x:Class="CloudLightBlizzard.Views.Drops.Soop.SoopCampaignPanel" x:Name="Panel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:CloudLightBlizzard.Controls" xmlns:local="clr-namespace:CloudLightBlizzard.Views.Drops.Soop" xmlns:visual="clr-namespace:CloudLightBlizzard.ViewModels.Visuals">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type local:SoopGameView}">
            <Border Background="{DynamicResource App.SurfaceAlt}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="12" Padding="8" Margin="0,4,0,8" AllowDrop="True" Drop="OnDrop" PreviewMouseMove="OnDrag">
                <DockPanel LastChildFill="True">
                    <WrapPanel DockPanel.Dock="Right" Visibility="{Binding EditVisibility,ElementName=Panel}">
                        <Button Content="置顶" Tag="-99" Click="OnMove" Style="{DynamicResource SecondaryButton}" Margin="3,0"/>
                        <Button Content="↑" Tag="-1" Click="OnMove" Style="{DynamicResource SecondaryButton}" Margin="3,0" ToolTip="上移游戏"/>
                        <Button Content="↓" Tag="1" Click="OnMove" Style="{DynamicResource SecondaryButton}" Margin="3,0" ToolTip="下移游戏"/>
                    </WrapPanel>
                    <CheckBox DockPanel.Dock="Right" Content="加入队列" IsChecked="{Binding Selected,Mode=TwoWay}" Visibility="{Binding EditVisibility,ElementName=Panel}" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource Text.Primary}"/>
                    <Button Click="OnExpandGame" Style="{DynamicResource SecondaryButton}" Height="Auto" MinHeight="42"
                            HorizontalContentAlignment="Stretch" Padding="10,6" AutomationProperties.Name="{Binding Name}">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right" Style="{DynamicResource StatusBadge}" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="{Binding Source.PriorityText}" Foreground="{DynamicResource Accent.Primary}" FontSize="12" />
                            </Border>
                            <Viewbox DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Stroke="{DynamicResource Text.Secondary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="M4,2 L10,8 L4,14" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Expanded}" Value="True">
                                                    <Setter Property="Data" Value="M2,4 L8,10 L14,4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Viewbox>
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                                <Run Text="{Binding Name,Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                                <Run Text=" · " Foreground="{DynamicResource Text.Secondary}"/>
                                <Run Text="{Binding Counts,Mode=OneWay}" FontSize="13" Foreground="{DynamicResource Text.Secondary}"/>
                            </TextBlock>
                        </DockPanel>
                    </Button>
                </DockPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type visual:SoopCampaign}">
            <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10" HorizontalAlignment="Left" AllowDrop="True" Drop="OnDrop" PreviewMouseMove="OnDrag" Tag="SoopCampaignGroup">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="MaxWidth" Value="1060" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RewardCount}" Value="1"><Setter Property="MaxWidth" Value="650" /></DataTrigger>
                            <DataTrigger Binding="{Binding RewardCount}" Value="0"><Setter Property="MaxWidth" Value="650" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <WrapPanel DockPanel.Dock="Right" Visibility="{Binding EditVisibility,ElementName=Panel}">
                            <Button Content="置顶" Tag="-99" Click="OnMove" Style="{DynamicResource SecondaryButton}" Margin="3,0"/>
                            <Button Content="↑" Tag="-1" Click="OnMove" Style="{DynamicResource SecondaryButton}" Margin="3,0"/>
                            <Button Content="↓" Tag="1" Click="OnMove" Style="{DynamicResource SecondaryButton}" Margin="3,0"/>
                        </WrapPanel>
                        <Button Content="活动详情 →" DockPanel.Dock="Right" Click="OnCampaignDetails" Style="{DynamicResource SecondaryButton}" MinHeight="32" FontSize="13" Margin="8,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="48" ToolTip="{Binding Title}"/>
                            <WrapPanel Margin="0,6,0,0">
                                <Border Style="{DynamicResource StatusBadge}" Background="{DynamicResource App.SurfaceAlt}" Margin="0,0,6,0"><TextBlock Text="{Binding DisplayType}" FontSize="12"/></Border>
                                <Border Style="{DynamicResource StatusBadge}" Margin="0,0,8,0"><TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Accent.Primary}"/></Border>
                                <TextBlock Text="{Binding PlanText}" Style="{DynamicResource VisualCaption}" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding TimeText}" FontSize="12.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <WrapPanel Margin="0,3,0,6">
                        <CheckBox Content="参与此活动（保存后生效）" IsChecked="{Binding Selected,Mode=TwoWay}" Visibility="{Binding EditVisibility,ElementName=Panel}" Foreground="{DynamicResource Text.Primary}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding ActiveEligibility}" FontSize="12.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Rewards}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:RewardTilePanel MinimumTileWidth="286" MaximumTileWidth="340" StretchSparseRows="True"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><c:RewardCard Reward="{Binding Visual}" Title="{Binding Name}" ImageUrl="{Binding ImageUrl}" Compact="True"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Border Style="{DynamicResource SurfaceCard}" Margin="0,4,0,0" Padding="14,10,10,0">
        <Grid x:Name="LayoutRoot">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel x:Name="Filters" Margin="0,0,8,8">
                <TextBlock Text="{Binding Heading,ElementName=Panel}" Style="{DynamicResource SectionTitle}"/>
                <TextBlock Text="{Binding Model.ModeNotice,ElementName=Panel}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,8"/>
                <TextBlock Text="在观看配置里，可按 Shift 并滚动来浏览此列表。" Visibility="{Binding EditVisibility,ElementName=Panel}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" Margin="0,0,0,8"/>
                <WrapPanel Margin="0,4,0,8">
                    <TextBlock Text="账号" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="150" ItemsSource="{Binding Model.Accounts,ElementName=Panel}" SelectedItem="{Binding Model.Account,ElementName=Panel,Mode=TwoWay}" Style="{DynamicResource ThemeComboBox}"/>
                    <TextBox x:Name="Search" Width="190" Style="{DynamicResource HintTextBox}" Tag="搜索游戏或活动" TextChanged="OnSearch" Margin="8,0"/>
                    <ComboBox x:Name="Scope" Width="205" SelectionChanged="OnFilter" SelectedIndex="{Binding Model.DisplayScope,ElementName=Panel,Mode=TwoWay}" Style="{DynamicResource ThemeComboBox}">
                        <ComboBoxItem Content="全部活动，已选游戏置顶"/><ComboBoxItem Content="仅显示已选游戏"/><ComboBoxItem Content="可参与游戏"/>
                    </ComboBox>
                </WrapPanel>
                <WrapPanel Visibility="{Binding EditVisibility,ElementName=Panel}" Margin="0,0,0,8">
                    <CheckBox Content="仅观看勾选的游戏与活动" IsChecked="{Binding Model.ExplicitSelection,ElementName=Panel,Mode=TwoWay}" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Width="200" Style="{DynamicResource ThemeComboBox}" SelectedIndex="{Binding Model.Strategy,ElementName=Panel,Mode=TwoWay}">
                        <ComboBoxItem Content="用户自定义顺序"/><ComboBoxItem Content="最早结束"/><ComboBoxItem Content="最短剩余观看时间"/><ComboBoxItem Content="完成度最高"/><ComboBoxItem Content="完成度最低"/>
                    </ComboBox>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,8">
                    <ComboBox x:Name="Lifecycle" Width="150" SelectionChanged="OnFilter" SelectedIndex="0" Style="{DynamicResource ThemeComboBox}"><ComboBoxItem Content="全部生命周期"/><ComboBoxItem Content="进行中"/><ComboBoxItem Content="已安排"/><ComboBoxItem Content="已结束"/></ComboBox>
                    <ComboBox x:Name="Kind" Width="150" Margin="8,0" SelectionChanged="OnFilter" SelectedIndex="0" Style="{DynamicResource ThemeComboBox}"><ComboBoxItem Content="全部类型"/><ComboBoxItem Content="随机 / 抽奖型"/><ComboBoxItem Content="任务 / 固定型"/></ComboBox>
                    <Button Content="展开筛选结果" Click="OnExpandAll" Style="{DynamicResource SecondaryButton}" MinHeight="32" FontSize="13"/>
                    <Button Content="折叠全部" Click="OnCollapseAll" Style="{DynamicResource SecondaryButton}" MinHeight="32" FontSize="13" Margin="8,0,0,0"/>
                </WrapPanel>
                <TextBlock Text="选择与排序后点击页面底部“保存设置”。可拖动游戏或同游戏内的活动；取消勾选保留顺序。" Visibility="{Binding EditVisibility,ElementName=Panel}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" Margin="0,0,0,8"/>
            </StackPanel>
            <!-- Bounded, flat game headers + activity rows allow pixel recycling even inside the workspace ScrollViewer. -->
            <ListBox x:Name="GameList" Grid.Row="1" Height="{Binding ListHeight,ElementName=Panel}" Background="{DynamicResource App.Surface}" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0.5">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="PageScroll" Focusable="False" Background="{TemplateBinding Background}"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock x:Name="Empty" Grid.Row="2" Text="暂无匹配的官方活动。请刷新账号；已保存的队列将保留。" Foreground="{DynamicResource Text.Muted}" Margin="0,12" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</UserControl>
