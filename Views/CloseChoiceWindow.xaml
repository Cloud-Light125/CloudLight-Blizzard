<Window x:Class="CloudLightBlizzard.CloseChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls"
        Title="关闭窗口时" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="352" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <!-- 选项卡(单选)-->
        <Style x:Key="OptCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" BorderBrush="{DynamicResource BtnBd}" BorderThickness="1" CornerRadius="10"
                                Padding="11,10" Background="Transparent">
                            <DockPanel>
                                <Grid DockPanel.Dock="Left" Width="15" Height="15" Margin="0,1,10,0" VerticalAlignment="Top">
                                    <Ellipse x:Name="ring" Stroke="{DynamicResource TgOff}" StrokeThickness="1.5" />
                                    <Ellipse x:Name="dot" Width="7" Height="7" Fill="{DynamicResource Acc}" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Acc}" />
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccSoft}" />
                                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Acc}" />
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 复选 -->
        <Style x:Key="Ck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="15" Height="15" CornerRadius="4" Background="Transparent"
                                    BorderBrush="{DynamicResource TgOff}" BorderThickness="1.5" VerticalAlignment="Center">
                                <ctrl:IconView x:Name="ck" Geometry="{StaticResource GeoCheck}" Stroke="{DynamicResource OnAcc}" Thickness="3" IconSize="11" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="7,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Acc}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Acc}" />
                                <Setter TargetName="ck" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Win}" CornerRadius="12" Margin="16"
            BorderBrush="{DynamicResource Bd}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="15,13,15,0" MouseLeftButtonDown="OnDrag">
                <StackPanel Orientation="Horizontal">
                    <ctrl:IconView Geometry="{StaticResource GeoTray}" Stroke="{DynamicResource Acc}" Thickness="2" IconSize="15" Margin="0,0,8,0" />
                    <TextBlock Text="关闭窗口时…" Foreground="{DynamicResource Tx1}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource TitleIconButton}" HorizontalAlignment="Right" Click="OnCancel" Width="26" Height="26">
                    <ctrl:IconView Geometry="{StaticResource GeoX}" Stroke="{DynamicResource Tx3}" Thickness="2" IconSize="14" />
                </Button>
            </Grid>

            <StackPanel Margin="15,12,15,0">
                <RadioButton x:Name="OptTray" Style="{StaticResource OptCard}" GroupName="close" IsChecked="True">
                    <StackPanel>
                        <TextBlock Text="最小化到托盘(推荐)" Foreground="{DynamicResource Tx1}" FontWeight="Medium" FontSize="12.5" />
                        <TextBlock Text="程序留在后台,切号更快,右下角随时唤出" Foreground="{DynamicResource Tx3}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="OptExit" Style="{StaticResource OptCard}" GroupName="close">
                    <StackPanel>
                        <TextBlock Text="直接退出程序" Foreground="{DynamicResource Tx1}" FontWeight="Medium" FontSize="12.5" />
                        <TextBlock Text="完全关闭,下次使用需重新打开" Foreground="{DynamicResource Tx3}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
                <CheckBox x:Name="Remember" Style="{StaticResource Ck}" IsChecked="True" Margin="2,4,0,0">
                    <TextBlock Text="记住我的选择,可在设置中更改" Foreground="{DynamicResource Tx2}" FontSize="12" />
                </CheckBox>
            </StackPanel>

            <Grid Margin="15,16,15,15">
                <Button Style="{StaticResource AccentButton}" Height="34" Padding="18,0" HorizontalAlignment="Right"
                        Click="OnConfirm" Content="确定" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
