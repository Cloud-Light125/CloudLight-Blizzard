<Window x:Class="CloudLightBlizzard.Views.Step4ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="可选：进一步验证区服文件" Width="620" Height="330" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource Text.Primary}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="当前区服备份已经可以正常使用" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock x:Name="TargetText" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="21"/>
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="21"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="如果这次切换到另一地区后执行一次可选的第四步验证，CloudLight Blizzard 可以进一步确认哪些文件是真正稳定的区服差异，并排除少量可能由游戏运行产生的动态文件。&#10;&#10;第四步失败不会影响本次切换，也不会破坏当前可用备份。"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
            <Button Content="永久忽略此提醒" Style="{StaticResource SecondaryButton}" Padding="13,0" Margin="0,0,8,0" Click="OnIgnore"/>
            <Button Content="仅切换" Style="{StaticResource SecondaryButton}" Padding="13,0" Margin="0,0,8,0" Click="OnSwitchOnly"/>
            <Button Content="切换并进行第四步验证" Style="{StaticResource PrimaryButton}" Padding="13,0" Click="OnVerify"/>
        </WrapPanel>
    </Grid>
</Window>
