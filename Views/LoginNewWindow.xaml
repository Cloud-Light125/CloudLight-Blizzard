<Window x:Class="CloudLightBlizzard.LoginNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls"
        Title="登录新号" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="352" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Border Background="{DynamicResource Win}" CornerRadius="12" Margin="16"
            BorderBrush="{DynamicResource Bd}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="15,13,15,0" MouseLeftButtonDown="OnDrag">
                <StackPanel Orientation="Horizontal">
                    <ctrl:IconView Geometry="{StaticResource GeoUser}" Stroke="{DynamicResource Acc}" Thickness="2" IconSize="15" Margin="0,0,8,0" />
                    <TextBlock Text="登录新号" Foreground="{DynamicResource Tx1}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource TitleIconButton}" HorizontalAlignment="Right" Click="OnCancel" Width="26" Height="26">
                    <ctrl:IconView Geometry="{StaticResource GeoX}" Stroke="{DynamicResource Tx3}" Thickness="2" IconSize="14" />
                </Button>
            </Grid>

            <StackPanel Margin="15,10,15,0">
                <TextBlock Foreground="{DynamicResource Tx2}" FontSize="12.5" TextWrapping="Wrap" LineHeight="20">
                    <Run Text="即将回到 Battle.net 登录页，登录一个" /><Run Text="新账号" Foreground="{DynamicResource Tx1}" FontWeight="SemiBold" /><Run Text="。登录成功后回来点击「保存当前账号」即可收录。" />
                </TextBlock>
                <Border Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnBd}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,9,0,0">
                    <DockPanel>
                        <ctrl:IconView DockPanel.Dock="Left" Geometry="{StaticResource GeoWarn}" Stroke="{DynamicResource WarnIc}" Thickness="2" IconSize="14"
                                       VerticalAlignment="Top" Margin="0,1,8,0" />
                        <TextBlock Text="不要在 Battle.net 里点击「退出登录」，否则下次可能需要重新验证。本工具只引导登录，不会替你退出其他账号。"
                                   Foreground="{DynamicResource WarnTx}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <Grid Margin="15,14,15,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Height="32" Padding="16,0" Margin="0,0,8,0" Click="OnCancel" Content="取消" FontSize="12.5" />
                    <Button Style="{StaticResource AccentButton}" Height="32" Padding="18,0" Click="OnConfirm" Content="继续" FontSize="12.5" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
