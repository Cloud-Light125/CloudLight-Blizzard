<Window x:Class="CloudLightBlizzard.AccountSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号设置" Width="460" Height="410" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource App.Background}" Foreground="{DynamicResource Text.Primary}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="账号设置" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="名称和备注只保存在本机。账号区服会用于自动联动守望先锋文件。" TextWrapping="Wrap" Foreground="{DynamicResource Tx2}" Margin="0,5,0,12"/>
            <TextBlock x:Name="BattleTagText" Opacity="0.65" Margin="0,3,0,18"/>
            <TextBlock Text="自定义名称" FontWeight="SemiBold"/>
            <TextBox x:Name="CustomNameBox" Style="{StaticResource InputBox}" Margin="0,5,0,14" MaxLength="60"/>
            <TextBlock Text="备注" FontWeight="SemiBold"/>
            <TextBox x:Name="RemarkBox" Style="{StaticResource InputBox}" Margin="0,5,0,14" MaxLength="200"/>
            <TextBlock Text="区服" FontWeight="SemiBold"/>
            <ComboBox x:Name="RegionBox" Style="{StaticResource ThemeComboBox}" Margin="0,5,0,0" Padding="6">
                <ComboBoxItem Content="自动识别" Tag="Auto"/>
                <ComboBoxItem Content="国服" Tag="China"/>
                <ComboBoxItem Content="国际服" Tag="International"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource GhostButton}" Width="84" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="保存" Style="{StaticResource AccentButton}" Width="84" IsDefault="True" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
