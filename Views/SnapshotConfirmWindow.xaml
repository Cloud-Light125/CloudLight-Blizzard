<Window x:Class="BnetSwitch.SnapshotConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:BnetSwitch.Controls"
        Title="更新账号备份" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="344" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Border Background="{DynamicResource Win}" CornerRadius="12" Margin="16"
            BorderBrush="{DynamicResource Bd}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="15,13,15,0" MouseLeftButtonDown="OnDrag">
                <StackPanel Orientation="Horizontal">
                    <ctrl:IconView Geometry="{StaticResource GeoCam}" Stroke="{DynamicResource Acc}" Thickness="2" IconSize="15" Margin="0,0,8,0" />
                    <TextBlock Text="更新账号备份" Foreground="{DynamicResource Tx1}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource TitleIconButton}" HorizontalAlignment="Right" Click="OnCancel" Width="26" Height="26">
                    <ctrl:IconView Geometry="{StaticResource GeoX}" Stroke="{DynamicResource Tx3}" Thickness="2" IconSize="14" />
                </Button>
            </Grid>

            <StackPanel Margin="15,10,15,0">
                <TextBlock Foreground="{DynamicResource Tx2}" FontSize="12.5" TextWrapping="Wrap">
                    <Run Text="将更新 " /><Run x:Name="NameRun" Foreground="{DynamicResource Tx1}" FontWeight="SemiBold" /><Run Text=" 的本地账号备份。" />
                </TextBlock>
                <Border Background="{DynamicResource Body}" CornerRadius="8" Padding="11,9" Margin="0,9,0,0">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,3"><Run Text="1. " Foreground="{DynamicResource Acc}" FontWeight="SemiBold" /><Run Text="自动关闭战网客户端" Foreground="{DynamicResource Tx2}" /></TextBlock>
                        <TextBlock Margin="0,0,0,3"><Run Text="2. " Foreground="{DynamicResource Acc}" FontWeight="SemiBold" /><Run Text="保存当前账号配置" Foreground="{DynamicResource Tx2}" /></TextBlock>
                        <TextBlock><Run Text="3. " Foreground="{DynamicResource Acc}" FontWeight="SemiBold" /><Run Text="自动重新启动战网" Foreground="{DynamicResource Tx2}" /></TextBlock>
                    </StackPanel>
                </Border>
                <TextBlock Text="完成后即可从账号列表快速切换回来。" Foreground="{DynamicResource Tx3}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <Grid Margin="15,14,15,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Height="32" Padding="16,0" Margin="0,0,8,0" Click="OnCancel" Content="取消" FontSize="12.5" />
                    <Button Style="{StaticResource AccentButton}" Height="32" Padding="16,0" Click="OnConfirm" FontSize="12.5">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:IconView Geometry="{StaticResource GeoCam}" Stroke="{DynamicResource OnAcc}" Thickness="2" IconSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="开始保存" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
