<UserControl x:Class="CloudLightBlizzard.Views.Dashboard.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:CloudLightBlizzard.Controls" xmlns:b="clr-namespace:CloudLightBlizzard.Behaviors">
    <ScrollViewer Background="{DynamicResource App.Background}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,24,28,24">
        <c:PageHeader Title="总览" Description="账号、游戏与正在进行的奖励，在这里汇集。"/>
        <Grid Margin="0,24,0,16" b:ResponsiveGrid.IsEnabled="True"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{DynamicResource HeroCard}" Background="{DynamicResource AccSoft}" Margin="0,0,16,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/></Grid.ColumnDefinitions><c:PlatformIcon Platform="BattleNet" Width="48" Height="48" VerticalAlignment="Top" HorizontalAlignment="Left"/><StackPanel Grid.Column="1"><TextBlock Text="BATTLE.NET" FontSize="13" Foreground="{DynamicResource Text.Secondary}"/><TextBlock Text="{Binding CurrentAccount.DisplayName,TargetNullValue=尚未检测到当前账号,FallbackValue=尚未检测到当前账号}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,8" TextWrapping="Wrap"/><TextBlock Text="{Binding ReadyCountText}" FontSize="14"/><TextBlock Text="本地账号指向 · 认证以 Battle.net 为准" Style="{DynamicResource VisualCaption}" Margin="0,5,0,16"/><Button Content="管理账号 →" Tag="accounts" Click="OnNavigate" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></Grid></Border>
            <Border Grid.Column="1" Style="{DynamicResource HeroCard}" Margin="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/></Grid.ColumnDefinitions><c:PlatformIcon Platform="Overwatch" Width="48" Height="48" VerticalAlignment="Top" HorizontalAlignment="Left"/><StackPanel Grid.Column="1"><TextBlock Text="OVERWATCH" FontSize="13" Foreground="{DynamicResource Text.Secondary}"/><TextBlock Text="{Binding GameRegionTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,8" TextWrapping="Wrap"/><TextBlock Text="{Binding GameRegionSummary}" Style="{DynamicResource VisualCaption}"/><TextBlock Text="{Binding GameRegionPath}" FontSize="13" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,5,0,16"/><Button Content="游戏与区服 →" Tag="region" Click="OnNavigate" Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Left"/></StackPanel></Grid></Border>
        </Grid>
        <DockPanel Margin="0,8,0,14"><TextBlock Text="掉宝任务工作台" Style="{DynamicResource VisualHeading}"/><TextBlock Text="各平台独立状态 · 官方进度单独确认" FontSize="13" Foreground="{DynamicResource Text.Secondary}" HorizontalAlignment="Right"/></DockPanel>
        <ItemsControl x:Name="PlatformStatusList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
            <Border Style="{DynamicResource HeroCard}" Margin="0,0,16,16"><StackPanel>
                <DockPanel><Button Content="打开 →" Tag="{Binding Health.Platform}" Click="OnPlatform" Style="{DynamicResource SecondaryButton}" DockPanel.Dock="Right"/><c:PlatformIcon Platform="{Binding Brand}" Width="32" Height="32" Margin="0,0,12,0"/><StackPanel><TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding RuntimeSummary}" FontSize="13" Foreground="{DynamicResource Accent.Primary}" Margin="0,4,0,0"/></StackPanel></DockPanel>
                <Grid Margin="0,18,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions><c:RewardArtwork DataContext="{Binding FeaturedReward}" IsCompact="True" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding TaskSummary}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding FeaturedProgress}" FontSize="15" Foreground="{DynamicResource Accent.Primary}" Margin="0,6,0,0"/><ProgressBar Value="{Binding FeaturedPercent,Mode=OneWay}" Maximum="100" Height="9" Style="{DynamicResource ThemeProgressBar}" Margin="0,10,0,0"/></StackPanel>
                </Grid>
                <TextBlock Text="{Binding Channel}" FontSize="13" Foreground="{DynamicResource Text.Secondary}"/><TextBlock Text="{Binding AccountText}" FontSize="13" Foreground="{DynamicResource Text.Secondary}" Margin="0,5,0,0"/><TextBlock Text="{Binding Health.Notice}" Visibility="{Binding Health.NoticeVisibility}" FontSize="13" Foreground="{DynamicResource Status.Warning}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Grid b:ResponsiveGrid.IsEnabled="True"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{DynamicResource HeroCard}" Margin="0,0,16,0"><StackPanel><TextBlock Text="最近消息" Style="{DynamicResource VisualHeading}"/><TextBlock Text="{Binding StatusText}" Style="{DynamicResource VisualCaption}" Margin="0,0,0,12"/><ItemsControl x:Name="LatestAnnouncements"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,8"><TextBlock DockPanel.Dock="Right" Text="{Binding PublishedAt,StringFormat={}{0:MM-dd}}" FontSize="13" Foreground="{DynamicResource Text.Secondary}"/><TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" Margin="0,0,12,0"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="全部公告 ↗" Click="OnAnnouncements" Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{DynamicResource HeroCard}" Margin="0"><StackPanel><TextBlock Text="常用操作" Style="{DynamicResource VisualHeading}"/><Button Content="区服快照" Tag="snapshots" Click="OnNavigate" Style="{DynamicResource SecondaryButton}" Margin="0,0,0,10"/><Button Content="诊断与故障恢复" Tag="diagnostics" Click="OnNavigate" Style="{DynamicResource SecondaryButton}" Margin="0,0,0,10"/><Button Content="网络与全局设置" Tag="settings" Click="OnNavigate" Style="{DynamicResource SecondaryButton}"/></StackPanel></Border>
        </Grid>
    </StackPanel></ScrollViewer>
</UserControl>
