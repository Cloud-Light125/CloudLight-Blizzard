<Window x:Class="CloudLightBlizzard.Views.ExitConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="退出 CloudLight Blizzard" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" SizeToContent="Height" Width="500"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Border Background="{DynamicResource App.SurfaceElevated}" CornerRadius="14" Margin="18"
            BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.36" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="22,18,18,0" MouseLeftButtonDown="OnDrag">
                <TextBlock Text="退出 CloudLight Blizzard" Foreground="{DynamicResource Text.Primary}"
                           FontSize="19" FontWeight="SemiBold"/>
                <Button Style="{StaticResource TitleIconButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Width="28" Height="28" Content="×"
                        Foreground="{DynamicResource Text.Muted}" FontSize="18" Click="OnCancel"/>
            </Grid>

            <Border Grid.Row="1" Margin="22,18,22,0" Padding="16,14" CornerRadius="10"
                    Background="{DynamicResource App.SurfaceAlt}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="仍有掉宝任务正在运行。" Foreground="{DynamicResource Text.Primary}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="请选择关闭 CloudLight Blizzard 后的操作。"
                               Foreground="{DynamicResource Text.Secondary}" Margin="0,7,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="22,20,22,22">
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Height="36"
                        Padding="20,0" Margin="0,0,10,0" IsCancel="True"/>
                <Button Content="最小化到托盘" Style="{StaticResource PrimaryButton}" Height="36"
                        Padding="20,0" Margin="0,0,10,0" Click="OnMinimizeToTray"/>
                <Button Content="退出" Style="{StaticResource DangerButton}" Height="36"
                        Padding="20,0" Click="OnExit"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
