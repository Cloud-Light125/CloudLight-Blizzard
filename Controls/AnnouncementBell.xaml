<UserControl x:Class="CloudLightBlizzard.Controls.AnnouncementBell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:CloudLightBlizzard"
             xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls"
             Background="Transparent">
    <Button Width="40" Height="40" Padding="0" Style="{StaticResource SecondaryButton}"
            ToolTip="公告" Click="OnOpenAnnouncements">
        <Grid Width="24" Height="24" ClipToBounds="False">
            <ctrl:IconView Geometry="{StaticResource GeoBell}" Stroke="{DynamicResource Text.Primary}"
                           IconSize="22" Thickness="1.8"/>
            <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Fill="{DynamicResource Accent.Primary}" ClipToBounds="False">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AnnouncementState.IsBadgeVisible,
                                RelativeSource={RelativeSource AncestorType={x:Type app:MainWindow}}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
        </Grid>
    </Button>
</UserControl>
