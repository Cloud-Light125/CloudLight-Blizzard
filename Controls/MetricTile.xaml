<UserControl x:Class="CloudLightBlizzard.Controls.MetricTile" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Tile">
    <Border Style="{DynamicResource MetricCard}"><StackPanel>
        <TextBlock Text="{Binding Label,ElementName=Tile}" FontSize="13" Foreground="{DynamicResource Text.Secondary}"/>
        <TextBlock Text="{Binding Value,ElementName=Tile}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <TextBlock Text="{Binding Caption,ElementName=Tile}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
    </StackPanel></Border>
</UserControl>
