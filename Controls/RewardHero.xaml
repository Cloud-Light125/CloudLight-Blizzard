<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CloudLightBlizzard.Controls.RewardHero">
    <Border Style="{DynamicResource HeroCard}">
        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <Border DockPanel.Dock="Right" Style="{DynamicResource Badge}">
                    <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource Accent.Primary}" FontSize="13" />
                </Border>
                <TextBlock Text="{Binding Game}" FontSize="13" Foreground="{DynamicResource Text.Secondary}" />
            </DockPanel>
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Campaign}" FontSize="13" Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,14" TextWrapping="Wrap" />
            <TextBlock Text="{Binding EstimateText}" FontSize="13" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <ctrl:RewardArtwork Margin="0,0,0,4" />
            <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontSize="30" Foreground="{DynamicResource Accent.Primary}" FontWeight="SemiBold" />
                        <StackPanel>
                            <TextBlock Text="官方观看进度" FontSize="13" Foreground="{DynamicResource Text.Secondary}" />
                            <TextBlock Text="{Binding ProgressText}" FontSize="23" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar Value="{Binding Percent,Mode=OneWay}" Maximum="100" Height="12" Style="{DynamicResource ThemeProgressBar}" Margin="0,10,0,8" />
                    <WrapPanel>
                        <TextBlock Text="{Binding RemainingText}" FontSize="14" Margin="0,0,18,0" />
                        <TextBlock Text="{Binding SyncText}" FontSize="13" Foreground="{DynamicResource Text.Secondary}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>