<UserControl x:Class="CloudLightBlizzard.Controls.CampaignInventoryView" x:Name="Inventory" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:CloudLightBlizzard.Controls" MinHeight="180">
<UserControl.Resources>
<DataTemplate x:Key="RewardTileTemplate"><c:RewardCard Reward="{Binding Drop}" Title="{Binding Title}" ImageUrl="{Binding ImageUrl}" Subtitle="{Binding Stage}"/></DataTemplate>
<DataTemplate x:Key="CampaignGroupTemplate">
<Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,14,12" Tag="CampaignGroup" MaxWidth="{Binding ContainerMaxWidth}" HorizontalAlignment="Left" ToolTip="{Binding Summary}"><StackPanel>
<Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<c:VisualImage SourceUrl="{Binding ImageUrl}" Width="32" Height="42" Brand="Twitch" DecodePixelWidth="128"/>
<StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><WrapPanel Margin="0,3,0,0"><TextBlock Text="{Binding Game}" FontSize="13" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,10,0"/><TextBlock Text="{Binding Status}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent.Primary}" Margin="0,0,10,0"/><TextBlock Text="{Binding EndText}" FontSize="12.5" Foreground="{DynamicResource Text.Secondary}"/></WrapPanel></StackPanel><Button Grid.Column="2" Content="活动详情 →" Visibility="{Binding CampaignActionVisibility,RelativeSource={RelativeSource AncestorType=c:CampaignInventoryView}}" c:WorkspaceAction.Name="twitch:campaign-details" Style="{DynamicResource SecondaryButton}" MinHeight="32" Padding="8,0" FontSize="13" Margin="8,0,0,0"/></Grid>
<ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource RewardTileTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><c:RewardTilePanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
</StackPanel></Border></DataTemplate>
<DataTemplate x:Key="CampaignRowTemplate"><ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource CampaignGroupTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Groups.Count}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></DataTemplate>
</UserControl.Resources>
<ListBox x:Name="CampaignList" ItemsSource="{Binding Rows,ElementName=Inventory}" ItemTemplate="{StaticResource CampaignRowTemplate}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,-14,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0.5">
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
</ListBox></UserControl>
