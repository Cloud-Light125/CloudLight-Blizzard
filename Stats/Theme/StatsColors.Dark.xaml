<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 战绩模块 · 暗色主题(key 与亮色字典一一对应) -->

    <SolidColorBrush x:Key="Stats.Bg"          Color="#1D1F26"/>
    <SolidColorBrush x:Key="Stats.Card"        Color="#2C303C"/>
    <SolidColorBrush x:Key="Stats.CardBorder"  Color="#3A3F4D"/>
    <SolidColorBrush x:Key="Stats.Divider"     Color="#31353F"/>

    <SolidColorBrush x:Key="Stats.Tx1"         Color="#EEF0F5"/>
    <SolidColorBrush x:Key="Stats.Tx2"         Color="#C2C7D4"/>
    <SolidColorBrush x:Key="Stats.Tx3"         Color="#7C8393"/>

    <SolidColorBrush x:Key="Stats.Accent"      Color="#6B8AF8"/>
    <SolidColorBrush x:Key="Stats.AccentHover" Color="#829BF9"/>
    <SolidColorBrush x:Key="Stats.AccentSoft"  Color="#2B3350"/>

    <SolidColorBrush x:Key="Stats.Ok"          Color="#4CAF2F"/>
    <SolidColorBrush x:Key="Stats.OkSoft"      Color="#22331F"/>
    <SolidColorBrush x:Key="Stats.OkText"      Color="#7BC95A"/>
    <SolidColorBrush x:Key="Stats.LossSoft"    Color="#3D2626"/>
    <SolidColorBrush x:Key="Stats.LossText"    Color="#F16B6B"/>
    <SolidColorBrush x:Key="Stats.DrawSoft"    Color="#3A3F4D"/>
    <SolidColorBrush x:Key="Stats.DrawText"    Color="#9AA1AD"/>

    <SolidColorBrush x:Key="Stats.InputBg"     Color="#20232C"/>
    <SolidColorBrush x:Key="Stats.InputBorder" Color="#414656"/>
    <SolidColorBrush x:Key="Stats.Hover"       Color="#333845"/>

    <LinearGradientBrush x:Key="Stats.GoldBadge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E8C97A" Offset="0"/>
        <GradientStop Color="#C9A244" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Stats.GoldText"    Color="#3A2A08"/>
    <SolidColorBrush x:Key="Stats.GoldPanel"   Color="#332E1E"/>

    <!-- 段位配色(青铜→英杰 8 档) -->
    <SolidColorBrush x:Key="Stats.TierBronze"   Color="#C89B6E"/>
    <SolidColorBrush x:Key="Stats.TierSilver"   Color="#AEB6C4"/>
    <SolidColorBrush x:Key="Stats.TierGold"     Color="#E6C05A"/>
    <SolidColorBrush x:Key="Stats.TierPlatinum" Color="#7FC6D6"/>
    <SolidColorBrush x:Key="Stats.TierDiamond"  Color="#8DB4EE"/>
    <SolidColorBrush x:Key="Stats.TierMaster"   Color="#B49CE8"/>
    <SolidColorBrush x:Key="Stats.TierGm"       Color="#EAB661"/>
    <SolidColorBrush x:Key="Stats.TierChampion" Color="#F07AB0"/>
</ResourceDictionary>
