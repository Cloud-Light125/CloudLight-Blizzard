<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 战绩模块 · 亮色主题(key 与暗色字典一一对应,可整体替换) -->

    <SolidColorBrush x:Key="Stats.Bg"          Color="#F6F7F9"/>
    <SolidColorBrush x:Key="Stats.Card"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Stats.CardBorder"  Color="#E7E9EF"/>
    <SolidColorBrush x:Key="Stats.Divider"     Color="#F0F1F4"/>

    <SolidColorBrush x:Key="Stats.Tx1"         Color="#1A1F2E"/>
    <SolidColorBrush x:Key="Stats.Tx2"         Color="#4B5261"/>
    <SolidColorBrush x:Key="Stats.Tx3"         Color="#9AA1AD"/>

    <SolidColorBrush x:Key="Stats.Accent"      Color="#3B5BDB"/>
    <SolidColorBrush x:Key="Stats.AccentHover" Color="#314BC0"/>
    <SolidColorBrush x:Key="Stats.AccentSoft"  Color="#EEF2FF"/>

    <SolidColorBrush x:Key="Stats.Ok"          Color="#16A34A"/>
    <SolidColorBrush x:Key="Stats.OkSoft"      Color="#E9F7EE"/>
    <SolidColorBrush x:Key="Stats.OkText"      Color="#15803D"/>
    <SolidColorBrush x:Key="Stats.LossSoft"    Color="#FDEAEA"/>
    <SolidColorBrush x:Key="Stats.LossText"    Color="#C23434"/>
    <SolidColorBrush x:Key="Stats.DrawSoft"    Color="#ECEEF2"/>
    <SolidColorBrush x:Key="Stats.DrawText"    Color="#6B7280"/>

    <SolidColorBrush x:Key="Stats.InputBg"     Color="#F6F7F9"/>
    <SolidColorBrush x:Key="Stats.InputBorder" Color="#E0E3EA"/>
    <SolidColorBrush x:Key="Stats.Hover"       Color="#F4F5F8"/>

    <!-- 500强金色徽章 -->
    <LinearGradientBrush x:Key="Stats.GoldBadge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFE9A8" Offset="0"/>
        <GradientStop Color="#F5C95F" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Stats.GoldText"    Color="#8A5B12"/>
    <SolidColorBrush x:Key="Stats.GoldPanel"   Color="#FFFDF5"/>

    <!-- 段位配色(青铜→英杰 8 档) -->
    <SolidColorBrush x:Key="Stats.TierBronze"   Color="#A56A3A"/>
    <SolidColorBrush x:Key="Stats.TierSilver"   Color="#7E879A"/>
    <SolidColorBrush x:Key="Stats.TierGold"     Color="#C99A2E"/>
    <SolidColorBrush x:Key="Stats.TierPlatinum" Color="#3E8E9E"/>
    <SolidColorBrush x:Key="Stats.TierDiamond"  Color="#3466B5"/>
    <SolidColorBrush x:Key="Stats.TierMaster"   Color="#7C5CBF"/>
    <SolidColorBrush x:Key="Stats.TierGm"       Color="#B5751F"/>
    <SolidColorBrush x:Key="Stats.TierChampion" Color="#C0397A"/>
</ResourceDictionary>
