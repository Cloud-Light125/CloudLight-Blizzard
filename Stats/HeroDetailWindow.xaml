<Window x:Class="CloudLightBlizzard.Stats.HeroDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CloudLightBlizzard.Stats"
        Title="英雄详情" Width="470" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Stats.Bg}"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <local:PathToImageConverter x:Key="PathToImg"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 场均属性单元格 -->
        <DataTemplate x:Key="StatCell" DataType="{x:Type local:StatItem}">
            <Border BorderBrush="{DynamicResource Stats.Divider}" BorderThickness="0,1,0,0" Padding="12,9">
                <Grid>
                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Stats.Tx2}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Value}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Stats.Tx1}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,16,18,18">

            <!-- 头部:英雄图标 + 名 + 概况 -->
            <Border Style="{StaticResource Stats.CardStyle}">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="60" Height="60" VerticalAlignment="Center">
                        <Border CornerRadius="12" Background="{DynamicResource Stats.Divider}"/>
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding IconLocal, Converter={StaticResource PathToImg}}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Stats.Tx1}"/>
                            <TextBlock Text="{Binding LevelText}" FontSize="12" VerticalAlignment="Center" Margin="9,4,0,0"
                                       Foreground="{DynamicResource Stats.Tx3}" Visibility="{Binding HasLevel, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <Border Background="{DynamicResource Stats.Hover}" CornerRadius="6" Padding="8,3" Margin="0,0,7,0"
                                    Visibility="{Binding HasRank, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="11.5"><Run Text="段位 " Foreground="{DynamicResource Stats.Tx3}"/><Run Text="{Binding RankText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Stats.Tx1}"/></TextBlock>
                            </Border>
                            <Border Background="{DynamicResource Stats.AccentSoft}" CornerRadius="6" Padding="8,3" Margin="0,0,7,0">
                                <TextBlock FontSize="11.5"><Run Text="胜率 " Foreground="{DynamicResource Stats.Tx3}"/><Run Text="{Binding WinRateText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Stats.Accent}"/></TextBlock>
                            </Border>
                            <Border Background="{DynamicResource Stats.Hover}" CornerRadius="6" Padding="8,3" Margin="0,0,7,0">
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource Stats.Tx2}"><Run Text="{Binding MatchsText, Mode=OneWay}"/></TextBlock>
                            </Border>
                            <Border Background="{DynamicResource Stats.Hover}" CornerRadius="6" Padding="8,3">
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource Stats.Tx2}"><Run Text="{Binding HoursText, Mode=OneWay}"/></TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,2,0,0">
                <TextBlock Text="数据" Style="{StaticResource Stats.H6}" VerticalAlignment="Bottom"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Visibility="{Binding HasPerTen, Converter={StaticResource BoolToVis}}">
                    <RadioButton x:Name="RbAve" GroupName="StatMode" Content="{Binding TotalTabText, Mode=OneWay}" IsChecked="True"
                                 Style="{StaticResource Stats.TabRadio}" Checked="OnStatModeChanged"/>
                    <RadioButton x:Name="RbTen" GroupName="StatMode" Content="每10分钟"
                                 Style="{StaticResource Stats.TabRadio}" Checked="OnStatModeChanged"/>
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource Stats.CardStyle}">
                <ItemsControl x:Name="StatList" ItemsSource="{Binding DetailStats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <StaticResource ResourceKey="StatCell"/>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock x:Name="EmptyHint" Text="该英雄暂无明细数据" FontSize="12" Margin="4,10,0,0"
                       Foreground="{DynamicResource Stats.Tx3}" Visibility="Collapsed"/>

        </StackPanel>
    </ScrollViewer>
</Window>
