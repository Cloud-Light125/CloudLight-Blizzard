<Window x:Class="BnetSwitch.Stats.BillboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BnetSwitch.Stats"
        Title="英雄排行榜" Width="480" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Stats.Bg}"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <local:PathToImageConverter x:Key="PathToImg"/>

        <DataTemplate x:Key="BoardRow" DataType="{x:Type local:BillboardRow}">
            <Border BorderBrush="{DynamicResource Stats.Divider}" BorderThickness="0,1,0,0" Padding="12,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Order}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Stats.Tx3}"
                               VerticalAlignment="Center"/>

                    <Grid Grid.Column="1" Width="30" Height="30" Margin="2,0,10,0" VerticalAlignment="Center">
                        <Border CornerRadius="7" Background="{DynamicResource Stats.Divider}"/>
                        <Border CornerRadius="7">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding HeroIconLocal, Converter={StaticResource PathToImg}}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeroName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Stats.Tx1}"/>
                        <TextBlock Text="{Binding Extra}" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource Stats.Tx3}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding RankText}" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Stats.Accent}"/>
                        <TextBlock Text="{Binding ScoreText}" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Stats.Tx2}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <!-- 头部 -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Stats.Card}"
                    BorderBrush="{DynamicResource Stats.Divider}" BorderThickness="0,0,0,1" Padding="18,13">
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="英雄排行榜" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Stats.Tx1}"/>
                    <TextBlock x:Name="SubText" FontSize="11.5" Margin="0,3,0,0" Foreground="{DynamicResource Stats.Tx3}"/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Stats.CardStyle}" Margin="16">
                    <ItemsControl x:Name="BoardList" ItemTemplate="{StaticResource BoardRow}"/>
                </Border>
            </ScrollViewer>
        </DockPanel>

        <!-- 加载/空 遮罩 -->
        <Border x:Name="OverlayPanel" Background="{DynamicResource Stats.Bg}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="OverlayTitle" Text="正在加载排行榜…" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Stats.Tx1}"/>
                <TextBlock x:Name="OverlayHint" Text="按各英雄省内排名展示" FontSize="11.5" Margin="0,6,0,0"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Stats.Tx3}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
