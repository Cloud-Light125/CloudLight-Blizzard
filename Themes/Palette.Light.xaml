<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 亮色主题调色板(键名与暗色一致,运行时整体替换即可切主题)。 -->
    <SolidColorBrush x:Key="Win" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Body" Color="#F6F7F9" />
    <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Card2" Color="#FAFBFC" />

    <SolidColorBrush x:Key="Tx1" Color="#1A1F2E" />
    <SolidColorBrush x:Key="Tx2" Color="#4B5261" />
    <SolidColorBrush x:Key="Tx3" Color="#9AA1AD" />

    <SolidColorBrush x:Key="Bd" Color="#E3E6EC" />
    <SolidColorBrush x:Key="Bd2" Color="#EEF0F4" />
    <SolidColorBrush x:Key="Bd3" Color="#E7E9EF" />

    <SolidColorBrush x:Key="Acc" Color="#3B5BDB" />
    <SolidColorBrush x:Key="AccH" Color="#314BC0" />
    <SolidColorBrush x:Key="AccSoft" Color="#EEF2FF" />
    <SolidColorBrush x:Key="AccBd" Color="#B9C4F0" />

    <SolidColorBrush x:Key="Ok" Color="#16A34A" />
    <SolidColorBrush x:Key="OkSoft" Color="#E9F7EE" />
    <SolidColorBrush x:Key="OkTx" Color="#15803D" />
    <SolidColorBrush x:Key="Fresh" Color="#16A34A" />

    <SolidColorBrush x:Key="WarnBg" Color="#FDF6E3" />
    <SolidColorBrush x:Key="WarnBd" Color="#F0E2B6" />
    <SolidColorBrush x:Key="WarnTx" Color="#8A6D1F" />
    <SolidColorBrush x:Key="WarnIc" Color="#D19A2A" />

    <SolidColorBrush x:Key="OffAv" Color="#EEF0F4" />
    <SolidColorBrush x:Key="OffAvTx" Color="#A7ADBA" />
    <SolidColorBrush x:Key="OffTx" Color="#7A828F" />

    <SolidColorBrush x:Key="BtnBd" Color="#E0E3EA" />
    <SolidColorBrush x:Key="Hover" Color="#F4F5F8" />
    <SolidColorBrush x:Key="Input" Color="#FBFBFD" />
    <SolidColorBrush x:Key="InputBd" Color="#DCDFE6" />

    <SolidColorBrush x:Key="TagBg" Color="#ECEEF2" />
    <SolidColorBrush x:Key="TagTx" Color="#8A909C" />
    <SolidColorBrush x:Key="TgOff" Color="#D4D8E0" />
    <SolidColorBrush x:Key="Mask" Color="#73181E30" />
    <SolidColorBrush x:Key="OnAcc" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Danger" Color="#E5556A" />
    <SolidColorBrush x:Key="DangerH" Color="#D63E54" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FDECEE" />

    <!-- 产品级语义资源。旧键继续保留，避免影响稳定业务视图。 -->
    <SolidColorBrush x:Key="App.Background" Color="#F6F7F9" />
    <SolidColorBrush x:Key="App.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.SurfaceAlt" Color="#FAFBFC" />
    <SolidColorBrush x:Key="App.SurfaceElevated" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.Border" Color="#E3E6EC" />
    <SolidColorBrush x:Key="Text.Primary" Color="#1A1F2E" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#4B5261" />
    <SolidColorBrush x:Key="Text.Muted" Color="#9AA1AD" />
    <SolidColorBrush x:Key="Accent.Primary" Color="#3B5BDB" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#314BC0" />
    <SolidColorBrush x:Key="Status.Success" Color="#16A34A" />
    <SolidColorBrush x:Key="Status.Warning" Color="#D19A2A" />
    <SolidColorBrush x:Key="Status.Error" Color="#E5556A" />
    <SolidColorBrush x:Key="Nav.Background" Color="#F0F2F7" />
    <SolidColorBrush x:Key="Nav.Selected" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Button.Primary.Background" Color="#3B5BDB" />
    <SolidColorBrush x:Key="Button.Primary.Foreground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Button.Secondary.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Button.Secondary.Foreground" Color="#1A1F2E" />
</ResourceDictionary>
