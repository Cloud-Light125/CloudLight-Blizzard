<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:CloudLightBlizzard.Controls">

    <!-- IconView 模板:固定 32 单位画框(-16..16 平移到 0..32),所有图标同比例、对齐一致。 -->
    <Style TargetType="{x:Type ctrl:IconView}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:IconView}">
                    <Viewbox Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}" Stretch="Uniform">
                        <Grid Width="32" Height="32">
                            <Path Data="{TemplateBinding Geometry}"
                                  Stroke="{TemplateBinding Stroke}"
                                  Fill="{TemplateBinding Fill}"
                                  StrokeThickness="{TemplateBinding Thickness}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                <Path.RenderTransform>
                                    <TranslateTransform X="16" Y="16" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== 几何:全部居中坐标系(-16..16)==== -->
    <StreamGeometry x:Key="GeoSwitch">M-9,-6 H7 M3,-10 L8,-6 L3,-2 M9,6 H-7 M-3,2 L-8,6 L-3,10</StreamGeometry>
    <StreamGeometry x:Key="GeoCam">M-13,-6 H13 V10 H-13 Z M-5,-6 L-3,-10 H3 L5,-6 M-5,3 A5,5 0 1 1 5,3 A5,5 0 1 1 -5,3 Z</StreamGeometry>
    <StreamGeometry x:Key="GeoUser">M-7,-6 A5,5 0 1 1 3,-6 A5,5 0 1 1 -7,-6 Z M-11,12 C-11,3 7,3 7,12 M11,-11 V-3 M7,-7 H15</StreamGeometry>
    <StreamGeometry x:Key="GeoRefresh">M11,-3 A11.5,11.5 0 1 0 12,4 M12,-11 V-3 H4</StreamGeometry>
    <StreamGeometry x:Key="GeoGear">M0,-15 L4,-9.7 L10.6,-10.6 L9.7,-4 L15,0 L9.7,4 L10.6,10.6 L4,9.7 L0,15 L-4,9.7 L-10.6,10.6 L-9.7,4 L-15,0 L-9.7,-4 L-10.6,-10.6 L-4,-9.7 Z M-4.5,0 A4.5,4.5 0 1 1 4.5,0 A4.5,4.5 0 1 1 -4.5,0 Z</StreamGeometry>
    <StreamGeometry x:Key="GeoWarn">M0,-13 L13,10 H-13 Z M0,-4 V4 M0,7.1 L0,7.35</StreamGeometry>
    <StreamGeometry x:Key="GeoKey">M-12,-6 A6,6 0 1 1 0,-6 A6,6 0 1 1 -12,-6 Z M-2,-2 L11,11 M7,7 L10,4 M4,10 L7,13</StreamGeometry>
    <StreamGeometry x:Key="GeoCopy">M-3,-12 H11 V2 H-3 Z M-11,-2 H3 V12 H-11 Z</StreamGeometry>
    <StreamGeometry x:Key="GeoPhoto">M-13,-10 H13 V10 H-13 Z M-8.5,-3 A2.5,2.5 0 1 1 -3.5,-3 A2.5,2.5 0 1 1 -8.5,-3 Z M-13,6 L-4,-1 L3,5 L8,1 L13,6</StreamGeometry>
    <StreamGeometry x:Key="GeoTray">M0,-11 V3 M-5,-2 L0,3 L5,-2 M-11,10 H11</StreamGeometry>
    <StreamGeometry x:Key="GeoDelete">M-12,-6 H12 M-4,-6 V-9 H4 V-6 M-9,-6 L-7,13 H7 L9,-6 M-3,-1 V9 M3,-1 V9</StreamGeometry>
    <StreamGeometry x:Key="GeoExt">M-3,-7 H-7 V7 H7 V3 M1,-7 H7 V-1 M7,-7 L-0.5,0.5</StreamGeometry>
    <StreamGeometry x:Key="GeoDownload">M0,-8 V3 M-5,-2 L0,3 L5,-2 M-7,7 H7</StreamGeometry>
    <StreamGeometry x:Key="GeoX">M-6,-6 L6,6 M6,-6 L-6,6</StreamGeometry>
    <StreamGeometry x:Key="GeoCheck">M-7,1 L-2,6 L7,-5</StreamGeometry>
    <StreamGeometry x:Key="GeoChat">M-12,-9 H12 V4 H-4 L-9,10 V4 H-12 Z</StreamGeometry>
    <StreamGeometry x:Key="GeoCode">M-4,-8 L-12,0 L-4,8 M4,-8 L12,0 L4,8</StreamGeometry>
    <StreamGeometry x:Key="GeoChart">M-9,9 V-1 M0,9 V-9 M9,9 V4</StreamGeometry>
    <!-- 电源符号:竖线 + 缺口朝上的 270° 圆弧 -->
    <StreamGeometry x:Key="GeoPower">M0,-11 V-1 M-6.4,-6.4 A9,9 0 1 0 6.4,-6.4</StreamGeometry>

    <!-- Logo(六边形,外描边 + 内填充)-->
    <StreamGeometry x:Key="GeoLogoOuter">M0,-14 L12.1,-7 L12.1,7 L0,14 L-12.1,7 L-12.1,-7 Z</StreamGeometry>
    <StreamGeometry x:Key="GeoLogoInner">M0,-7 L6,-3.5 L6,3.5 L0,7 L-6,3.5 L-6,-3.5 Z</StreamGeometry>

</ResourceDictionary>
