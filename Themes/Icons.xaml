        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PlatformIconSmall" TargetType="{x:Type ctrl:PlatformIcon}" BasedOn="{StaticResource {x:Type ctrl:PlatformIcon}}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
    </Style>
    <Style x:Key="PlatformIconHeader" TargetType="{x:Type ctrl:PlatformIcon}" BasedOn="{StaticResource {x:Type ctrl:PlatformIcon}}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Margin" Value="0,0,16,0" />
    </Style>

