    <SolidColorBrush x:Key="Hover" Color="#333845" />
    <SolidColorBrush x:Key="Input" Color="#20232C" />
    <SolidColorBrush x:Key="InputBd" Color="#414656" />

    <SolidColorBrush x:Key="TagBg" Color="#3A3F4D" />
