    <!-- 产品级语义资源。旧键继续保留，避免影响稳定业务视图。 -->
    <SolidColorBrush x:Key="App.Background" Color="#1D1F26" />
    <SolidColorBrush x:Key="App.Surface" Color="#2C303C" />
    <SolidColorBrush x:Key="App.SurfaceAlt" Color="#272B35" />
    <SolidColorBrush x:Key="App.SurfaceElevated" Color="#343946" />
    <SolidColorBrush x:Key="App.Border" Color="#363B48" />
    <SolidColorBrush x:Key="Text.Primary" Color="#EEF0F5" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#C2C7D4" />
    <SolidColorBrush x:Key="Text.Muted" Color="#7C8393" />
    <SolidColorBrush x:Key="Accent.Primary" Color="#6B8AF8" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#829BF9" />
    <SolidColorBrush x:Key="Status.Success" Color="#4CAF2F" />
    <SolidColorBrush x:Key="Status.Warning" Color="#E0B84A" />
    <SolidColorBrush x:Key="Status.Error" Color="#F16B6B" />
    <SolidColorBrush x:Key="Nav.Background" Color="#171920" />
    <SolidColorBrush x:Key="Nav.Selected" Color="#2C303C" />
    <SolidColorBrush x:Key="Button.Primary.Background" Color="#6B8AF8" />
    <SolidColorBrush x:Key="Button.Primary.Foreground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Button.Secondary.Background" Color="#2C303C" />
    <SolidColorBrush x:Key="Button.Secondary.Foreground" Color="#EEF0F5" />
</ResourceDictionary>
