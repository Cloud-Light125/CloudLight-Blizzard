    <SolidColorBrush x:Key="AccSoft" Color="#2B3350" />
    <SolidColorBrush x:Key="AccBd" Color="#4A5A94" />

    <SolidColorBrush x:Key="Ok" Color="#4CAF2F" />
    <SolidColorBrush x:Key="OkSoft" Color="#22331F" />
    <SolidColorBrush x:Key="OkTx" Color="#7BC95A" />
    <SolidColorBrush x:Key="Fresh" Color="#5CC65C" />

    <SolidColorBrush x:Key="WarnBg" Color="#3A3320" />
