<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:CloudLightBlizzard.Controls" xmlns:b="clr-namespace:CloudLightBlizzard.Behaviors">
    <Style x:Key="SettingRowControl" TargetType="{x:Type c:SettingRow}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type c:SettingRow}"><Border BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1" Padding="16,14"><Grid b:ResponsiveGrid.IsEnabled="True" b:ResponsiveGrid.Breakpoint="{TemplateBinding ReflowWidth}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock Text="{TemplateBinding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{TemplateBinding Description}" FontSize="13" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel><ContentPresenter Grid.Column="1" Content="{TemplateBinding Editor}" VerticalAlignment="Center" MinWidth="48" MaxWidth="300"/></Grid></Border></ControlTemplate></Setter.Value></Setter></Style>
    <DataTemplate x:Key="BenefitCardTemplate"><StackPanel Width="184" Margin="0,0,12,12"><c:VisualImage SourceUrl="{Binding ImageUrl}" Brand="{Binding Brand}" Width="132" Height="132"/><TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,3"/><TextBlock Text="{Binding TypeText}" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/></StackPanel></DataTemplate>
    <DataTemplate x:Key="BenefitThumbTemplate"><Border Margin="0,0,6,6" ToolTip="{Binding Name}"><c:VisualImage SourceUrl="{Binding ImageUrl}" Brand="{Binding Brand}" Width="110" Height="110"/></Border></DataTemplate>
    <Style x:Key="BenefitGalleryStyle" TargetType="c:BenefitGallery"><Setter Property="ItemTemplate" Value="{DynamicResource BenefitCardTemplate}"/><Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsCompact" Value="True"><Setter Property="ItemTemplate" Value="{DynamicResource BenefitThumbTemplate}"/></Trigger></Style.Triggers></Style>
    <Style x:Key="HeroCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource App.Surface}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="BorderBrush" Value="{DynamicResource App.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
    <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource HeroCard}"><Setter Property="Padding" Value="18,14"/><Setter Property="Margin" Value="0,0,12,16"/></Style>
    <Style x:Key="VisualHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style x:Key="VisualBody" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="VisualCaption" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <DataTemplate x:Key="VisualRewardRow"><ItemsControl ItemsSource="{Binding Cards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><c:RewardTilePanel MaximumTileWidth="640" StretchSparseRows="True"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><c:RewardCard Reward="{Binding Drop}" Title="{Binding Title}" ImageUrl="{Binding ImageUrl}" Subtitle="{Binding Stage}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DataTemplate>
    <DataTemplate x:Key="VisualCampaignRow"><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <c:VisualImage SourceUrl="{Binding ImageUrl}" ImageStretch="UniformToFill" Width="48" Height="62"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Game}" FontSize="13" Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0"/><TextBlock Text="{Binding Status}" FontSize="13" Foreground="{DynamicResource Accent.Primary}" Margin="0,3,0,0"/><TextBlock Text="{Binding EndText}" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/></StackPanel>
    </Grid></DataTemplate>
</ResourceDictionary>
