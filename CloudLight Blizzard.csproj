<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.18362.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CloudLight Blizzard</AssemblyName>
    <RootNamespace>CloudLightBlizzard</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>2.1.9</Version>
    <AssemblyVersion>2.1.9.0</AssemblyVersion>
    <FileVersion>2.1.9.0</FileVersion>
    <InformationalVersion>2.1.9</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>CloudLight</Authors>
    <Company>CloudLight</Company>
    <Product>CloudLight Blizzard</Product>
    <Description>Battle.net 多账号与守望先锋实用工具</Description>
    <AssemblyTitle>CloudLight Blizzard</AssemblyTitle>
  </PropertyGroup>

  <!-- 开 UseWindowsForms 只为用 NotifyIcon 托盘;移除它自动注入的全局 using,
       免得 System.Windows.Forms/System.Drawing 与 WPF 的 MessageBox/Application/Brushes 冲突。
       托盘那一个文件里手动全限定即可。 -->
  <PropertyGroup>
    <BuildCommit Condition="'$(BuildCommit)' == ''">unknown</BuildCommit>
    <DropsBuildPurpose Condition="'$(DropsBuildPurpose)' == ''">Distribution</DropsBuildPurpose>
    <DropsArtifactsRoot Condition="'$(DropsArtifactsRoot)' == ''">artifacts\drops</DropsArtifactsRoot>
    <SoopAdapterOnly Condition="'$(SoopAdapterOnly)' == ''">false</SoopAdapterOnly>
    <BuildTimestamp Condition="'$(BuildTimestamp)' == ''">unknown</BuildTimestamp>
    <BilibiliUiSchema Condition="'$(BilibiliUiSchema)' == ''">2</BilibiliUiSchema>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildCommit" Value="$(BuildCommit)" />
    <AssemblyMetadata Include="BuildTimestamp" Value="$(BuildTimestamp)" />
    <AssemblyMetadata Include="BilibiliUiSchema" Value="$(BilibiliUiSchema)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.7" />
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Compile Remove="test-output\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Integrations\Drops\soop\redistribution-authorization.json">
      <Link>THIRD_PARTY_LICENSES\SOOP-Redistribution-Authorization.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Integrations\Drops\twitch\core\LICENSE">
      <Link>THIRD_PARTY_LICENSES\TwitchDropsMiner-MIT.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Integrations\Drops\bilibili\LICENSE">
      <Link>THIRD_PARTY_LICENSES\BiliBiliDropsMiner-MIT.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Integrations\Drops\bilibili\licenses\**\*">
      <Link>THIRD_PARTY_LICENSES\Bilibili\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(DropsArtifactsRoot)\**\*" Condition="Exists('$(DropsArtifactsRoot)')">
      <Link>_internal\drops\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CheckSoopDistributionPermission" BeforeTargets="Publish"
          Condition="'$(DropsBuildPurpose)' == 'Distribution' And '$(SoopAdapterOnly)' != 'true' And Exists('$(DropsArtifactsRoot)\soop\soop-worker.exe')">
    <Exec Command="powershell -NoProfile -File &quot;$(MSBuildProjectDirectory)\build-support\Verify-SoopDistribution.ps1&quot; -Manifest &quot;$(DropsArtifactsRoot)\build-manifest.json&quot; -Authorization &quot;$(MSBuildProjectDirectory)\Integrations\Drops\soop\redistribution-authorization.json&quot;" />
  </Target>
  <Target Name="ValidateDistributionWorkerContents" BeforeTargets="Publish"
          Condition="'$(DropsBuildPurpose)' == 'Distribution' And '$(SoopAdapterOnly)' == 'true'">
    <Exec Command="powershell -NoProfile -File &quot;$(MSBuildProjectDirectory)\Integrations\Drops\test-worker-ssl.ps1&quot; -Root &quot;$(DropsArtifactsRoot)&quot; -SoopAdapterOnly" />
  </Target>

</Project>
